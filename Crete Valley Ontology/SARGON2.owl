        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ActivePower"/>
        <rdfs:comment>Maximum Base Load MW per Participating Load Resource</rdfs:comment>
        <rdfs:label xml:lang="en">maxBaseLoad</rdfs:label>
    </owl:ObjectProperty>
    


