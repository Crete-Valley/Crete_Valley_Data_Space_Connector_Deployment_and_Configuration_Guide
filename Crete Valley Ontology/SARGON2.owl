        <rdfs:label xml:lang="en">OperationalTag</rdfs:label>
        <rdfs:label>SupplierEnd</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TapChanger.SvTapStep -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TapChanger.SvTapStep">
