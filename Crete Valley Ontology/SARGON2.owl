        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Timestamp indicating the time at which the instruction was received.  </rdfs:comment>
        <rdfs:label xml:lang="en">receivedTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#DispatchInstReply.startTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#DispatchInstReply.startTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#DispatchInstReply"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>start time</rdfs:comment>
        <rdfs:label xml:lang="en">startTime</rdfs:label>
    </owl:DatatypeProperty>
    


