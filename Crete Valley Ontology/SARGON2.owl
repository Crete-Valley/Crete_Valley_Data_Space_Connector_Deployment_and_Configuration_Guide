    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TopologicalNode.BaseVoltage">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TopologicalNode"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#BaseVoltage"/>
        <rdfs:comment>The base voltage of the topological node.</rdfs:comment>
        <rdfs:label xml:lang="en">BaseVoltage</rdfs:label>
        <rdfs:label>SupplierEnd</rdfs:label>
    </owl:ObjectProperty>
    


