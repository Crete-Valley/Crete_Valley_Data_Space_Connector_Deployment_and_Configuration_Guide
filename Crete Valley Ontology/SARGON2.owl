        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#PerCent"/>
        <rdfs:comment>The minimum percentage coverage </rdfs:comment>
        <rdfs:label xml:lang="en">minCoverage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#AtmosphericPhenomenon.speed -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#AtmosphericPhenomenon.speed">
