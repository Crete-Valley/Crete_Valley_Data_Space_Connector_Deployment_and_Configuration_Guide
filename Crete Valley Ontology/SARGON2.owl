    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TopologicalNode.BusNameMarker">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TopologicalNode"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#BusNameMarker"/>
        <rdfs:comment>BusnameMarkers that may refer to a pre defined TopologicalNode.</rdfs:comment>
        <rdfs:label xml:lang="en">BusNameMarker</rdfs:label>
        <rdfs:label>ClientEnd</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TopologicalNode.ConnectivityNodeContainer -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TopologicalNode.ConnectivityNodeContainer">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TopologicalNode"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ConnectivityNodeContainer"/>
        <rdfs:comment>The connectivity node container to which the topological node belongs.</rdfs:comment>
        <rdfs:label xml:lang="en">ConnectivityNodeContainer</rdfs:label>
        <rdfs:label>SupplierEnd</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TopologicalNode.ConnectivityNodes -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TopologicalNode.ConnectivityNodes">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TopologicalNode"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ConnectivityNode"/>
        <rdfs:comment>The connectivity nodes combine together to form this topological node.  May depend on the current state of switches in the network.</rdfs:comment>
        <rdfs:label>ClientEnd</rdfs:label>
        <rdfs:label xml:lang="en">ConnectivityNodes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TopologicalNode.SvInjection -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TopologicalNode.SvInjection">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TopologicalNode"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#SvInjection"/>
        <rdfs:comment>The injection flows state variables associated with the topological node.</rdfs:comment>
        <rdfs:label>ClientEnd</rdfs:label>
        <rdfs:label xml:lang="en">SvInjection</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TopologicalNode.SvVoltage -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TopologicalNode.SvVoltage">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TopologicalNode"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#SvVoltage"/>
        <rdfs:comment>The state voltage associated with the topological node.</rdfs:comment>
        <rdfs:label>ClientEnd</rdfs:label>
        <rdfs:label xml:lang="en">SvVoltage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TopologicalNode.Terminal -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TopologicalNode.Terminal">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TopologicalNode"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Terminal"/>
        <rdfs:comment>The terminals associated with the topological node.   This can be used as an alternative to the connectivity node path to terminal thus making it unnecessary to model connectivity nodes in some cases.   Note that if connectivity nodes are in the model this association would probably not be used as an input specification.</rdfs:comment>
        <rdfs:label>ClientEnd</rdfs:label>
        <rdfs:label xml:lang="en">Terminal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TopologicalNode.TopologicalIsland -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TopologicalNode.TopologicalIsland">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TopologicalNode"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#TopologicalIsland"/>
        <rdfs:comment>A topological node belongs to a topological island.</rdfs:comment>
        <rdfs:label>SupplierEnd</rdfs:label>
        <rdfs:label xml:lang="en">TopologicalIsland</rdfs:label>
    </owl:ObjectProperty>
    


