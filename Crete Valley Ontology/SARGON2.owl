        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>If set true and if disconnection can be operated remotely then the operation happens automatically. If set false and if disconnection can be operated remotely then the operation happens manually.</rdfs:comment>
        <rdfs:label xml:lang="en">isRemoteAutoDisconOp</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ConnectDisconnectFunction.isRemoteAutoReconOp -->

