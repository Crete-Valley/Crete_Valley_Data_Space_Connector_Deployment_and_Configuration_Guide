    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#sectionNumber">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#NonlinearShuntCompensatorPhasePoint"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#NonlinearShuntCompensatorPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
