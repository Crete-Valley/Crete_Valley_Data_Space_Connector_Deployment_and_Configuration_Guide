        <rdfs:comment>imi.true  IFD limitingfalse  EFD limiting.</rdfs:comment>
        <rdfs:label xml:lang="en">m</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#OverheadCost.code -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#OverheadCost.code">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#OverheadCost"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment> Overhead code.</rdfs:comment>
        <rdfs:label xml:lang="en">code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PFVArType1IEEEPFController.ovex -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PFVArType1IEEEPFController.ovex">
