    <!-- http://www.iec.ch/TC57/CIM#Shift.receiptsGrandTotalBankable -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#Shift.receiptsGrandTotalBankable">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Shift"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Money"/>
        <rdfs:comment>Total of amounts receipted during this shift that can be manually banked cash and cheques for example. Values are obtained from Receipt attributessumReceipt.receiptAmount for all Receipt.bankable  true.</rdfs:comment>
        <rdfs:label xml:lang="en">receiptsGrandTotalBankable</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Shift.receiptsGrandTotalNonBankable -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#Shift.receiptsGrandTotalNonBankable">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Shift"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Money"/>
        <rdfs:comment>Total of amounts receipted during this shift that cannot be manually banked card payments for example. Values are obtained from Receipt attributessumReceipt.receiptAmount for all Receipt.bankable  false.</rdfs:comment>
        <rdfs:label xml:lang="en">receiptsGrandTotalNonBankable</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Shift.receiptsGrandTotalRounding -->

