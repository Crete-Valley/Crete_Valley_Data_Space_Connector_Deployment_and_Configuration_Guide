        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ActivePower"/>
        <rdfs:comment>Minimum MW for a load reduction e.g. MW rating of a discrete pump.This attribute may be used also in the LoadBid class. The reason that the attribute is also modeled in this class is that it is resource attribute and needs to be persistently stored.</rdfs:comment>
        <rdfs:label xml:lang="en">minLoadReduction</rdfs:label>
    </owl:ObjectProperty>
    


