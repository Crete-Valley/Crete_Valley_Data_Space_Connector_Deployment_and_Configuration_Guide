        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ActivePower"/>
        <rdfs:comment>High voltage source active injection. Load sign convention is used i.e. positive sign means flow out from a node.Starting value for steady state solutions.</rdfs:comment>
        <rdfs:label xml:lang="en">activePower</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#EnergySource.nominalVoltage -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#EnergySource.nominalVoltage">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#EnergySource"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Voltage"/>
        <rdfs:comment>Phasetophase nominal voltage.</rdfs:comment>
        <rdfs:label xml:lang="en">nominalVoltage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#EnergySource.pMax -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#EnergySource.pMax">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#EnergySource"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ActivePower"/>
        <rdfs:comment>This is the maximum active power that can be produced by the source. Load sign convention is used i.e. positive sign means flow out from a TopologicalNode bus into the conducting equipment.</rdfs:comment>
        <rdfs:label xml:lang="en">pMax</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#EnergySource.pMin -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#EnergySource.pMin">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#EnergySource"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ActivePower"/>
        <rdfs:comment>This is the minimum active power that can be produced by the source. Load sign convention is used i.e. positive sign means flow out from a TopologicalNode bus into the conducting equipment.</rdfs:comment>
        <rdfs:label xml:lang="en">pMin</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#EnergySource.r -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#EnergySource.r">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#EnergySource"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Resistance"/>
        <rdfs:comment>Positive sequence Thevenin resistance.</rdfs:comment>
        <rdfs:label xml:lang="en">r</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#EnergySource.r0 -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#EnergySource.r0">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#EnergySource"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Resistance"/>
        <rdfs:comment>Zero sequence Thevenin resistance.</rdfs:comment>
        <rdfs:label xml:lang="en">r0</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#EnergySource.reactivePower -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#EnergySource.reactivePower">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#EnergySource"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ReactivePower"/>
        <rdfs:comment>High voltage source reactive injection. Load sign convention is used i.e. positive sign means flow out from a node.Starting value for steady state solutions.</rdfs:comment>
        <rdfs:label xml:lang="en">reactivePower</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#EnergySource.voltageAngle -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#EnergySource.voltageAngle">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#EnergySource"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#AngleRadians"/>
        <rdfs:comment>Phase angle of aphase open circuit used when voltage characteristics need to be imposed at the node associated with the terminal of the energy source such as when voltages and angles from the transmission level are used as input to the distribution network. The attribute shall be a positive value or zero.</rdfs:comment>
        <rdfs:label xml:lang="en">voltageAngle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#EnergySource.voltageMagnitude -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#EnergySource.voltageMagnitude">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#EnergySource"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Voltage"/>
        <rdfs:comment>Phasetophase open circuit voltage magnitude used when voltage characteristics need to be imposed at the node associated with the terminal of the energy source such as when voltages and angles from the transmission level are used as input to the distribution network. The attribute shall be a positive value or zero.</rdfs:comment>
        <rdfs:label xml:lang="en">voltageMagnitude</rdfs:label>
    </owl:ObjectProperty>
    


