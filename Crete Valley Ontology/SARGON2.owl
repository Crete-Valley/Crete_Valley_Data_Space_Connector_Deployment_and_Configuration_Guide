        <rdfs:comment>Existing Transmission Contract data for an interchange schedule.</rdfs:comment>
        <rdfs:label xml:lang="en">InterchangeETCData</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#InterchangeSchedule -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#InterchangeSchedule">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Curve"/>
        <rdfs:comment>Interchange schedule class to hold information for interchange schedules such as import export type energy type and etc.</rdfs:comment>
        <rdfs:label xml:lang="en">InterchangeSchedule</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#IntermittentResourceEligibility -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#IntermittentResourceEligibility">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#MarketFactors"/>
