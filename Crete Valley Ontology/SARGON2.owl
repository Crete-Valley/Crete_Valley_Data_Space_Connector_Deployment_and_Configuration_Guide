        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#YesNo"/>
        <rdfs:comment>This is a YN flag for a selfschedule of a resource per market per date and hour using a specific TR ID. It indicates whether a selfschedule using a TR has scheduling priority in DAMRTM.</rdfs:comment>
        <rdfs:label xml:lang="en">priorityFlag</rdfs:label>
    </owl:ObjectProperty>
    


