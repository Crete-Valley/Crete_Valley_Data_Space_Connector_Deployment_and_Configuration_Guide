        <rdfs:label xml:lang="en">dB</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.iec.ch/TC57/CIM#UnitSymbol.dBm -->

    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#UnitSymbol.dBm">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#UnitSymbol"/>
