    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TransformerObservation.waterContent -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#TransformerObservation.waterContent">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TransformerObservation"/>
