        <rdfs:comment>Qualification status used for DSR qualification.</rdfs:comment>
        <rdfs:label xml:lang="en">dynamicallyScheduledQualification</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredResource.commercialOpDate -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredResource.commercialOpDate">
