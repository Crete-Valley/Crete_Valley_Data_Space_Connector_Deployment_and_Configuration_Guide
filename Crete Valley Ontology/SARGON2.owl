        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Reactance"/>
        <rdfs:comment>Positive sequence series reactance of the reduced branch.</rdfs:comment>
        <rdfs:label xml:lang="en">x</rdfs:label>
    </owl:ObjectProperty>
    


