        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#SurgeArresterInfo"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Voltage"/>
        <rdfs:comment>Residual voltage during an 8x20 microsecond current impulse at the nominal discharge current level.</rdfs:comment>
        <rdfs:label xml:lang="en">lightningImpulseDischargeVoltage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SurgeArresterInfo.nominalDischargeCurrent -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#SurgeArresterInfo.nominalDischargeCurrent">
