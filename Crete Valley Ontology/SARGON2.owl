    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#TransformerObservation.dga">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TransformerObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Dissolved Gas Analysis. Typical values are Acceptable Overheating Corona Sparking Arcing.</rdfs:comment>
        <rdfs:label xml:lang="en">dga</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TransformerObservation.freqResp -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#TransformerObservation.freqResp">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TransformerObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Frequency Response Analysis. Typical values are acceptable slight movement significant movement failed near failure. A graphic of the response diagram which is a type of document may be associated with this analysis through the recursive document relationship of the ProcedureDataSet.</rdfs:comment>
        <rdfs:label xml:lang="en">freqResp</rdfs:label>
    </owl:DatatypeProperty>
    


