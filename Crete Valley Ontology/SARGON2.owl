    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PetersenCoil.offsetCurrent -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#PetersenCoil.offsetCurrent">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PetersenCoil"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#CurrentFlow"/>
        <rdfs:comment>The offset current that the Petersen coil controller is operating from the resonant point.  This is normally a fixed amount for which the controller is configured and could be positive or negative.  Typically 0 to 60 A depending on voltage and resonance conditions.</rdfs:comment>
        <rdfs:label xml:lang="en">offsetCurrent</rdfs:label>
    </owl:ObjectProperty>
    


