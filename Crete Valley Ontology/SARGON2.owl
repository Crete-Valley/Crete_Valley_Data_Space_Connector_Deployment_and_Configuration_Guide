        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>If set true and if reconnection can be operated locally then the operation happens automatically. Otherwise it happens manually.</rdfs:comment>
        <rdfs:label xml:lang="en">isLocalAutoReconOp</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ConnectDisconnectFunction.isRemoteAutoDisconOp -->

