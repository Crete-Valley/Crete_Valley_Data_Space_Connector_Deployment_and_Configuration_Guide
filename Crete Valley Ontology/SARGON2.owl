    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PanDemandResponse.cancelControlMode">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PanDemandResponse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Encoding of cancel control.</rdfs:comment>
        <rdfs:label xml:lang="en">cancelControlMode</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PanDemandResponse.cancelDateTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PanDemandResponse.cancelDateTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PanDemandResponse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Timestamp when a canceling of the event is scheduled to start.</rdfs:comment>
        <rdfs:label xml:lang="en">cancelDateTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PanDemandResponse.cancelNow -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PanDemandResponse.cancelNow">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PanDemandResponse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>If true a canceling of the event should start immediately.</rdfs:comment>
        <rdfs:label xml:lang="en">cancelNow</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PanDemandResponse.criticalityLevel -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PanDemandResponse.criticalityLevel">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PanDemandResponse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Level of criticality for the action of this control. The action taken by load control devices for an event can be solely based on this value or in combination with other load control event fields supported by the device.</rdfs:comment>
        <rdfs:label xml:lang="en">criticalityLevel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PanDemandResponse.enrollmentGroup -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PanDemandResponse.enrollmentGroup">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PanDemandResponse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Provides a mechanism to direct load control actions to groups of PAN devices. It can be used in conjunction with the PAN device types.</rdfs:comment>
        <rdfs:label xml:lang="en">enrollmentGroup</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PanDisplay.confirmationRequired -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PanDisplay.confirmationRequired">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PanDisplay"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>If true the requesting entity e.g. retail electric provider requires confirmation of the successful display of the text message.</rdfs:comment>
        <rdfs:label xml:lang="en">confirmationRequired</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PanDisplay.priority -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PanDisplay.priority">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PanDisplay"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Priority associated with the text message to be displayed.</rdfs:comment>
        <rdfs:label xml:lang="en">priority</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PanDisplay.textMessage -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PanDisplay.textMessage">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PanDisplay"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Text to be displayed by a PAN device.</rdfs:comment>
        <rdfs:label xml:lang="en">textMessage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PanPricing.providerID -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PanPricing.providerID">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PanPricing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Unique identifier for the commodity provider.</rdfs:comment>
        <rdfs:label xml:lang="en">providerID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PanPricingDetail.alternateCostDelivered -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PanPricingDetail.alternateCostDelivered">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PanPricingDetail"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Alternative measure of the cost of the energy consumed. An example might be the emissions of CO2 for each kWh of electricity consumed providing a measure of the environmental cost.</rdfs:comment>
        <rdfs:label xml:lang="en">alternateCostDelivered</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PanPricingDetail.alternateCostUnit -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PanPricingDetail.alternateCostUnit">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PanPricingDetail"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Cost unit for the alternate cost delivered field. One example is kg of CO2 per unit of measure.</rdfs:comment>
        <rdfs:label xml:lang="en">alternateCostUnit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PanPricingDetail.currentTimeDate -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PanPricingDetail.currentTimeDate">
