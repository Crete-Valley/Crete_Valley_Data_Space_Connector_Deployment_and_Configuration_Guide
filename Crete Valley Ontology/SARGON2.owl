        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#YesNo"/>
        <rdfs:comment>Is the Resource Synchronous Condenser capable Resource? </rdfs:comment>
        <rdfs:label xml:lang="en">syncCondCapable</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredGenerator.unitType -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredGenerator.unitType">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegisteredGenerator"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#UnitType"/>
