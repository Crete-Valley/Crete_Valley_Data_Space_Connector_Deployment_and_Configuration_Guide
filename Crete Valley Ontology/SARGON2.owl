    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#EnvironmentalAlert.cancelledDateTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#EnvironmentalAlert.cancelledDateTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#EnvironmentalAlert"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
