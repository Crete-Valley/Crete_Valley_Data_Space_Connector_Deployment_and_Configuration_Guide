        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ConnectDisconnectFunction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>If set true and if disconnection can be operated locally the operation happens automatically. Otherwise it happens manually.</rdfs:comment>
        <rdfs:label xml:lang="en">isLocalAutoDisconOp</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ConnectDisconnectFunction.isLocalAutoReconOp -->

