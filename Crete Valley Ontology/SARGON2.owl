        <rdfs:label xml:lang="en">maximum</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.iec.ch/TC57/CIM#AggregateKind.minimum -->

    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#AggregateKind.minimum">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#AggregateKind"/>
