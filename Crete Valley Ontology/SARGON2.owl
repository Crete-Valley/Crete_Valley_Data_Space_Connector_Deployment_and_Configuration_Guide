    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PassThroughBill.effectiveDate -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PassThroughBill.effectiveDate">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PassThroughBill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The effective date of the transaction</rdfs:comment>
        <rdfs:label xml:lang="en">effectiveDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PassThroughBill.isDisputed -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PassThroughBill.isDisputed">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PassThroughBill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Disputed transaction indicator </rdfs:comment>
        <rdfs:label xml:lang="en">isDisputed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PassThroughBill.isProfiled -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PassThroughBill.isProfiled">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PassThroughBill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>A flag indicating whether there is a profile data associated with the PTB.</rdfs:comment>
        <rdfs:label xml:lang="en">isProfiled</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PassThroughBill.paidTo -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PassThroughBill.paidTo">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PassThroughBill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The company to which the PTB transaction is paid.</rdfs:comment>
        <rdfs:label xml:lang="en">paidTo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PassThroughBill.previousEnd -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PassThroughBill.previousEnd">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PassThroughBill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The previous bill period end date</rdfs:comment>
        <rdfs:label xml:lang="en">previousEnd</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PassThroughBill.previousStart -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PassThroughBill.previousStart">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PassThroughBill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The previous bill period start date</rdfs:comment>
        <rdfs:label xml:lang="en">previousStart</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PassThroughBill.productCode -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PassThroughBill.productCode">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PassThroughBill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The product identifier for determining the charge type of the transaction. </rdfs:comment>
        <rdfs:label xml:lang="en">productCode</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PassThroughBill.providedBy -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PassThroughBill.providedBy">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PassThroughBill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The company by which the PTB transaction service is provided.</rdfs:comment>
        <rdfs:label xml:lang="en">providedBy</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PassThroughBill.serviceEnd -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PassThroughBill.serviceEnd">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PassThroughBill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The end date of service provided if periodic.</rdfs:comment>
        <rdfs:label xml:lang="en">serviceEnd</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PassThroughBill.serviceStart -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PassThroughBill.serviceStart">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PassThroughBill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The start date of service provided if periodic. </rdfs:comment>
        <rdfs:label xml:lang="en">serviceStart</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PassThroughBill.soldTo -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PassThroughBill.soldTo">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PassThroughBill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The company to which the PTB transaction is sold.</rdfs:comment>
        <rdfs:label xml:lang="en">soldTo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PassThroughBill.timeZone -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PassThroughBill.timeZone">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PassThroughBill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The time zone code</rdfs:comment>
        <rdfs:label xml:lang="en">timeZone</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PassThroughBill.tradeDate -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PassThroughBill.tradeDate">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PassThroughBill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The trade date</rdfs:comment>
        <rdfs:label xml:lang="en">tradeDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PassThroughBill.transactionDate -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PassThroughBill.transactionDate">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PassThroughBill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The date the transaction occurs.</rdfs:comment>
        <rdfs:label xml:lang="en">transactionDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PassThroughBill.transactionType -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PassThroughBill.transactionType">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PassThroughBill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The type of transaction. For example charge customer bill customer matching ARAP or bill determinant </rdfs:comment>
        <rdfs:label xml:lang="en">transactionType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PendingCalculation.multiplyBeforeAdd -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PendingCalculation.multiplyBeforeAdd">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PendingCalculation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Whether scalars should be applied before adding the offset.</rdfs:comment>
        <rdfs:label xml:lang="en">multiplyBeforeAdd</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PendingCalculation.offset -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PendingCalculation.offset">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PendingCalculation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>if applicable Offset to be added as well as multiplication using scalars.</rdfs:comment>
        <rdfs:label xml:lang="en">offset</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PendingCalculation.scalarDenominator -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PendingCalculation.scalarDenominator">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PendingCalculation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>if scalar is rational number When IntervalReading.value is multiplied by scalarNumerator and divided by this value it causes a unit of measure conversion to occur resulting in the ReadingType.unit.</rdfs:comment>
        <rdfs:label xml:lang="en">scalarDenominator</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PendingCalculation.scalarFloat -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PendingCalculation.scalarFloat">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PendingCalculation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>if scalar is floating number When multiplied with IntervalReading.value it causes a unit of measure conversion to occur according to the ReadingType.unit.</rdfs:comment>
        <rdfs:label xml:lang="en">scalarFloat</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PendingCalculation.scalarNumerator -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PendingCalculation.scalarNumerator">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PendingCalculation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>if scalar is integer or rational number  When the scalar is a simple integer and this attribute is presented alone and multiplied with IntervalReading.value it causes a unit of measure conversion to occur resulting in the ReadingType.unit. It is never used in conjunction with scalarFloat only with scalarDenominator.</rdfs:comment>
        <rdfs:label xml:lang="en">scalarNumerator</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PerLengthPhaseImpedance.conductorCount -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PerLengthPhaseImpedance.conductorCount">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PerLengthPhaseImpedance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
