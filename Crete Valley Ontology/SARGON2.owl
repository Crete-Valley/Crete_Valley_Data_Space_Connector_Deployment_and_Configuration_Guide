        <rdfs:label xml:lang="en">SideA_SubControlArea</rdfs:label>
        <rdfs:label>SupplierEnd</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TieLine.SideB_SubControlArea -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TieLine.SideB_SubControlArea">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TieLine"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#SubControlArea"/>
        <rdfs:comment>The SubControlArea is on the B side of a collection of metered points which define the SubControlAreas boundary for a ControlAreaOperator or CustomerConsumer.</rdfs:comment>
        <rdfs:label xml:lang="en">SideB_SubControlArea</rdfs:label>
        <rdfs:label>SupplierEnd</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TiePoint.ByMktMeasurement -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TiePoint.ByMktMeasurement">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TiePoint"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#MktMeasurement"/>
        <rdfs:comment>A measurement is made on the B side of a tie point</rdfs:comment>
        <rdfs:label xml:lang="en">ByMktMeasurement</rdfs:label>
        <rdfs:label>SupplierEnd</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TiePoint.ForMktMeasurement -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TiePoint.ForMktMeasurement">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TiePoint"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#MktMeasurement"/>
        <rdfs:comment>A measurement is made on the A side of a tie point</rdfs:comment>
        <rdfs:label xml:lang="en">ForMktMeasurement</rdfs:label>
        <rdfs:label>SupplierEnd</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TiePoint.tiePointMWRating -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TiePoint.tiePointMWRating">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TiePoint"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ActivePower"/>
        <rdfs:comment>The MW rating of the tie point.</rdfs:comment>
        <rdfs:label xml:lang="en">tiePointMWRating</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TimePoint.TimeSchedule -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TimePoint.TimeSchedule">
        <owl:inverseOf rdf:resource="http://www.iec.ch/TC57/CIM#TimeSchedule.TimePoints"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TimePoint"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#TimeSchedule"/>
        <rdfs:comment>Time schedule owning this time point.</rdfs:comment>
        <rdfs:label>ClientEnd</rdfs:label>
        <rdfs:label xml:lang="en">TimeSchedule</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TimePoint.relativeTimeInterval -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TimePoint.relativeTimeInterval">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TimePoint"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Seconds"/>
        <rdfs:comment>if intervalbased A point in time relative to scheduled start time in TimeSchedule.scheduleInterval.start.</rdfs:comment>
        <rdfs:label xml:lang="en">relativeTimeInterval</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TimePoint.window -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TimePoint.window">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TimePoint"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#DateTimeInterval"/>
        <rdfs:comment>Interval defining the window of time that this time point is valid for example seasonal only on weekends not on weekends only 800 am to 500 pm etc..</rdfs:comment>
        <rdfs:label xml:lang="en">window</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TimeSchedule.TimePoints -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TimeSchedule.TimePoints">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TimeSchedule"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#TimePoint"/>
        <rdfs:comment>Sequence of time points belonging to this time schedule.</rdfs:comment>
        <rdfs:label>SupplierEnd</rdfs:label>
        <rdfs:label xml:lang="en">TimePoints</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TimeSchedule.offset -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TimeSchedule.offset">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TimeSchedule"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Seconds"/>
        <rdfs:comment>The offset from midnight i.e. 0 h 0 min 0 s for the periodic time points to begin. For example for an interval meter that is set up for five minute intervals recurrencePeriod3005 min setting offset1202 min would result in scheduled events to read the meter executing at 2 min 7 min 12 min 17 min 22 min 27 min 32 min 37 min 42 min 47 min 52 min and 57 min past each hour.</rdfs:comment>
        <rdfs:label xml:lang="en">offset</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TimeSchedule.recurrencePeriod -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TimeSchedule.recurrencePeriod">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TimeSchedule"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Seconds"/>
        <rdfs:comment>Duration between time points from the beginning of one period to the beginning of the next period. Note that a device like a meter may have multiple interval periods e.g. 1 min 5 min 15 min 30 min or 60 min.</rdfs:comment>
        <rdfs:label xml:lang="en">recurrencePeriod</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TimeSchedule.scheduleInterval -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TimeSchedule.scheduleInterval">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TimeSchedule"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#DateTimeInterval"/>
        <rdfs:comment>Schedule date and time interval.</rdfs:comment>
        <rdfs:label xml:lang="en">scheduleInterval</rdfs:label>
    </owl:ObjectProperty>
    


