    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TapChangerInfo.neutralU">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TapChangerInfo"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Voltage"/>
        <rdfs:comment>Voltage at which the winding operates at the neutral tap setting.</rdfs:comment>
        <rdfs:label xml:lang="en">neutralU</rdfs:label>
    </owl:ObjectProperty>
    


