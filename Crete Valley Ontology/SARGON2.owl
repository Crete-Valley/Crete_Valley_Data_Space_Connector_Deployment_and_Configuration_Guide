        <rdfs:label xml:lang="en">InterTieResults</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#InterchangeETCData -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#InterchangeETCData">
