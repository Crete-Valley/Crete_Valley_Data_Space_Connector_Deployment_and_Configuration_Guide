        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Winding phase angle where 360 degrees are represented with clock hours so the valid values are 0 ... 11. For example to express the second winding in code Dyn11 set attributes as follows endNumber2 connectionKind  Yn and phaseAngleClock  11.</rdfs:comment>
        <rdfs:label xml:lang="en">phaseAngleClock</rdfs:label>
    </owl:DatatypeProperty>
    


