        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Total Transmission Capacity</rdfs:comment>
        <rdfs:label xml:lang="en">totalTransmissionCapacity</rdfs:label>
    </owl:DatatypeProperty>
    


