        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ConnectDisconnectFunction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>True if this function is in the connected state.</rdfs:comment>
        <rdfs:label xml:lang="en">isConnected</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ConnectDisconnectFunction.isDelayedDiscon -->

