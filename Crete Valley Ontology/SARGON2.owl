        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#MarketProductTypeAsReq"/>
        <rdfs:label xml:lang="en">AS</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.iec.ch/TC57/CIM#MarketProductTypeAsReq.NR -->

    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#MarketProductTypeAsReq.NR">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#MarketProductTypeAsReq"/>
