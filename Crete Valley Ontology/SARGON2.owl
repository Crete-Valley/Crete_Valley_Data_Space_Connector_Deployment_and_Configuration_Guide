    <!-- http://www.iec.ch/TC57/CIM#MacroPeriodKind.billingPeriod -->

    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#MacroPeriodKind.billingPeriod">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#MacroPeriodKind"/>
        <rdfs:comment>Captured during the billing period starting at midnight of the first day of the billing period as defined by the billing cycle day. If during the current billing period it specifies a period from the start of the current billing period until now.</rdfs:comment>
        <rdfs:label xml:lang="en">billingPeriod</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.iec.ch/TC57/CIM#MacroPeriodKind.daily -->

    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#MacroPeriodKind.daily">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#MacroPeriodKind"/>
        <rdfs:comment>Daily period starting at midnight. If for the current day this specifies the time from midnight to now.</rdfs:comment>
        <rdfs:label xml:lang="en">daily</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.iec.ch/TC57/CIM#MacroPeriodKind.monthly -->

    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#MacroPeriodKind.monthly">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#MacroPeriodKind"/>
        <rdfs:comment>Monthly period starting at midnight on the first day of the month. If within the current month this specifies the period from the start of the month until now.</rdfs:comment>
        <rdfs:label xml:lang="en">monthly</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.iec.ch/TC57/CIM#MacroPeriodKind.none -->

    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#MacroPeriodKind.none">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#MacroPeriodKind"/>
        <rdfs:comment>Not applicable.</rdfs:comment>
        <rdfs:label xml:lang="en">none</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.iec.ch/TC57/CIM#MacroPeriodKind.seasonal -->

    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#MacroPeriodKind.seasonal">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#MacroPeriodKind"/>
        <rdfs:comment>A season of time spanning multiple months. E.g. Summer Spring Fall and Winter based cycle. If within the current season it specifies the period from the start of the current season until now.</rdfs:comment>
        <rdfs:label xml:lang="en">seasonal</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.iec.ch/TC57/CIM#MacroPeriodKind.specifiedPeriod -->

    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#MacroPeriodKind.specifiedPeriod">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#MacroPeriodKind"/>
        <rdfs:comment>For the period defined by the start and end of the TimePeriod element in the message.</rdfs:comment>
        <rdfs:label xml:lang="en">specifiedPeriod</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.iec.ch/TC57/CIM#MacroPeriodKind.weekly -->

    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#MacroPeriodKind.weekly">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#MacroPeriodKind"/>
        <rdfs:comment>Weekly period starting at midnight on the first day of the week and ending the instant before midnight the last day of the week. If within the current week it specifies the period from the start of the week until now.</rdfs:comment>
        <rdfs:label xml:lang="en">weekly</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.iec.ch/TC57/CIM#MarketEventStatusKind.active -->

    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#MarketEventStatusKind.active">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#MarketEventStatusKind"/>
        <rdfs:comment>The status of the event is currently in a active state.Active when sysdate is equal or greater than to planned start time</rdfs:comment>
        <rdfs:label xml:lang="en">active</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.iec.ch/TC57/CIM#MarketEventStatusKind.cancelled -->

    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#MarketEventStatusKind.cancelled">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#MarketEventStatusKind"/>
        <rdfs:comment>The status of the event is currently in a cancelled state.Cancelled stopped before planned start time or planned end time</rdfs:comment>
        <rdfs:label xml:lang="en">cancelled</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.iec.ch/TC57/CIM#MarketEventStatusKind.completed -->

    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#MarketEventStatusKind.completed">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#MarketEventStatusKind"/>
        <rdfs:comment>The status of the event is currently in a completed state.Complete when sysdate is equal to the release time</rdfs:comment>
        <rdfs:label xml:lang="en">completed</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.iec.ch/TC57/CIM#MarketEventStatusKind.planned -->

    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#MarketEventStatusKind.planned">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#MarketEventStatusKind"/>
        <rdfs:comment>The status of the event is currently in a planned state.Planned sysdate is less than planned start time</rdfs:comment>
        <rdfs:label xml:lang="en">planned</rdfs:label>
    </owl:NamedIndividual>
    


