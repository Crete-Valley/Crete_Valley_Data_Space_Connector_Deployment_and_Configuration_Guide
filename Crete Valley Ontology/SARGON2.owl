    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Document.lastModifiedDateTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Document"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
