        <rdfs:label xml:lang="en">maxOnTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredResource.minOffTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredResource.minOffTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegisteredResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Minimum off time after shut down.</rdfs:comment>
        <rdfs:label xml:lang="en">minOffTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredResource.minOnTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredResource.minOnTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegisteredResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Minimum on time after start up.</rdfs:comment>
        <rdfs:label xml:lang="en">minOnTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegularIntervalSchedule.endTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegularIntervalSchedule.endTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegularIntervalSchedule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The time for the last time point.  The value can be a time of day not a specific date.</rdfs:comment>
        <rdfs:label xml:lang="en">endTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegularTimePoint.sequenceNumber -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegularTimePoint.sequenceNumber">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegularTimePoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The position of the regular time point in the sequence. Note that time points dont have to be sequential i.e. time points may be omitted. The actual time for a RegularTimePoint is computed by multiplying the associated regular interval schedules time step with the regular time point sequence number and adding the associated schedules start time. To specify values for the start time use sequence number 0.  The sequence number cannot be negative.</rdfs:comment>
        <rdfs:label xml:lang="en">sequenceNumber</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegulatingControl.discrete -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegulatingControl.discrete">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegulatingControl"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>The regulation is performed in a discrete mode. This applies to equipment with discrete controls e.g. tap changers and shunt compensators.</rdfs:comment>
        <rdfs:label xml:lang="en">discrete</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegulatingControl.enabled -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegulatingControl.enabled">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegulatingControl"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>The flag tells if regulation is enabled.</rdfs:comment>
        <rdfs:label xml:lang="en">enabled</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegulatingControl.maxAllowedTargetValue -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegulatingControl.maxAllowedTargetValue">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegulatingControl"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Maximum allowed target value RegulatingControl.targetValue.</rdfs:comment>
        <rdfs:label xml:lang="en">maxAllowedTargetValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegulatingControl.minAllowedTargetValue -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegulatingControl.minAllowedTargetValue">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegulatingControl"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Minimum allowed target value RegulatingControl.targetValue.</rdfs:comment>
        <rdfs:label xml:lang="en">minAllowedTargetValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegulatingControl.targetDeadband -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegulatingControl.targetDeadband">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegulatingControl"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>This is a deadband used with discrete control to avoid excessive update of controls like tap changers and shunt compensator banks while regulating.  The units of those appropriate for the mode. The attribute shall be a positive value or zero. If RegulatingControl.discrete is set to false the RegulatingControl.targetDeadband is to be ignored.Note that for instance if the targetValue is 100 kV and the targetDeadband is 2 kV the range is from 99 to 101 kV.</rdfs:comment>
        <rdfs:label xml:lang="en">targetDeadband</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegulatingControl.targetValue -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegulatingControl.targetValue">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegulatingControl"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The target value specified for case input.   This value can be used for the target value without the use of schedules. The value has the units appropriate to the mode attribute.</rdfs:comment>
        <rdfs:label xml:lang="en">targetValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Regulation.referenceNumber -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Regulation.referenceNumber">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Regulation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment> External reference to regulation if applicable.</rdfs:comment>
        <rdfs:label xml:lang="en">referenceNumber</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RemoteConnectDisconnectInfo.energyUsageStartDateTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RemoteConnectDisconnectInfo.energyUsageStartDateTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RemoteConnectDisconnectInfo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Start date and time to accumulate energy for energy usage limiting.</rdfs:comment>
        <rdfs:label xml:lang="en">energyUsageStartDateTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RemoteConnectDisconnectInfo.isArmConnect -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RemoteConnectDisconnectInfo.isArmConnect">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RemoteConnectDisconnectInfo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>True if the RCD switch has to be armed before a connect action can be initiated.</rdfs:comment>
        <rdfs:label xml:lang="en">isArmConnect</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RemoteConnectDisconnectInfo.isArmDisconnect -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RemoteConnectDisconnectInfo.isArmDisconnect">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RemoteConnectDisconnectInfo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>True if the RCD switch has to be armed before a disconnect action can be initiated.</rdfs:comment>
        <rdfs:label xml:lang="en">isArmDisconnect</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RemoteConnectDisconnectInfo.isEnergyLimiting -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RemoteConnectDisconnectInfo.isEnergyLimiting">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RemoteConnectDisconnectInfo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>True if the energy usage is limited and the customer will be disconnected if they go over the limit.</rdfs:comment>
        <rdfs:label xml:lang="en">isEnergyLimiting</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RemoteConnectDisconnectInfo.needsPowerLimitCheck -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RemoteConnectDisconnectInfo.needsPowerLimitCheck">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RemoteConnectDisconnectInfo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>True if load limit has to be checked to issue an immediate disconnect after a connect if load is over the limit.</rdfs:comment>
        <rdfs:label xml:lang="en">needsPowerLimitCheck</rdfs:label>
    </owl:DatatypeProperty>
    


