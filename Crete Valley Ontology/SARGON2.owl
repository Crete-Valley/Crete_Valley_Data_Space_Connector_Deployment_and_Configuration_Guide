        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ProtectedSwitch"/>
        <rdfs:comment>A breaker may have zero or more automatic reclosures after a trip occurs.</rdfs:comment>
        <rdfs:label xml:lang="en">ProtectedSwitch</rdfs:label>
        <rdfs:label>SupplierEnd</rdfs:label>
    </owl:ObjectProperty>
    


