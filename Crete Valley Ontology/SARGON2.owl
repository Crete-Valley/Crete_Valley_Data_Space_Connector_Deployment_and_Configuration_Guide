        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Revision number for this document.</rdfs:comment>
        <rdfs:label xml:lang="en">revisionNumber</rdfs:label>
    </owl:DatatypeProperty>
    


