        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Money"/>
        <rdfs:comment>Cumulative total of transacted amounts during this shift. Values are obtained from transactionsumTransaction.transactionAmount. It also has to be reconciled against transaction summarysumTransactionSummary.transactionsTotal.</rdfs:comment>
        <rdfs:label xml:lang="en">transactionsGrandTotal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Shift.transactionsGrandTotalRounding -->

