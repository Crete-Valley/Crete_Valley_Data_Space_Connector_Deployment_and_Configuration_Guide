    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TransformerObservation.pumpVibration -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#TransformerObservation.pumpVibration">
