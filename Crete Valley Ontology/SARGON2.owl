        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TimeSeries"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#MktPSRType"/>
        <rdfs:label>ClientEnd</rdfs:label>
        <rdfs:label xml:lang="en">MktPSRType</rdfs:label>
    </owl:ObjectProperty>
    


