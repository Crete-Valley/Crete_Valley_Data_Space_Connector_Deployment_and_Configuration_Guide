        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Money"/>
        <rdfs:comment>Cumulative amount in error due to process rounding not reflected in receiptsGrandTotal. Values are obtained from Receipt attributessumReceipt.receiptRounding.</rdfs:comment>
        <rdfs:label xml:lang="en">receiptsGrandTotalRounding</rdfs:label>
    </owl:ObjectProperty>
    


