    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PricingStructure.dailyEstimatedUsage -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PricingStructure.dailyEstimatedUsage">
