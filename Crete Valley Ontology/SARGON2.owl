        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Purpose of  this plan such as whether it is to move the state from normal to some abnormal condition or to restore the normal state after an abnormal condition or to perform some kind of optimisation such as correction of overload voltage control etc.</rdfs:comment>
        <rdfs:label xml:lang="en">purpose</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SwitchingPlan.rank -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#SwitchingPlan.rank">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#SwitchingPlan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Ranking in comparison to other switching plans.</rdfs:comment>
        <rdfs:label xml:lang="en">rank</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SwitchingPlanRequest.comment -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#SwitchingPlanRequest.comment">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#SwitchingPlanRequest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Freeform text to describe the request</rdfs:comment>
        <rdfs:label xml:lang="en">comment</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SwitchingPlanRequest.equipmentToBeIsolated -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#SwitchingPlanRequest.equipmentToBeIsolated">
