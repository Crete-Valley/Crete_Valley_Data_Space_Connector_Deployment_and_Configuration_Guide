    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TransmissionCapacity.capacityBenefitMargin -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#TransmissionCapacity.capacityBenefitMargin">
