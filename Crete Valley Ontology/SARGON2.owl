    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#InterTieDirection -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#InterTieDirection">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Direction of an intertie.</rdfs:comment>
        <rdfs:label xml:lang="en">InterTieDirection</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#InterTieDispatchResponse -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#InterTieDispatchResponse">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Toplevel"/>
