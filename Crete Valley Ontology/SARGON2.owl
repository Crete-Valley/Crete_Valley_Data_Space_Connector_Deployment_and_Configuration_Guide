        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Seconds"/>
        <rdfs:comment>Transient rotor time constant iToi gt AsynchronousMachineTimeConstantReactance.tppo.  Typical value  5.</rdfs:comment>
        <rdfs:label xml:lang="en">tpo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#AsynchronousMachineTimeConstantReactance.xp -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#AsynchronousMachineTimeConstantReactance.xp">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#AsynchronousMachineTimeConstantReactance"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#PU"/>
        <rdfs:comment>Transient reactance unsaturated iXi gt AsynchronousMachineTimeConstantReactance.xpp.  Typical value  05.</rdfs:comment>
        <rdfs:label xml:lang="en">xp</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#AsynchronousMachineTimeConstantReactance.xpp -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#AsynchronousMachineTimeConstantReactance.xpp">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#AsynchronousMachineTimeConstantReactance"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#PU"/>
        <rdfs:comment>Subtransient reactance unsaturated iXi gt RotatingMachineDynamics.statorLeakageReactance.  Typical value  02.</rdfs:comment>
        <rdfs:label xml:lang="en">xpp</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#AsynchronousMachineTimeConstantReactance.xs -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#AsynchronousMachineTimeConstantReactance.xs">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#AsynchronousMachineTimeConstantReactance"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#PU"/>
        <rdfs:comment>Synchronous reactance iXsi gt AsynchronousMachineTimeConstantReactance.xp.  Typical value  18.</rdfs:comment>
        <rdfs:label xml:lang="en">xs</rdfs:label>
    </owl:ObjectProperty>
    


