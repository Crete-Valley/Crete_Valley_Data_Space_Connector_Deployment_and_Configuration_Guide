        <rdfs:label xml:lang="en">PU</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#PWRSteamSupply -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#PWRSteamSupply">
