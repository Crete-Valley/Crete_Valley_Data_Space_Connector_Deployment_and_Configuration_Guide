        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#SubGeographicalRegion"/>
        <rdfs:comment>The SubGeographicalRegion containing the DC line.</rdfs:comment>
        <rdfs:comment>The SubGeographicalRegion containing the substation.</rdfs:comment>
        <rdfs:comment>The subgeographical region of the line.</rdfs:comment>
        <rdfs:label>ClientEnd</rdfs:label>
