        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#OilAnalysisFluidAnalogKind"/>
        <rdfs:comment>Oxidation induction time in hours. Typically performed on new oilbut can be done on used oil.</rdfs:comment>
        <rdfs:label xml:lang="en">inductionTime</rdfs:label>
