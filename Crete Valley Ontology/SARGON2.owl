    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#Bank -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Bank">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#OrganisationRole"/>
        <rdfs:comment>Organisation that is a commercial bank agency or other institution that offers a similar service.</rdfs:comment>
        <rdfs:label xml:lang="en">Bank</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#BankAccount -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#BankAccount">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Document"/>
        <rdfs:comment>Bank account.</rdfs:comment>
        <rdfs:label xml:lang="en">BankAccount</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#BankAccountDetail -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#BankAccountDetail">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Compound"/>
        <rdfs:comment>Details of a bank account.</rdfs:comment>
        <rdfs:label xml:lang="en">BankAccountDetail</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#BaseCaseConstraintLimit -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#BaseCaseConstraintLimit">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Curve"/>
        <rdfs:comment>Possibly timevarying max MW or MVA and optionally Min MW limit or MVA limit Y1 and Y2 respectively assigned to a contingency analysis base case. Use CurveSchedule XAxisUnits to specify MW or MVA. To be used only if the BaseCaseConstraintLimit differs from the DefaultConstraintLimit.</rdfs:comment>
        <rdfs:label xml:lang="en">BaseCaseConstraintLimit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#BaseFrequency -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#BaseFrequency">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>The BaseFrequency class describes a base frequency for a power system network. In case of multiple power networks with different frequencies e.g. 50 Hz or 60 Hz each network will have its own base frequency class. Hence it is assumed that power system objects having different base frequencies appear in separate documents where each document has a single base frequency instance.</rdfs:comment>
        <rdfs:label xml:lang="en">BaseFrequency</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#BasePower -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#BasePower">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>The BasePower class defines the base power used in the per unit calculations.</rdfs:comment>
        <rdfs:label xml:lang="en">BasePower</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#BaseReading -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#BaseReading">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#MeasurementValue"/>
        <rdfs:comment>Common representation for reading values. Note that a reading value may have multiple qualities as produced by various systems ReadingQuality.source.</rdfs:comment>
        <rdfs:label xml:lang="en">BaseReading</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#BaseVoltage -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#BaseVoltage">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>Defines a system base voltage which is referenced. </rdfs:comment>
        <rdfs:label xml:lang="en">BaseVoltage</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#BaseWork -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#BaseWork">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Document"/>
        <rdfs:comment>Common representation for work and work tasks.</rdfs:comment>
        <rdfs:label xml:lang="en">BaseWork</rdfs:label>
    </owl:Class>
    


