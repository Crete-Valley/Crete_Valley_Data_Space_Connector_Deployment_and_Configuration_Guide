    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#DiagnosisDataSet.rootCause">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#DiagnosisDataSet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Root cause of problem determined during diagnosis.</rdfs:comment>
        <rdfs:label xml:lang="en">rootCause</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#DiagnosisDataSet.rootOrigin -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#DiagnosisDataSet.rootOrigin">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#DiagnosisDataSet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Root origin of problem determined during diagnosis.</rdfs:comment>
        <rdfs:label xml:lang="en">rootOrigin</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#DiagnosisDataSet.rootRemark -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#DiagnosisDataSet.rootRemark">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#DiagnosisDataSet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Remarks pertaining to root cause findings during problem diagnosis.</rdfs:comment>
        <rdfs:label xml:lang="en">rootRemark</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Diagram.x1InitialView -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Diagram.x1InitialView">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Diagram"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>X coordinate of the first corner of the initial view.</rdfs:comment>
        <rdfs:label xml:lang="en">x1InitialView</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Diagram.x2InitialView -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Diagram.x2InitialView">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Diagram"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>X coordinate of the second corner of the initial view.</rdfs:comment>
        <rdfs:label xml:lang="en">x2InitialView</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Diagram.y1InitialView -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Diagram.y1InitialView">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Diagram"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Y coordinate of the first corner of the initial view.</rdfs:comment>
        <rdfs:label xml:lang="en">y1InitialView</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Diagram.y2InitialView -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Diagram.y2InitialView">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Diagram"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Y coordinate of the second corner of the initial view.</rdfs:comment>
        <rdfs:label xml:lang="en">y2InitialView</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#DiagramObject.drawingOrder -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#DiagramObject.drawingOrder">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#DiagramObject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The drawing order of this element. The higher the number the later the element is drawn in sequence. This is used to ensure that elements that overlap are rendered in the correct order.</rdfs:comment>
        <rdfs:label xml:lang="en">drawingOrder</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#DiagramObject.isPolygon -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#DiagramObject.isPolygon">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#DiagramObject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Defines whether or not the diagram objects points define the boundaries of a polygon or the routing of a polyline. If this value is true then a receiving application should consider the first and last points to be connected.</rdfs:comment>
        <rdfs:label xml:lang="en">isPolygon</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#DiagramObject.offsetX -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#DiagramObject.offsetX">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#DiagramObject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The offset in the X direction. This is used for defining the offset from centre for rendering an icon the default is that a single point specifies the centre of the icon.The offset is in perunit with 0 indicating there is no offset from the horizontal centre of the icon.  0.5 indicates it is offset by 50 to the left and 0.5 indicates an offset of 50 to the right.</rdfs:comment>
        <rdfs:label xml:lang="en">offsetX</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#DiagramObject.offsetY -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#DiagramObject.offsetY">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#DiagramObject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The offset in the Y direction. This is used for defining the offset from centre for rendering an icon the default is that a single point specifies the centre of the icon.The offset is in perunit with 0 indicating there is no offset from the vertical centre of the icon.  The offset direction is dependent on the orientation of the diagram with 0.5 and 0.5 indicating an offset of  50 on the vertical axis.</rdfs:comment>
        <rdfs:label xml:lang="en">offsetY</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#DiagramObjectPoint.sequenceNumber -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#DiagramObjectPoint.sequenceNumber">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#DiagramObjectPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The sequence position of the point used for defining the order of points for diagram objects acting as a polyline or polygon with more than one point. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">sequenceNumber</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#DiagramObjectPoint.xPosition -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#DiagramObjectPoint.xPosition">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#DiagramObjectPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The X coordinate of this point.</rdfs:comment>
        <rdfs:label xml:lang="en">xPosition</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#DiagramObjectPoint.yPosition -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#DiagramObjectPoint.yPosition">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#DiagramObjectPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The Y coordinate of this point.</rdfs:comment>
        <rdfs:label xml:lang="en">yPosition</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#DiagramObjectPoint.zPosition -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#DiagramObjectPoint.zPosition">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#DiagramObjectPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The Z coordinate of this point.</rdfs:comment>
        <rdfs:label xml:lang="en">zPosition</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#DimensionsInfo.orientation -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#DimensionsInfo.orientation">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#DimensionsInfo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A description of the orientation of the object relative to the dimensions. As an example a vault may have northsouth orientation for the sizeLength measurement and sizeDepth may be the height of the vault.</rdfs:comment>
        <rdfs:label xml:lang="en">orientation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Discrete.minValue -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Discrete.minValue">
