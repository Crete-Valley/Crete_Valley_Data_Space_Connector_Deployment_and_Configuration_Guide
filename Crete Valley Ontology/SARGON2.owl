        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ActivePower"/>
        <rdfs:comment>maximum load reduction</rdfs:comment>
        <rdfs:label xml:lang="en">maxLoadReduction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredControllableLoad.minLoadReduction -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredControllableLoad.minLoadReduction">
