        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Describe if a metal oxide varistor mov for over voltage protection is configured in parallel with the series compensator. It is used for short circuit calculations.</rdfs:comment>
        <rdfs:label xml:lang="en">varistorPresent</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ServiceGuarantee.automaticPay -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ServiceGuarantee.automaticPay">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ServiceGuarantee"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
