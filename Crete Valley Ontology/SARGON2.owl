        <rdfs:label xml:lang="en">Instructions</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#IntSchedAgreement -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#IntSchedAgreement">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Agreement"/>
