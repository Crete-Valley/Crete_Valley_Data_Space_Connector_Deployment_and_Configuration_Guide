        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Equipment"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UnavailabilitySwitchAction"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UnavailablitySchedule"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#EquipmentUnavailabilitySchedule"/>
        <rdfs:label>ClientEnd</rdfs:label>
        <rdfs:label xml:lang="en">EquipmentUnavailabilitySchedule</rdfs:label>
        <rdfs:label>SupplierEnd</rdfs:label>
    </owl:ObjectProperty>
    


