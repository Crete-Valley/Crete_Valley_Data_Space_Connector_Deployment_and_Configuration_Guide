        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#OilAnalysisFluidAnalogKind"/>
        <rdfs:comment>Flash point in C determined via open cup test. Flash point occurs when enough vapors have accumulated to sustain a flash. Open cup is used in US.</rdfs:comment>
        <rdfs:label xml:lang="en">flashPointOpenCup</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.iec.ch/TC57/CIM#OilAnalysisFluidAnalogKind.inductionTime -->

