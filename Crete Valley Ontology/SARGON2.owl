        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Label for price tier.</rdfs:comment>
        <rdfs:label xml:lang="en">priceTierLabel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PanPricingDetail.rateLabel -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PanPricingDetail.rateLabel">
