        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#CurrentFlow"/>
        <rdfs:comment>Fault current level at which all parts of the failed arrester lie within a circle prescribed by IEC 60099.</rdfs:comment>
        <rdfs:label xml:lang="en">pressureReliefClass</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SurgeArresterInfo.ratedVoltage -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#SurgeArresterInfo.ratedVoltage">
