        <rdfs:label xml:lang="en">SVCUserDefined</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SafetyDocument -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SafetyDocument">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Document"/>
        <rdfs:comment>Document restricting or authorising works on electrical equipment for example a permit to work sanction for test limitation of access or certificate of isolation defined based upon organisational practices.</rdfs:comment>
        <rdfs:label xml:lang="en">SafetyDocument</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SampleContainerType -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SampleContainerType">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Types of sample containers.</rdfs:comment>
        <rdfs:label xml:lang="en">SampleContainerType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ScaleKind -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ScaleKind">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Kinds of scaling.</rdfs:comment>
        <rdfs:label xml:lang="en">ScaleKind</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SchedClassType -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SchedClassType">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:label xml:lang="en">SchedClassType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ScheduledActivePowerLimitValue -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ScheduledActivePowerLimitValue">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#ScheduledLimitValue"/>
        <rdfs:label xml:lang="en">ScheduledActivePowerLimitValue</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ScheduledApparentPowerLimitValue -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ScheduledApparentPowerLimitValue">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#ScheduledLimitValue"/>
        <rdfs:comment>A time scheduled value for apparent power limit.</rdfs:comment>
        <rdfs:label xml:lang="en">ScheduledApparentPowerLimitValue</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ScheduledCurrentLimitValue -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ScheduledCurrentLimitValue">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#ScheduledLimitValue"/>
        <rdfs:comment>A current limit that is scheduled.</rdfs:comment>
        <rdfs:label xml:lang="en">ScheduledCurrentLimitValue</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ScheduledEvent -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ScheduledEvent">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>An event to trigger one or more activities such as reading a meter recalculating a bill requesting work when generating units must be scheduled for maintenance when a transformer is scheduled to be refurbished etc.</rdfs:comment>
        <rdfs:label xml:lang="en">ScheduledEvent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ScheduledEventData -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ScheduledEventData">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Toplevel"/>
        <rdfs:comment>Schedule parameters for an activity that is to occur is occurring or has completed.</rdfs:comment>
        <rdfs:label xml:lang="en">ScheduledEventData</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ScheduledLimitValue -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ScheduledLimitValue">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>A limit that is applicable during a scheduled time period.</rdfs:comment>
        <rdfs:label xml:lang="en">ScheduledLimitValue</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ScheduledVoltageLimitValue -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ScheduledVoltageLimitValue">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#ScheduledLimitValue"/>
        <rdfs:comment>A voltage limit value for a scheduled time.</rdfs:comment>
        <rdfs:label xml:lang="en">ScheduledVoltageLimitValue</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SchedulingCoordinator -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SchedulingCoordinator">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#MarketParticipant"/>
        <rdfs:comment>Market participants could be represented by Scheduling Coordinators SCs that are registered with the RTOISO. One participant could register multiple SCs with the RTOISO. Many market participants can do business with the RTOISO using a single SC. One SC could schedule multiple generators. A load scheduling point could be used by multiple SCs. Each SC could schedule load at multiple scheduling points. An intertie scheduling point can be used by multiple SCs. Each SC can schedule interchange at multiple intertie scheduling points.</rdfs:comment>
        <rdfs:label xml:lang="en">SchedulingCoordinator</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SchedulingCoordinatorUser -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SchedulingCoordinatorUser">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Toplevel"/>
        <rdfs:comment>Describing users of a Scheduling Coordinator.</rdfs:comment>
        <rdfs:label xml:lang="en">SchedulingCoordinatorUser</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SchedulingPoint -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SchedulingPoint">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>Connection to other organizations at the boundary of the ISORTO.</rdfs:comment>
        <rdfs:label xml:lang="en">SchedulingPoint</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#Seal -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Seal">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>Physically controls access to AssetContainers.</rdfs:comment>
        <rdfs:label xml:lang="en">Seal</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SealConditionKind -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SealConditionKind">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Kind of seal condition.</rdfs:comment>
        <rdfs:label xml:lang="en">SealConditionKind</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SealKind -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SealKind">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Kind of seal.</rdfs:comment>
        <rdfs:label xml:lang="en">SealKind</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#Season -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Season">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>A specified time period of the year.</rdfs:comment>
        <rdfs:label xml:lang="en">Season</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SeasonDayTypeSchedule -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SeasonDayTypeSchedule">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#RegularIntervalSchedule"/>
        <rdfs:comment>A time schedule covering a 24 hour period with curve data for a specific type of season and day.</rdfs:comment>
        <rdfs:label xml:lang="en">SeasonDayTypeSchedule</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#Seconds -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Seconds">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#CIMDatatype"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/saref#Time"/>
        <rdfs:comment>Time in seconds.</rdfs:comment>
        <rdfs:label xml:lang="en">Seconds</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#Sectionaliser -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Sectionaliser">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Switch"/>
        <rdfs:comment>Automatic switch that will lock open to isolate a faulted section. It may or may not have load breaking capability. Its primary purpose is to provide fault sectionalising at locations where the fault current is either too high or too low for proper coordination of fuses.</rdfs:comment>
        <rdfs:label xml:lang="en">Sectionaliser</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SecurityConstraintSum -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SecurityConstraintSum">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#MarketFactors"/>
        <rdfs:comment>Typically provided by RTO systems constraints identified in both base case and critical contingency cases have to be transferred.A constraint has N gt1 constraint terms. A term is represented by an instance of TerminalConstraintTerm. The constraint expression isminValue lt c1x1  c2x2  .... cnxn  k lt maxValuewhere cn is ConstraintTerm.factor  xn is the flow at the terminalFlow into the associated equipment is positive for the purpose of ConnectivityNode NodeConstraintTerm.k is SecurityConstraintsLinear.resourceMW.The units of k are assumed to be same as the units of the flows xn.  The constants cn are dimensionless.With these conventions cn and k are all positive for a typical constraint such as weighted sum of generation shall be less than limit. Furthermore cn are all 1.0 for a case such as interface flow shall be less than limit assuming the terminals are chosen on the importing side of the interface.</rdfs:comment>
        <rdfs:label xml:lang="en">SecurityConstraintSum</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SecurityConstraints -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SecurityConstraints">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>Typical for regional transmission operators RTOs these constraints include transmission as well as generation group constraints identified in both base case and critical contingency cases.</rdfs:comment>
        <rdfs:label xml:lang="en">SecurityConstraints</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SecurityConstraintsClearing -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SecurityConstraintsClearing">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#MarketFactors"/>
        <rdfs:comment>Binding security constrained clearing results posted for a given settlement period.</rdfs:comment>
        <rdfs:label xml:lang="en">SecurityConstraintsClearing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SegmentCurveType -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SegmentCurveType">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:label xml:lang="en">SegmentCurveType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SelfSchedReferenceType -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SelfSchedReferenceType">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Indication of which type of self schedule is being referenced.</rdfs:comment>
        <rdfs:label xml:lang="en">SelfSchedReferenceType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SelfSchedTypeCleanBid -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SelfSchedTypeCleanBid">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:label xml:lang="en">SelfSchedTypeCleanBid</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SelfSchedTypeRawBid -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SelfSchedTypeRawBid">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:label xml:lang="en">SelfSchedTypeRawBid</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SelfScheduleBreakdown -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SelfScheduleBreakdown">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Toplevel"/>
        <rdfs:comment>Model of Self Schedules Results.  Includes self schedule MWand type of self schedule for each self schedule type included in total self schedule MW value found in ResourceAwardInstruction.</rdfs:comment>
        <rdfs:label xml:lang="en">SelfScheduleBreakdown</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SelfScheduleBreakdownType -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SelfScheduleBreakdownType">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Self schedule breakdown type.</rdfs:comment>
        <rdfs:label xml:lang="en">SelfScheduleBreakdownType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SelfScheduleType -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SelfScheduleType">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>self schedule typesPTETCTORRMRRMTRGMRORFCSP</rdfs:comment>
        <rdfs:label xml:lang="en">SelfScheduleType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SelfScheduleTypeMB -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SelfScheduleTypeMB">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Self Schedule Types applicable to Mitigated Bid</rdfs:comment>
        <rdfs:label xml:lang="en">SelfScheduleTypeMB</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SensitivityPriceCurve -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SensitivityPriceCurve">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Curve"/>
        <rdfs:comment>Optionally this curve expresses elasticity of the associated requirement.  For example used to reduce requirements when clearing price exceeds reasonable values when the supply quantity becomes scarce. For example a single point value of 1000MW for a spinning reserve will cause a reduction in the required spinning reserve. X axis is constrained quantity e.g. MWY1 axis is money per constrained quantity</rdfs:comment>
        <rdfs:label xml:lang="en">SensitivityPriceCurve</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#Sensor -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Sensor">
        <owl:equivalentClass rdf:resource="https://w3id.org/saref#Sensor"/>
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#AuxiliaryEquipment"/>
        <rdfs:comment>This class describe devices that transform a measured quantity into signals that can be presented at displays used in control or be recorded.</rdfs:comment>
        <rdfs:label xml:lang="en">Sensor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#Series -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Series">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#TimeSeries"/>
        <rdfs:comment>A set of similar physical or conceptual objects defined for the same period or point of time.</rdfs:comment>
        <rdfs:label xml:lang="en">Series</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SeriesCompensator -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SeriesCompensator">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#ConductingEquipment"/>
        <rdfs:comment>A Series Compensator is a series capacitor or reactor or an AC transmission line without charging susceptance.  It is a two terminal device.</rdfs:comment>
        <rdfs:label xml:lang="en">SeriesCompensator</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ServiceCategory -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ServiceCategory">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>Category of service provided to the customer.</rdfs:comment>
        <rdfs:label xml:lang="en">ServiceCategory</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ServiceGuarantee -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ServiceGuarantee">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Document"/>
        <rdfs:comment>A service guarantee often imposed by a regulator defines conditions that if not satisfied will result in the utility making a monetary payment to the customer. Note that guarantees identifier is in the name attribute and the status of the guarantee is in the Status.status attribute.Example service requirements include1 If power is not restored within 24 hours customers can claim 50 for residential customers or 100 for commercial and industrial customers. In addition for each extra period of 12 hours the customers supply has not been activated the customer can claim 25.2 If a customer has a question about their electricity bill the utility will investigate and respond to the inquiry within 15 working days. If utility fails to meet its guarantee utility will automatically pay the customer 50.</rdfs:comment>
        <rdfs:label xml:lang="en">ServiceGuarantee</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ServiceKind -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ServiceKind">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Kind of service.</rdfs:comment>
        <rdfs:label xml:lang="en">ServiceKind</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ServiceLocation -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ServiceLocation">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#WorkLocation"/>
        <rdfs:comment>A real estate location commonly referred to as premises.</rdfs:comment>
        <rdfs:label xml:lang="en">ServiceLocation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ServiceMultiplier -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ServiceMultiplier">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>Multiplier applied at the usage point.</rdfs:comment>
        <rdfs:label xml:lang="en">ServiceMultiplier</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ServiceMultiplierKind -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ServiceMultiplierKind">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Kind of service multiplier.</rdfs:comment>
        <rdfs:label xml:lang="en">ServiceMultiplierKind</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ServicePoint -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ServicePoint">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>The defined termination points of a transmission path. Service points are defined from the viewpoint of the transmission service. Each service point is contained within or on the boundary of an interchange area. A service point is source or destination of a transaction.</rdfs:comment>
        <rdfs:label xml:lang="en">ServicePoint</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ServicePointOutageSummary -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ServicePointOutageSummary">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Compound"/>
        <rdfs:comment>Summary counts of service points affected by an outage. These counts are sometimes referred to as total and critical customer count.</rdfs:comment>
        <rdfs:label xml:lang="en">ServicePointOutageSummary</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ServiceSupplier -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ServiceSupplier">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#OrganisationRole"/>
        <rdfs:comment>Organisation that provides services to customers.</rdfs:comment>
        <rdfs:label xml:lang="en">ServiceSupplier</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SetPoint -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SetPoint">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#AnalogControl"/>
        <rdfs:comment>An analog control that issues a set point value.</rdfs:comment>
        <rdfs:label xml:lang="en">SetPoint</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#Settlement -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Settlement">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Document"/>
        <rdfs:comment>Specifies a settlement run.</rdfs:comment>
        <rdfs:label xml:lang="en">Settlement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#Shift -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Shift">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>Generally referring to a period of operation or work performed. Whether the shift is openclosed can be derived from attributes activityInterval.start and activityInterval.end.The grand total for receipts i.e. cumulative total of all actual receipted amounts during this shift bankable  nonbankable excludes rounding error totals can be derived from receiptsumReceipt.receiptAmount includes bankable and nonbankable receipts.It also has to be reconciled againstsumreceiptsGrandTotalBankable  receiptsGrandTotalNonBankableand against receipt summarysumReceiptSummary.receiptsTotal.The attributes with GrandTotal defined in this class may need to be used when the source data is periodically flushed from the system and then these cannot be derived.</rdfs:comment>
        <rdfs:label xml:lang="en">Shift</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ShiftPattern -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ShiftPattern">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#WorkIdentifiedObject"/>
        <rdfs:comment>The patterns of shifts worked by people or crews.</rdfs:comment>
        <rdfs:label xml:lang="en">ShiftPattern</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ShortCircuitRotorKind -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ShortCircuitRotorKind">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Type of rotor used by short circuit applications.</rdfs:comment>
        <rdfs:label xml:lang="en">ShortCircuitRotorKind</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ShortCircuitTest -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ShortCircuitTest">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#TransformerTest"/>
        <rdfs:comment>Shortcircuit test results determine mesh impedance parameters. They include load losses and leakage impedances. For threephase windings the excitation can be a positive sequence the default or a zero sequence. There shall be at least one grounded winding.</rdfs:comment>
        <rdfs:label xml:lang="en">ShortCircuitTest</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ShuntCompensator -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ShuntCompensator">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#RegulatingCondEq"/>
        <rdfs:comment>A shunt capacitor or reactor or switchable bank of shunt capacitors or reactors. A section of a shunt compensator is an individual capacitor or reactor.  A negative value for reactivePerSection indicates that the compensator is a reactor. ShuntCompensator is a single terminal device.  Ground is implied.</rdfs:comment>
        <rdfs:label xml:lang="en">ShuntCompensator</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ShuntCompensatorAction -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ShuntCompensatorAction">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#SwitchingAction"/>
        <rdfs:label xml:lang="en">ShuntCompensatorAction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ShuntCompensatorControl -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ShuntCompensatorControl">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#RegulatingControl"/>
        <rdfs:comment>Distribution capacitor bank control settings.</rdfs:comment>
        <rdfs:label xml:lang="en">ShuntCompensatorControl</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ShuntCompensatorDynamicData -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ShuntCompensatorDynamicData">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Toplevel"/>
        <rdfs:comment>Optimal Power Flow or State Estimator Filter Bank Data for OTS. This is used for RealTime Study and Maintenance Users.</rdfs:comment>
        <rdfs:label xml:lang="en">ShuntCompensatorDynamicData</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ShuntCompensatorInfo -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ShuntCompensatorInfo">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#AssetInfo"/>
        <rdfs:comment>Properties of shunt capacitor shunt reactor or switchable bank of shunt capacitor or reactor assets.</rdfs:comment>
        <rdfs:label xml:lang="en">ShuntCompensatorInfo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ShuntCompensatorPhase -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ShuntCompensatorPhase">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#PowerSystemResource"/>
        <rdfs:comment>Single phase of a multiphase shunt compensator when its attributes might be different per phase.</rdfs:comment>
        <rdfs:label xml:lang="en">ShuntCompensatorPhase</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ShuntImpedanceControlKind -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ShuntImpedanceControlKind">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Kind of control for shunt impedance.</rdfs:comment>
        <rdfs:label xml:lang="en">ShuntImpedanceControlKind</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ShuntImpedanceLocalControlKind -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ShuntImpedanceLocalControlKind">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Kind of local control for shunt impedance.</rdfs:comment>
        <rdfs:label xml:lang="en">ShuntImpedanceLocalControlKind</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ShutdownCurve -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ShutdownCurve">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Curve"/>
        <rdfs:comment>Relationship between the rate in gross active powerminute Yaxis at which a unit should be shutdown and its present gross MW output Xaxis.</rdfs:comment>
        <rdfs:label xml:lang="en">ShutdownCurve</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SimpleEndDeviceFunction -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SimpleEndDeviceFunction">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#EndDeviceFunction"/>
        <rdfs:comment>Simple end device function distinguished by kind. Use this class for instances that cannot be represented by another end device function specialisations.</rdfs:comment>
        <rdfs:label xml:lang="en">SimpleEndDeviceFunction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SinglePhaseKind -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SinglePhaseKind">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Enumeration of single phase identifiers. Allows designation of single phases for both transmission and distribution equipment circuits and loads.</rdfs:comment>
        <rdfs:label xml:lang="en">SinglePhaseKind</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#Skill -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Skill">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Document"/>
        <rdfs:comment>Proficiency level of a craft which is required to operate or maintain a particular type of asset andor perform certain types of work. </rdfs:comment>
        <rdfs:label xml:lang="en">Skill</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SkillLevelKind -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SkillLevelKind">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Kind of skill level.</rdfs:comment>
        <rdfs:label xml:lang="en">SkillLevelKind</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SolarGeneratingUnit -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SolarGeneratingUnit">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#GeneratingUnit"/>
        <rdfs:comment>A solar thermal generating unit connected to the grid by means of a rotating machine.  This class does not represent photovoltaic PV generation.</rdfs:comment>
        <rdfs:label xml:lang="en">SolarGeneratingUnit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#Source -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Source">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Source gives information related to the origin of a value.</rdfs:comment>
        <rdfs:label xml:lang="en">Source</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SourceSinkFlag -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SourceSinkFlag">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:label xml:lang="en">SourceSinkFlag</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SourceSinkType -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SourceSinkType">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:label xml:lang="en">SourceSinkType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SpaceAnalog -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SpaceAnalog">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#EnvironmentalAnalog"/>
        <rdfs:comment>Analog float measuring a space extraterrestrial condition.</rdfs:comment>
        <rdfs:label xml:lang="en">SpaceAnalog</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SpaceAnalogKind -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SpaceAnalogKind">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Kinds of analogs floats measuring a space condition.</rdfs:comment>
        <rdfs:label xml:lang="en">SpaceAnalogKind</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SpacePhenomenon -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SpacePhenomenon">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#EnvironmentalPhenomenon"/>
        <rdfs:comment>An extraterrestrial phenomenon.</rdfs:comment>
        <rdfs:label xml:lang="en">SpacePhenomenon</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#Specification -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Specification">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Document"/>
        <rdfs:comment>Specification can be used for various purposes relative to an asset a logical device PowerSystemResource location etc. Examples include documents supplied by manufacturers such as asset installation instructions asset maintenance instructions etc.</rdfs:comment>
        <rdfs:label xml:lang="en">Specification</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#Specimen -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Specimen">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>Sample or specimen of a material fluid or solid.</rdfs:comment>
        <rdfs:label xml:lang="en">Specimen</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#Speed -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Speed">
