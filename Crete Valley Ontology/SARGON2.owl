        <rdfs:comment>Group of people with specific skills tools and vehicles.</rdfs:comment>
        <rdfs:label xml:lang="en">Crew</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#CrewMember -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CrewMember">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#OperationPersonRole"/>
        <rdfs:comment>Member of a crew.</rdfs:comment>
        <rdfs:label xml:lang="en">CrewMember</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#CrewStatusKind -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CrewStatusKind">
