    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Series.lastUpdateDate -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Series.lastUpdateDate">
