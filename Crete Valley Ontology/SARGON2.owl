    <!-- http://www.iec.ch/TC57/CIM#LaborelecStandardKind -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#LaborelecStandardKind">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
