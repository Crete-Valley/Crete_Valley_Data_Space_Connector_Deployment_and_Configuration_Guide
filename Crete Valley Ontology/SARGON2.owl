        <rdfs:label>ClientEnd</rdfs:label>
        <rdfs:label xml:lang="en">From_SC</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Trade.To_SC -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#Trade.To_SC">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Trade"/>
