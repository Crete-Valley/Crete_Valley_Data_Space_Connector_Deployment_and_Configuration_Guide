    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#InterTieResults -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#InterTieResults">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Toplevel"/>
