        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Agreement"/>
        <rdfs:comment>A formal controlling contractual agreement between supplier and merchant in terms of which the merchant is authorised to vend tokens and receipt payments on behalf of the supplier. The merchant is accountable to the supplier for revenue collected at point of sale.</rdfs:comment>
        <rdfs:label xml:lang="en">MerchantAgreement</rdfs:label>
    </owl:Class>
    


