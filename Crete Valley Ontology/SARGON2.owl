        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Capacity Benefit Margin CBM is used by Markets to calculate the transmission interface limits. This number could be manually or procedurally determined. The CBM is defined per transmission interface branch group.</rdfs:comment>
        <rdfs:label xml:lang="en">capacityBenefitMargin</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TransmissionCapacity.operationalTransmissionCapacity -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#TransmissionCapacity.operationalTransmissionCapacity">
