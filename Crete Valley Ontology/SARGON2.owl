        <rdfs:label xml:lang="en">Craft</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#Crew -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Crew">
