        <rdfs:label xml:lang="en">blockLoadTransfer</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredLoad.dynamicallyScheduledLoadResource -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredLoad.dynamicallyScheduledLoadResource">
