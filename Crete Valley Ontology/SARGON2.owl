    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TopologicalIsland.AngleRefTopologicalNode -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TopologicalIsland.AngleRefTopologicalNode">
        <owl:inverseOf rdf:resource="http://www.iec.ch/TC57/CIM#TopologicalNode.AngleRefTopologicalIsland"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TopologicalIsland"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#TopologicalNode"/>
        <rdfs:comment>The angle reference for the island.   Normally there is one TopologicalNode that is selected as the angle reference for each island.   Other reference schemes exist so the association is typically optional.</rdfs:comment>
        <rdfs:label xml:lang="en">AngleRefTopologicalNode</rdfs:label>
        <rdfs:label>SupplierEnd</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TopologicalIsland.TopologicalNodes -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TopologicalIsland.TopologicalNodes">
