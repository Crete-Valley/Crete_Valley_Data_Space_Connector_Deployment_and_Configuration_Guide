    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#PanDisplay -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#PanDisplay">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#EndDeviceAction"/>
        <rdfs:comment>PAN actioncommand used to issue the displaying of text messages on PAN devices.</rdfs:comment>
