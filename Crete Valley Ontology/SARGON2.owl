    <!-- http://www.iec.ch/TC57/CIM#SurgeArresterInfo.continuousOperatingVoltage -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#SurgeArresterInfo.continuousOperatingVoltage">
