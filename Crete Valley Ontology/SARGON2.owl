        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#PerCent"/>
        <rdfs:comment>Governor Speed Changer Droop.   This is the change in generator power output divided by the change in frequency normalized by the nominal power of the generator and the nominal frequency and expressed in percent and negated. A positive value of speed change droop provides additional generator output upon a drop in frequency.</rdfs:comment>
        <rdfs:label xml:lang="en">governorSCD</rdfs:label>
    </owl:ObjectProperty>
    


