        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Seconds"/>
        <rdfs:comment>Time step frequency calculation ideltatfi gt 0.  Typical value  0025 003 for 50 Hz.</rdfs:comment>
        <rdfs:comment>Time step frequency calculation ideltatfi gt 0.  Typical value  0025.</rdfs:comment>
        <rdfs:label xml:lang="en">dtf</rdfs:label>
    </owl:ObjectProperty>
    


