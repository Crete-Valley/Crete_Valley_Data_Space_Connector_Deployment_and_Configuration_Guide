        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Resistance"/>
        <rdfs:comment>Positive sequence series resistance of the reduced branch.</rdfs:comment>
        <rdfs:label xml:lang="en">r</rdfs:label>
