        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Overexcitation Flag iOVEXitrue  overexcitedfalse  underexcited.</rdfs:comment>
        <rdfs:label xml:lang="en">ovex</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PFVArType1IEEEPFController.vpfcbw -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PFVArType1IEEEPFController.vpfcbw">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PFVArType1IEEEPFController"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>PF controller deadband iViisubPFCBWsubi.  Typical value  005.</rdfs:comment>
        <rdfs:label xml:lang="en">vpfcbw</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PFVArType1IEEEVArController.vvarcbw -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PFVArType1IEEEVArController.vvarcbw">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PFVArType1IEEEVArController"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Var controller deadband iViisubVARCBWsubi.  Typical value  002.</rdfs:comment>
        <rdfs:label xml:lang="en">vvarcbw</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PFVArType2Common1.j -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PFVArType2Common1.j">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PFVArType2Common1"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Selector iJi.true  control mode for reactive powerfalse  control mode for power factor.</rdfs:comment>
        <rdfs:label xml:lang="en">j</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#POD -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#POD">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TransmissionCapacity"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TransmissionInterfaceRightEntitlement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>point of delivery</rdfs:comment>
        <rdfs:label xml:lang="en">POD</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#POR -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#POR">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TransmissionCapacity"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TransmissionInterfaceRightEntitlement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
