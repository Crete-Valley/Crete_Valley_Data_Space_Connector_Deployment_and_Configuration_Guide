        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#AuxiliaryAccount"/>
        <rdfs:comment>All auxiliary accounts regulated by this agreement.</rdfs:comment>
        <rdfs:label xml:lang="en">AuxiliaryAccounts</rdfs:label>
        <rdfs:label>SupplierEnd</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#AuxiliaryAgreement.CustomerAgreement -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#AuxiliaryAgreement.CustomerAgreement">
        <owl:inverseOf rdf:resource="http://www.iec.ch/TC57/CIM#CustomerAgreement.AuxiliaryAgreements"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#AuxiliaryAgreement"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#CustomerAgreement"/>
        <rdfs:comment>Customer agreement this nonservice related auxiliary agreement refers to.</rdfs:comment>
        <rdfs:label>ClientEnd</rdfs:label>
        <rdfs:label xml:lang="en">CustomerAgreement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#AuxiliaryAgreement.arrearsInterest -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#AuxiliaryAgreement.arrearsInterest">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#AuxiliaryAgreement"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#PerCent"/>
        <rdfs:comment>The interest per annum to be charged prorata on AuxiliaryAccount.dueArrears at the end of each payCycle.</rdfs:comment>
        <rdfs:label xml:lang="en">arrearsInterest</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#AuxiliaryAgreement.fixedAmount -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#AuxiliaryAgreement.fixedAmount">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#AuxiliaryAgreement"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Money"/>
        <rdfs:comment>The fixed amount that has to be collected from each vending transaction towards settlement of this auxiliary agreement. Note that there may be multiple tokens vended per vending transaction but this is not relevant.</rdfs:comment>
        <rdfs:label xml:lang="en">fixedAmount</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#AuxiliaryAgreement.minAmount -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#AuxiliaryAgreement.minAmount">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#AuxiliaryAgreement"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Money"/>
        <rdfs:comment>The minimum amount that has to be paid at any transaction towards settling this auxiliary agreement or reducing the balance.</rdfs:comment>
        <rdfs:label xml:lang="en">minAmount</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#AuxiliaryAgreement.vendPortion -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#AuxiliaryAgreement.vendPortion">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#AuxiliaryAgreement"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#PerCent"/>
        <rdfs:comment>The percentage of the transaction amount that has to be collected from each vending transaction towards settlement of this auxiliary agreement when payments are not in arrears. Note that there may be multiple tokens vended per vending transaction but this is not relevant.</rdfs:comment>
        <rdfs:label xml:lang="en">vendPortion</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#AuxiliaryAgreement.vendPortionArrear -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#AuxiliaryAgreement.vendPortionArrear">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#AuxiliaryAgreement"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#PerCent"/>
        <rdfs:comment>The percentage of the transaction amount that has to be collected from each vending transaction towards settlement of this auxiliary agreement when payments are in arrears. Note that there may be multiple tokens vended per vending transaction but this is not relevant.</rdfs:comment>
        <rdfs:label xml:lang="en">vendPortionArrear</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#AuxiliaryEquipment.Terminal -->

