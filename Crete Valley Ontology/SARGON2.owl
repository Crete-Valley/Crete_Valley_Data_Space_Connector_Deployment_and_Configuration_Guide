        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Tells if the limit values are in percentage of normalValue or the specified Unit for Measurements and Controls.</rdfs:comment>
        <rdfs:label xml:lang="en">isPercentageLimits</rdfs:label>
    </owl:DatatypeProperty>
    


