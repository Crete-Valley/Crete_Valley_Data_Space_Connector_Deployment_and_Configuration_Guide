    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#DispatchSchedule.startTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#DispatchSchedule.startTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#DispatchSchedule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The start time of the first interval in the dispatch schedule</rdfs:comment>
        <rdfs:label xml:lang="en">startTime</rdfs:label>
    </owl:DatatypeProperty>
    


