    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CCAinverter">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Toplevel"/>
        <rdfs:label xml:lang="en">CCAinverter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#CCArectifierControl -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CCArectifierControl">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Toplevel"/>
        <rdfs:label xml:lang="en">CCArectifierControl</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#CIGREStandard -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CIGREStandard">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Compound"/>
        <rdfs:comment>Standard published by CIGRE Council on Large Electric Systems.</rdfs:comment>
        <rdfs:label xml:lang="en">CIGREStandard</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#CIGREStandardEditionKind -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CIGREStandardEditionKind">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>List of editions for CIGRE standards.</rdfs:comment>
        <rdfs:label xml:lang="en">CIGREStandardEditionKind</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#CIGREStandardKind -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CIGREStandardKind">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>List of CIGRE standards.</rdfs:comment>
        <rdfs:label xml:lang="en">CIGREStandardKind</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#CIMDatatype -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CIMDatatype">
        <owl:equivalentClass rdf:resource="https://w3id.org/saref#Property"/>
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Datatype"/>
        <rdfs:comment>CIm data type</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#CRRCategoryType -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CRRCategoryType">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Congestion Revenue Rights category types.</rdfs:comment>
        <rdfs:label xml:lang="en">CRRCategoryType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#CRRHedgeType -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CRRHedgeType">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Congestion Revenue Right hedge type.</rdfs:comment>
        <rdfs:label xml:lang="en">CRRHedgeType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#CRRMarket -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CRRMarket">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Market"/>
        <rdfs:comment>Model that describes the Congestion Revenue Rights Auction Market.</rdfs:comment>
        <rdfs:label xml:lang="en">CRRMarket</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#CRROrgRole -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CRROrgRole">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#OrganisationRole"/>
        <rdfs:comment>Identifies a way in which an organisation may participate with a defined Congestion Revenue Right CRR.</rdfs:comment>
        <rdfs:label xml:lang="en">CRROrgRole</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#CRRRoleType -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CRRRoleType">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Role types an organisation can play with respect to a congestion revenue right.</rdfs:comment>
        <rdfs:label xml:lang="en">CRRRoleType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#CRRSegment -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CRRSegment">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>CRRSegment represents a segment of a CRR in a particular time frame. The segment class contains amount clearing price start date and time end date and time.</rdfs:comment>
        <rdfs:label xml:lang="en">CRRSegment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#CRRSegmentType -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CRRSegmentType">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Type of the CRR from the possible type definitions in the CRR System e.g. LSE ETC.</rdfs:comment>
        <rdfs:label xml:lang="en">CRRSegmentType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#CSCDynamics -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CSCDynamics">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#HVDCDynamics"/>
