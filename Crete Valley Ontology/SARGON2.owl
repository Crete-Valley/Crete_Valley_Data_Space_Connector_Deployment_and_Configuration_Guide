    <!-- http://www.iec.ch/TC57/CIM#PackageDependenciesCIMVersion.date -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PackageDependenciesCIMVersion.date">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PackageDependenciesCIMVersion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date of last change to the main package dependencies in format YYYYMMDD.   This is updated when the version attribute is updated.</rdfs:comment>
        <rdfs:label xml:lang="en">date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PackageDependenciesCIMVersion.version -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PackageDependenciesCIMVersion.version">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PackageDependenciesCIMVersion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The version of the main subpackages of the combined CIM model.  The format is simply an integer.  The version and date initial values should be updated any time the dependencies in the model change and require an actual change to the diagrams within this package.</rdfs:comment>
        <rdfs:label xml:lang="en">version</rdfs:label>
    </owl:DatatypeProperty>
    


