        <rdfs:label xml:lang="en">SubGeographicalRegion</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#SubLoadArea -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#SubLoadArea">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#EnergyArea"/>
