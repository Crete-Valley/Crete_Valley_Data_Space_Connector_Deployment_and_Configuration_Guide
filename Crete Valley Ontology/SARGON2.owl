        <rdfs:comment>Bill period start date</rdfs:comment>
        <rdfs:label xml:lang="en">billStart</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PassThroughBill.billedTo -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PassThroughBill.billedTo">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PassThroughBill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The company to which the PTB transaction is billed.</rdfs:comment>
