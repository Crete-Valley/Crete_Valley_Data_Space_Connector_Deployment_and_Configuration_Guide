        <rdfs:label xml:lang="en">ClearanceDocument</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#CloudCondition -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CloudCondition">
