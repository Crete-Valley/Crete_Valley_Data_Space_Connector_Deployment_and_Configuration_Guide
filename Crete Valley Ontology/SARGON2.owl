        <rdfs:label xml:lang="en">CurrentFlow</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#CurrentLimit -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CurrentLimit">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#OperationalLimit"/>
        <rdfs:comment>Operational limit on current. </rdfs:comment>
        <rdfs:label xml:lang="en">CurrentLimit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#CurrentRelay -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CurrentRelay">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#ProtectionEquipment"/>
        <rdfs:comment>A device that checks current flow values in any direction or designated direction.</rdfs:comment>
        <rdfs:label xml:lang="en">CurrentRelay</rdfs:label>
