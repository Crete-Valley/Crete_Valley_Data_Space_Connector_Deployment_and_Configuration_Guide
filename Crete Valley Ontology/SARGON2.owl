    <!-- http://www.iec.ch/TC57/CIM#ResourcePerformanceTimeSeriesFactor.timeSeriesDescription -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ResourcePerformanceTimeSeriesFactor.timeSeriesDescription">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ResourcePerformanceTimeSeriesFactor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Optional description of the time series data e.g. baseline data meter read data computed performance data.</rdfs:comment>
        <rdfs:label xml:lang="en">timeSeriesDescription</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ResourcePerformanceTimeSeriesFactor.value1Description -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ResourcePerformanceTimeSeriesFactor.value1Description">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ResourcePerformanceTimeSeriesFactor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Description for the value1 contained within the TimeSeriesFactor.</rdfs:comment>
        <rdfs:label xml:lang="en">value1Description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ResourcePerformanceTimeSeriesFactor.value2Description -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ResourcePerformanceTimeSeriesFactor.value2Description">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ResourcePerformanceTimeSeriesFactor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Description for the value2 contained within the TimeSeriesFactor.</rdfs:comment>
        <rdfs:label xml:lang="en">value2Description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ResourceStartupCost.fuelColdStartup -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ResourceStartupCost.fuelColdStartup">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ResourceStartupCost"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Verifiable Cold Start Up Fuel MMBtu per start</rdfs:comment>
        <rdfs:label xml:lang="en">fuelColdStartup</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ResourceStartupCost.fuelHotStartup -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ResourceStartupCost.fuelHotStartup">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ResourceStartupCost"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Verifiable Hot Start Up Fuel MMBtu per start</rdfs:comment>
        <rdfs:label xml:lang="en">fuelHotStartup</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ResourceStartupCost.fuelIntermediateStartup -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ResourceStartupCost.fuelIntermediateStartup">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ResourceStartupCost"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Verifiable Intermediate Start Up Fuel MMBtu per start</rdfs:comment>
        <rdfs:label xml:lang="en">fuelIntermediateStartup</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ResourceStartupCost.fuelLowSustainedLimit -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ResourceStartupCost.fuelLowSustainedLimit">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ResourceStartupCost"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>MinimumEnergy fuel MMBtuMWh</rdfs:comment>
        <rdfs:label xml:lang="en">fuelLowSustainedLimit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ResponseMethod.activePower -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ResponseMethod.activePower">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ResponseMethod"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The active power value for the demand adjustment type. This supports requests to be made to a resource for some amount of active power provided by a particular response method as specified by the method attribute e.g. lighting HVAC wall mounted air conditioners etc..</rdfs:comment>
        <rdfs:label xml:lang="en">activePower</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ResponseMethod.activePowerUOM -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ResponseMethod.activePowerUOM">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ResponseMethod"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The unit of measure of active power e.g. kiloWatts kW megaWatts mW etc.</rdfs:comment>
        <rdfs:label xml:lang="en">activePowerUOM</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ResponseMethod.method -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ResponseMethod.method">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ResponseMethod"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The response method e.g. lighting HVAC wall mounted air conditioners etc..</rdfs:comment>
        <rdfs:label xml:lang="en">method</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ResponseMethod.siteMultiplier -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ResponseMethod.siteMultiplier">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ResponseMethod"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>This value provides for scaling of a response methods active power. For example a response method of air conditioning could utilize a small amount of active power from each air conditioning unit e.g. 0.1 kiloWatt but the site multiplier could be used to produce a the total active power adjustment by multiplying the response method active power by this value e.g. a building with 100 window air conditioning  units so 100  0.1 kW  10 kW.</rdfs:comment>
        <rdfs:label xml:lang="en">siteMultiplier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RotatingMachine.ratedPowerFactor -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RotatingMachine.ratedPowerFactor">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RotatingMachine"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Power factor nameplate data. It is primarily used for short circuit data exchange according to IEC 60909. The attribute cannot be a negative value.</rdfs:comment>
        <rdfs:label xml:lang="en">ratedPowerFactor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RotatingMachineDynamics.damping -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RotatingMachineDynamics.damping">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RotatingMachineDynamics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Damping torque coefficient iDi gt 0.  A proportionality constant that when multiplied by the angular velocity of the rotor poles with respect to the magnetic field frequency results in the damping torque.  This value is often zero when the sources of damping torques generator damper windings load damping effects etc. are modelled in detail.  Typical value  0.</rdfs:comment>
        <rdfs:label xml:lang="en">damping</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RotatingMachineDynamics.saturationFactor -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RotatingMachineDynamics.saturationFactor">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RotatingMachineDynamics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Saturation factor at rated terminal voltage iS1i gt 0.  Not used by simplified model.  Defined by defined by iSiiE1i in the SynchronousMachineSaturationParameters diagram.  Typical value  002.</rdfs:comment>
        <rdfs:label xml:lang="en">saturationFactor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RotatingMachineDynamics.saturationFactor120 -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RotatingMachineDynamics.saturationFactor120">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RotatingMachineDynamics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Saturation factor at 120 of rated terminal voltage iS12i gt RotatingMachineDynamics.saturationFactor. Not used by the simplified model defined by iSiiE2i in the SynchronousMachineSaturationParameters diagram.  Typical value  012.</rdfs:comment>
        <rdfs:label xml:lang="en">saturationFactor120</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SCADAInformation.timeStamp -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#SCADAInformation.timeStamp">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#SCADAInformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>time of the update from SCADA</rdfs:comment>
        <rdfs:label xml:lang="en">timeStamp</rdfs:label>
    </owl:DatatypeProperty>
    


