        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Instructions"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Binding dispatch operating delta provides a relative delta to be applied. Typically used in demand response instructions. The bindingfont color0f0f0fDOD instructions are cumulative in other words a second DOD instruction does not replace the previous DOD instead the second DOD adds to the previous DODs.font</rdfs:comment>
        <rdfs:label xml:lang="en">bindingDOD</rdfs:label>
    </owl:DatatypeProperty>
    


