        <rdfs:label xml:lang="en">Channels</rdfs:label>
        <rdfs:label>SupplierEnd</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Register.EndDeviceFunction -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#Register.EndDeviceFunction">
