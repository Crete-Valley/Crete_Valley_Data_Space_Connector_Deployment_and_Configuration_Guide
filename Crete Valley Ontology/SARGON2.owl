        <rdfs:label xml:lang="en">lastUpdateDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Series.methodType -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Series.methodType">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Series"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
