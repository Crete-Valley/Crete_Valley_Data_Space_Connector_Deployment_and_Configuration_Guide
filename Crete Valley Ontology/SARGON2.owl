        <owl:inverseOf rdf:resource="http://www.iec.ch/TC57/CIM#MitigatedBid_merged"/>
        <owl:inverseOf rdf:resource="http://www.iec.ch/TC57/CIM#RMRDetermination_merged"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ActionRequest"/>
