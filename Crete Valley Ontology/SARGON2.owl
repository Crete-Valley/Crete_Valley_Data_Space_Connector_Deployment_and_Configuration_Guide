        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#BidMitigationStatus"/>
        <rdfs:comment>Mitigation StatusS  Mitigated by SMPM because of misconductL  Mitigated by LMPM because of misconductR  Modified by LMPM because of RMR rulesM  Mitigated because of misconduct both by SMPM and LMPMB  Mitigated because of misconduct both by SMPM and modified by LMLM because of RMR rulesO  original</rdfs:comment>
        <rdfs:label xml:lang="en">mitigationStatus</rdfs:label>
    </owl:ObjectProperty>
    


