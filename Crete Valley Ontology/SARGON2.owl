<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/stu/ontologies/2024/9/sargon2#"
     xml:base="http://www.semanticweb.org/stu/ontologies/2024/9/sargon2"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:webprotege="http://webprotege.stanford.edu/">
    <owl:Ontology rdf:about="http://www.semanticweb.org/stu/ontologies/2024/9/sargon2">
        <dcterms:description>SARGON2 ontology represents the energy domain including building and non-energy domain including weather and serve as the extension of other ontologies for the digital services in the energy sector, and enable the seamless semantic integration of energy assets in Renewable Energy Valleys. This ontology also fouces on the renewable energy resources including biomass, biogas, wind, solar, geothermal, and hydrogen entities. The main focus of this ontology is to cover the necessary components in the power systems by aligning with IEC61970CIM standard.</dcterms:description>
        <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-03-25</dcterms:issued>
        <dcterms:license>https://creativecommons.org/licenses/by/4.0/</dcterms:license>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/contributor -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/issued -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/publisher -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/source -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://webprotege.stanford.edu/R9KdTRIHz9usCNpX2dg4K1f -->

    <owl:AnnotationProperty rdf:about="http://webprotege.stanford.edu/R9KdTRIHz9usCNpX2dg4K1f">
        <rdfs:label>Owner</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#flow -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#flow">
        <rdfs:label>rdfs:flow</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#duration -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#duration"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#gMonthDay -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gMonthDay"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#time -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#time"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://energy.linkeddata.es/em-kpi/ontology#experiences -->

    <owl:ObjectProperty rdf:about="http://energy.linkeddata.es/em-kpi/ontology#experiences">
        <rdfs:range rdf:resource="https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/gbBuildingOntology.owl#Weather"/>
    </owl:ObjectProperty>
    


    <!-- http://energy.linkeddata.es/em-kpi/ontology#hasForecast -->

    <owl:ObjectProperty rdf:about="http://energy.linkeddata.es/em-kpi/ontology#hasForecast">
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://energy.linkeddata.es/em-kpi/ontology#EnergyForecast"/>
                    <rdf:Description rdf:about="http://energy.linkeddata.es/em-kpi/ontology#WeatherForecast"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://webprotege.stanford.edu/R9WFufxotu4KAAzKLx4qc2U -->

    <owl:ObjectProperty rdf:about="http://webprotege.stanford.edu/R9WFufxotu4KAAzKLx4qc2U">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>has channel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverter.DCTerminals -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverter.DCTerminals">
        <owl:inverseOf rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverterDCTerminal.DCConductingEquipment"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverterDCTerminal"/>
        <rdfs:comment>A DC converter have DC converter terminals. A converter has two DC converter terminals.</rdfs:comment>
        <rdfs:label>ClientEnd</rdfs:label>
        <rdfs:label xml:lang="en">DCTerminals</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverter.PccTerminal -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverter.PccTerminal">
        <owl:inverseOf rdf:resource="http://www.iec.ch/TC57/CIM#Terminal.ConverterDCSides"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Terminal"/>
        <rdfs:comment>Point of common coupling terminal for this converter DC side. It is typically the terminal on the power transformer or switch closest to the AC network.</rdfs:comment>
        <rdfs:label xml:lang="en">PccTerminal</rdfs:label>
        <rdfs:label>SupplierEnd</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverter.baseS -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverter.baseS">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ApparentPower"/>
        <rdfs:comment>Base apparent power of the converter pole. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">baseS</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverter.idc -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverter.idc">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#CurrentFlow"/>
        <rdfs:comment>Converter DC current also called Id. It is converters state variable result from power flow.</rdfs:comment>
        <rdfs:label xml:lang="en">idc</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverter.idleLoss -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverter.idleLoss">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ActivePower"/>
        <rdfs:comment>Active power loss in pole at no power transfer. It is converters configuration data used in power flow. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">idleLoss</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverter.maxP -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverter.maxP">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ActivePower"/>
        <rdfs:comment>Maximum active power limit. The value is overwritten by values of VsCapabilityCurve if present.</rdfs:comment>
        <rdfs:label xml:lang="en">maxP</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverter.maxUdc -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverter.maxUdc">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Voltage"/>
        <rdfs:comment>The maximum voltage on the DC side at which the converter should operate. It is converters configuration data used in power flow. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">maxUdc</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverter.minP -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverter.minP">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ActivePower"/>
        <rdfs:comment>Minimum active power limit. The value is overwritten by values of VsCapabilityCurve if present.</rdfs:comment>
        <rdfs:label xml:lang="en">minP</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverter.minUdc -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverter.minUdc">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Voltage"/>
        <rdfs:comment>The minimum voltage on the DC side at which the converter should operate. It is converters configuration data used in power flow. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">minUdc</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverter.p -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverter.p">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ActivePower"/>
        <rdfs:comment>Active power at the point of common coupling. Load sign convention is used i.e. positive sign means flow out from a node.Starting value for a steady state solution in the case a simplified power flow model is used.</rdfs:comment>
        <rdfs:label xml:lang="en">p</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverter.poleLossP -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverter.poleLossP">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ActivePower"/>
        <rdfs:comment>The active power loss at a DC Pole  idleLoss  switchingLossIdc  resitiveLossIdc2.For lossless operation PdcPac.For rectifier operation with losses PdcPaclossP.For inverter operation with losses PdcPaclossP.It is converters state variable used in power flow. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">poleLossP</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverter.q -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverter.q">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ReactivePower"/>
        <rdfs:comment>Reactive power at the point of common coupling. Load sign convention is used i.e. positive sign means flow out from a node.Starting value for a steady state solution in the case a simplified power flow model is used.</rdfs:comment>
        <rdfs:label xml:lang="en">q</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverter.ratedUdc -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverter.ratedUdc">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Voltage"/>
        <rdfs:comment>Rated converter DC voltage also called UdN. The attribute shall be a positive value. It is converters configuration data used in power flow. For instance a bipolar HVDC link with value  200 kV has a 400kV difference between the dc lines.</rdfs:comment>
        <rdfs:label xml:lang="en">ratedUdc</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverter.resistiveLoss -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverter.resistiveLoss">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Resistance"/>
        <rdfs:comment>It is converters configuration data used in power flow. Refer to poleLossP. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">resistiveLoss</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverter.switchingLoss -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverter.switchingLoss">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ActivePowerPerCurrentFlow"/>
        <rdfs:comment>Switching losses relative to the base apparent power baseS. Refer to poleLossP. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">switchingLoss</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverter.targetPpcc -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverter.targetPpcc">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ActivePower"/>
        <rdfs:comment>Real power injection target in AC grid at point of common coupling.  Load sign convention is used i.e. positive sign means flow out from a node.</rdfs:comment>
        <rdfs:label xml:lang="en">targetPpcc</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverter.targetUdc -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverter.targetUdc">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Voltage"/>
        <rdfs:comment>Target value for DC voltage magnitude. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">targetUdc</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverter.uc -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverter.uc">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Voltage"/>
        <rdfs:comment>Linetoline converter voltage the voltage at the AC side of the valve. It is converters state variable result from power flow. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">uc</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverter.udc -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverter.udc">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Voltage"/>
        <rdfs:comment>Converter voltage at the DC side also called Ud. It is converters state variable result from power flow. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">udc</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverter.valveU0 -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverter.valveU0">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Voltage"/>
        <rdfs:comment>Valve threshold voltage also called Uvalve. Forward voltage drop when the valve is conducting. Used in loss calculations i.e. the switchLoss depend on numberOfValves  valveU0.</rdfs:comment>
        <rdfs:label xml:lang="en">valveU0</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverterDCTerminal.DCConductingEquipment -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverterDCTerminal.DCConductingEquipment">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverterDCTerminal"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverter"/>
        <rdfs:comment>A DC converter terminal belong to an DC converter.</rdfs:comment>
        <rdfs:label xml:lang="en">DCConductingEquipment</rdfs:label>
        <rdfs:label>SupplierEnd</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCConverterDCTerminal.polarity -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCConverterDCTerminal.polarity">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCConverterDCTerminal"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#DCPolarityKind"/>
        <rdfs:comment>Represents the normal network polarity condition. Depending on the converter configuration the value shall be set as follows For a monopole with two converter terminals use DCPolarityKind positive and negative. For a bipole or symmetric monopole with three converter terminals use DCPolarityKind positive middle and negative.</rdfs:comment>
        <rdfs:label xml:lang="en">polarity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCTerminal.BusNameMarker -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCTerminal.BusNameMarker">
        <owl:inverseOf rdf:resource="http://www.iec.ch/TC57/CIM#BusNameMarker.Terminal"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCTerminal"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#BusNameMarker"/>
        <rdfs:comment>The bus name marker used to name the bus topological node.</rdfs:comment>
        <rdfs:label xml:lang="en">BusNameMarker</rdfs:label>
        <rdfs:label>ClientEnd</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCTerminal.Measurements -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCTerminal.Measurements">
        <owl:inverseOf rdf:resource="http://www.iec.ch/TC57/CIM#Measurement.Terminal"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCTerminal"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Measurement"/>
        <rdfs:comment>Measurements associated with this terminal defining  where the measurement is placed in the network topology.  It may be used for instance to capture the sensor position such as a voltage transformer PT at a busbar or a current transformer CT at the bar between a breaker and an isolator.</rdfs:comment>
        <rdfs:label>ClientEnd</rdfs:label>
        <rdfs:label xml:lang="en">Measurements</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACDCTerminal.OperationalLimitSet -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACDCTerminal.OperationalLimitSet">
        <owl:inverseOf rdf:resource="http://www.iec.ch/TC57/CIM#OperationalLimitSet.Terminal"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACDCTerminal"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#OperationalLimitSet"/>
        <rdfs:comment>The operational limit sets at the terminal.</rdfs:comment>
        <rdfs:label>ClientEnd</rdfs:label>
        <rdfs:label xml:lang="en">OperationalLimitSet</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACLineSegment.ACLineSegmentPhases -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACLineSegment.ACLineSegmentPhases">
        <owl:inverseOf rdf:resource="http://www.iec.ch/TC57/CIM#ACLineSegment_merged"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACLineSegment"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ACLineSegmentPhase"/>
        <rdfs:comment>The line segment phases which belong to the line segment.</rdfs:comment>
        <rdfs:label xml:lang="en">ACLineSegmentPhases</rdfs:label>
        <rdfs:label>ClientEnd</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACLineSegment.Clamp -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACLineSegment.Clamp">
        <owl:inverseOf rdf:resource="http://www.iec.ch/TC57/CIM#ACLineSegment_merged"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACLineSegment"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Clamp"/>
        <rdfs:comment>The clamps connected to the line segment.</rdfs:comment>
        <rdfs:label xml:lang="en">Clamp</rdfs:label>
        <rdfs:label>SupplierEnd</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACLineSegment.Cut -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#ACLineSegment.Cut">
        <owl:inverseOf rdf:resource="http://www.iec.ch/TC57/CIM#ACLineSegment_merged"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ACLineSegment"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Cut"/>
        <rdfs:comment>Cuts applied to the line segment.</rdfs:comment>
        <rdfs:label>ClientEnd</rdfs:label>
        <rdfs:label xml:lang="en">Cut</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ACLineSegment.LineFaults -->

