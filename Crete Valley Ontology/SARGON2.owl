        <rdfs:comment>This model is an exponential representation of the load. Exponential equations for active and reactive power are used and the following attributes are requiredkp1 kp2 kp3 kpf ep1 ep2 ep3kq1 kq2 kq3 kqf eq1 eq2 eq3.</rdfs:comment>
        <rdfs:label xml:lang="en">exponential</rdfs:label>
    </owl:NamedIndividual>
    


