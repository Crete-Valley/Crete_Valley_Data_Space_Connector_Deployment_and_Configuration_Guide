        <rdfs:label xml:lang="en">dispatchable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredResource.lastModified -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredResource.lastModified">
