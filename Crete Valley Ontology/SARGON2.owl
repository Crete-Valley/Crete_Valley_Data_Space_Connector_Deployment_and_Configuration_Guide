        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#InUseDate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date of most recent asset transition to ready for use state.</rdfs:comment>
        <rdfs:label xml:lang="en">readyForUseDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Incident.cause -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Incident.cause">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Cause of this incident.</rdfs:comment>
