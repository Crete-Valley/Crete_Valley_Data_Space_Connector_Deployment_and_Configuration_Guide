        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TransmissionProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Type of the transmission product. This could be a transmission service class firm total transmission capability or nonfirm transmission service period onpeak fullperiod offpeak transmission service increments yearly extended hourly fixed monthly sliding etc. transmission service type network available transmission capability or pointtopoint or a transmission service window fixed hourly sliding weekly extended monthly etc..</rdfs:comment>
        <rdfs:label xml:lang="en">transmissionProductType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TropicalCycloneAustralia.category -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#TropicalCycloneAustralia.category">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TropicalCycloneAustralia"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Strength of tropical cyclone during the time interval based on Australian Bureau of Meteorology Category System where1  tropical cyclone with typical gusts over flat land 90125 kmh2  tropical cyclone with typical gusts over flat land 125164 kmh3  severe tropical cyclone with typical gusts over flat land 165224 kmh4  severe tropical cyclone with typical gusts over flat land 225279 kmh5  severe tropical cyclone with typical gusts over flat land greater  than 280 kmh.</rdfs:comment>
        <rdfs:label xml:lang="en">category</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TroubleTicket.comment -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#TroubleTicket.comment">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TroubleTicket"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Freeform comment associated with the trouble call for example customer reported a large flash etc.</rdfs:comment>
        <rdfs:label xml:lang="en">comment</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TroubleTicket.dateTimeOfReport -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#TroubleTicket.dateTimeOfReport">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TroubleTicket"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Date and time the trouble has been reported.</rdfs:comment>
        <rdfs:label xml:lang="en">dateTimeOfReport</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TroubleTicket.firstResponderStatus -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#TroubleTicket.firstResponderStatus">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TroubleTicket"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indicates whether the first responder such as police fire department etc.has been notified and whether they are on site or en route.</rdfs:comment>
        <rdfs:label xml:lang="en">firstResponderStatus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TroubleTicket.multiplePremises -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#TroubleTicket.multiplePremises">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TroubleTicket"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Set to true if the outage report indicated that other neighbors are also out of power.</rdfs:comment>
        <rdfs:label xml:lang="en">multiplePremises</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TroubleTicket.resolvedDateTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#TroubleTicket.resolvedDateTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TroubleTicket"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Date and time this trouble ticket has been resolved.</rdfs:comment>
        <rdfs:label xml:lang="en">resolvedDateTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TroubleTicket.troubleCode -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#TroubleTicket.troubleCode">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TroubleTicket"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Trouble code e.g. power down flickering lights partial power etc.</rdfs:comment>
        <rdfs:label xml:lang="en">troubleCode</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Tsunami.intensity -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Tsunami.intensity">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Tsunami"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Tsunami intensity on the PapadopoulosImamura tsunami intensity scale. Possible values are 112 corresponding to IXII.</rdfs:comment>
        <rdfs:label xml:lang="en">intensity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Tsunami.magnitude -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Tsunami.magnitude">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Tsunami"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Tsunami magnitude in the Tsunami Magnitude Scale Mt.  Is greater than zero.</rdfs:comment>
        <rdfs:label xml:lang="en">magnitude</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TurbLCFB1.fbf -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#TurbLCFB1.fbf">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TurbLCFB1"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Frequency bias flag iFbfi.true  enable frequency biasfalse  disable frequency bias.Typical value  false.</rdfs:comment>
        <rdfs:label xml:lang="en">fbf</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TurbLCFB1.pbf -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#TurbLCFB1.pbf">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TurbLCFB1"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Power controller flag iPbfi.true  enable load controllerfalse  disable load controller.Typical value  false.</rdfs:comment>
        <rdfs:label xml:lang="en">pbf</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TurbLCFB1.speedReferenceGovernor -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#TurbLCFB1.speedReferenceGovernor">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TurbLCFB1"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Type of turbine governor reference iTypei.true  speed reference governorfalse  load reference governor.Typical value  true.</rdfs:comment>
        <rdfs:label xml:lang="en">speedReferenceGovernor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TypeMaterial.quantity -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#TypeMaterial.quantity">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TypeMaterial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The value unit of measure and multiplier for the quantity.</rdfs:comment>
        <rdfs:label xml:lang="en">quantity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UnavailabilitySwitchAction.open -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UnavailabilitySwitchAction.open">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UnavailabilitySwitchAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>The switch is to be open during the scheduled period. </rdfs:comment>
        <rdfs:label xml:lang="en">open</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UnderexcLimIEEE2.k1 -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UnderexcLimIEEE2.k1">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UnderexcLimIEEE2"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>UEL terminal voltage exponent applied to real power input to UEL limit lookup table ik1i.  Typical value  2.</rdfs:comment>
        <rdfs:label xml:lang="en">k1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UnderexcLimIEEE2.k2 -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UnderexcLimIEEE2.k2">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UnderexcLimIEEE2"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>UEL terminal voltage exponent applied to reactive power output from UEL limit lookup table ik2i.  Typical value  2.</rdfs:comment>
        <rdfs:label xml:lang="en">k2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UndergroundStructure.hasVentilation -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UndergroundStructure.hasVentilation">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UndergroundStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>True if vault is ventilating.</rdfs:comment>
        <rdfs:label xml:lang="en">hasVentilation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UndergroundStructure.material -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UndergroundStructure.material">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UndergroundStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Primary material of underground structure.</rdfs:comment>
        <rdfs:label xml:lang="en">material</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UndergroundStructure.sealingWarrantyExpiresDate -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UndergroundStructure.sealingWarrantyExpiresDate">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UndergroundStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date sealing warranty expires.</rdfs:comment>
        <rdfs:label xml:lang="en">sealingWarrantyExpiresDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Unit.name -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Unit.name">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/saref#hasName"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Unit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The coded representation of the unit.</rdfs:comment>
        <rdfs:label xml:lang="en">name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UnitInitialConditions.cumStatusChanges -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UnitInitialConditions.cumStatusChanges">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UnitInitialConditions"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Cumulative number of status changes of the resource.</rdfs:comment>
        <rdfs:label xml:lang="en">cumStatusChanges</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UnitInitialConditions.numberOfStartups -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UnitInitialConditions.numberOfStartups">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UnitInitialConditions"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Number of start ups in the Operating Day until the end of previous hour.</rdfs:comment>
        <rdfs:label xml:lang="en">numberOfStartups</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UnitInitialConditions.onlineStatus -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UnitInitialConditions.onlineStatus">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UnitInitialConditions"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>true if the GeneratingUnit is currently OnLine</rdfs:comment>
        <rdfs:label xml:lang="en">onlineStatus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UnitInitialConditions.resourceStatus -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UnitInitialConditions.resourceStatus">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UnitInitialConditions"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Resource status at the end of previous clearing period0  offline1  online production2  in shutdown process3  in startup process</rdfs:comment>
        <rdfs:label xml:lang="en">resourceStatus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UnitInitialConditions.statusDate -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UnitInitialConditions.statusDate">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UnitInitialConditions"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Time and date for resourceStatus</rdfs:comment>
        <rdfs:label xml:lang="en">statusDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UnitInitialConditions.timeInStatus -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UnitInitialConditions.timeInStatus">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UnitInitialConditions"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Time in market trading intervals the resource is in the state as of the end of the previous clearing period.</rdfs:comment>
        <rdfs:label xml:lang="en">timeInStatus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UnitInitialConditions.timeInterval -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UnitInitialConditions.timeInterval">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UnitInitialConditions"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Time interval</rdfs:comment>
        <rdfs:label xml:lang="en">timeInterval</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UnplannedOutage.cause -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UnplannedOutage.cause">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UnplannedOutage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The cause of this outage.  This is the cause that is used to present to external entities.  That is the cause is weather equipment failure etc.Note At present this is a free text could be replaced with a separate associated class in case we have multiple causes e.g. OutageCauseType inheriting from IdentifiedObject.</rdfs:comment>
        <rdfs:label xml:lang="en">cause</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UnplannedOutage.reportedStartTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UnplannedOutage.reportedStartTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UnplannedOutage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The earliest start time of the Outage  as reported by some system or individual</rdfs:comment>
        <rdfs:label xml:lang="en">reportedStartTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UsagePoint.checkBilling -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UsagePoint.checkBilling">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UsagePoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>True if as a result of an inspection or otherwise there is a reason to suspect that a previous billing may have been performed with erroneous data. Value should be reset once this potential discrepancy has been resolved.</rdfs:comment>
        <rdfs:label xml:lang="en">checkBilling</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UsagePoint.connectionCategory -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UsagePoint.connectionCategory">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UsagePoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A code used to specify the connection category e.g. low voltage or low pressure where the usage point is defined.</rdfs:comment>
        <rdfs:label xml:lang="en">connectionCategory</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UsagePoint.disconnectionMethod -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UsagePoint.disconnectionMethod">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UsagePoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Is an indication of how the usage point is physically connected or disconnected.</rdfs:comment>
        <rdfs:label xml:lang="en">disconnectionMethod</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UsagePoint.grounded -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UsagePoint.grounded">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UsagePoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>True if grounded.</rdfs:comment>
        <rdfs:label xml:lang="en">grounded</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UsagePoint.isSdp -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UsagePoint.isSdp">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UsagePoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>If true this usage point is a service delivery point i.e. a usage point where the ownership of the service changes hands.</rdfs:comment>
        <rdfs:label xml:lang="en">isSdp</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UsagePoint.isVirtual -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UsagePoint.isVirtual">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UsagePoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>If true this usage point is virtual i.e. no physical location exists in the network where a meter could be located to collect the meter readings. For example one may define a virtual usage point to serve as an aggregation of usage for all of a companys premises distributed widely across the distribution territory. Otherwise the usage point is physical i.e. there is a logical point in the network where a meter could be located to collect meter readings.</rdfs:comment>
        <rdfs:label xml:lang="en">isVirtual</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UsagePoint.minimalUsageExpected -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UsagePoint.minimalUsageExpected">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UsagePoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>If true minimal or zero usage is expected at this usage point for situations such as premises vacancy logical or physical disconnect. It is used for readings validation and estimation.</rdfs:comment>
        <rdfs:label xml:lang="en">minimalUsageExpected</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UsagePoint.outageRegion -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UsagePoint.outageRegion">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UsagePoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Outage region in which this usage point is located.</rdfs:comment>
        <rdfs:label xml:lang="en">outageRegion</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UsagePoint.readCycle -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UsagePoint.readCycle">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UsagePoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Cycle day on which the meter for this usage point will normally be read.  Usually correlated with the billing cycle.</rdfs:comment>
        <rdfs:label xml:lang="en">readCycle</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UsagePoint.readRoute -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UsagePoint.readRoute">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UsagePoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Identifier of the route to which this usage point is assigned for purposes of meter reading. Typically used to configure hand held meter reading systems prior to collection of reads.</rdfs:comment>
        <rdfs:label xml:lang="en">readRoute</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UsagePoint.serviceDeliveryRemark -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UsagePoint.serviceDeliveryRemark">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UsagePoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Remarks about this usage point for example the reason for it being rated with a nonnominal priority.</rdfs:comment>
        <rdfs:label xml:lang="en">serviceDeliveryRemark</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UsagePoint.servicePriority -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#UsagePoint.servicePriority">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#UsagePoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Priority of service for this usage point. Note that usage points at the same service location can have different priorities.</rdfs:comment>
        <rdfs:label xml:lang="en">servicePriority</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#UsagePointLocation.remark -->

