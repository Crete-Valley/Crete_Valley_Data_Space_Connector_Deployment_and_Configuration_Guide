    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#InterTieBid -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#InterTieBid">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#ResourceBid"/>
        <rdfs:comment>This class represents the inter tie bid.</rdfs:comment>
        <rdfs:label xml:lang="en">InterTieBid</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#InterTieClearing -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#InterTieClearing">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#MarketFactors"/>
        <rdfs:comment>Model of market clearing related to results at the interties. Identifies interval</rdfs:comment>
