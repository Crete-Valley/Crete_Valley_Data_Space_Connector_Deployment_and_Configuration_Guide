    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TransformerObservation.oilIFT -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#TransformerObservation.oilIFT">
