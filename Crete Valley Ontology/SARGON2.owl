        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#SvSwitch"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#SinglePhaseKind"/>
        <rdfs:comment>The terminal phase at which the connection is applied.   If missing the injection is assumed to be balanced among nonneutral phases.</rdfs:comment>
