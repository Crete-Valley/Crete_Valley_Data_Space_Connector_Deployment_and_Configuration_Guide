    <!-- http://www.iec.ch/TC57/CIM#ProtectiveActionEquipment.inService -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ProtectiveActionEquipment.inService">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ProtectiveActionEquipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>If true the equipment is put inservice otherwise outofservice.</rdfs:comment>
        <rdfs:label xml:lang="en">inService</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ProtectiveActionRegulation.isRegulating -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ProtectiveActionRegulation.isRegulating">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ProtectiveActionRegulation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>If true the regulator is put inservice otherwise outofservice no regulation.</rdfs:comment>
        <rdfs:label xml:lang="en">isRegulating</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ProtectiveActionRegulation.targetValue -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ProtectiveActionRegulation.targetValue">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ProtectiveActionRegulation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The target value specified the new case input for the regulator.  The value has the units appropriate to the mode attribute. The protective action does not change the mode attribute.</rdfs:comment>
        <rdfs:label xml:lang="en">targetValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Pss1.komega -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Pss1.komega">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Pss1"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Shaft speed power input gain iKiisubomegasubi.  Typical value  0.</rdfs:comment>
        <rdfs:label xml:lang="en">komega</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Pss1.ks -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Pss1.ks">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Pss1"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>PSS gain iKsi.  Typical value  1.</rdfs:comment>
        <rdfs:label xml:lang="en">ks</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Pss1A.kd -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Pss1A.kd">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Pss1A"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Selector iKdi. true  esupsTdelaysup usedfalse  esupsTdelaysup not used.</rdfs:comment>
        <rdfs:label xml:lang="en">kd</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Pss2B.a -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Pss2B.a">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Pss2B"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Numerator constant iai.  Typical value  1.</rdfs:comment>
        <rdfs:label xml:lang="en">a</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Pss5.ctw2 -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Pss5.ctw2">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Pss5"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Selector for second washout enabling iCiisubTW2subi.true  second washout filter is bypassedfalse  second washout filter in use.Typical value  true.</rdfs:comment>
        <rdfs:label xml:lang="en">ctw2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Pss5.isfreq -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Pss5.isfreq">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Pss5"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Selector for frequencyshaft speed input iisFreqi.true  speed same meaning as InputSignaKind.rotorSpeedfalse  frequency same meaning as InputSignalKind.busFrequency.Typical value  true same meaning as InputSignalKind.rotorSpeed.</rdfs:comment>
        <rdfs:label xml:lang="en">isfreq</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Pss5.kpss -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Pss5.kpss">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Pss5"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>PSS gain iKiisubPSSsubi.  Typical value  1.</rdfs:comment>
        <rdfs:label xml:lang="en">kpss</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PssIEEE4B.bwh1 -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PssIEEE4B.bwh1">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PssIEEE4B"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Notch filter 1 highfrequency band three dB bandwidth iBiisubwisubi. </rdfs:comment>
        <rdfs:label xml:lang="en">bwh1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PssIEEE4B.bwh2 -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PssIEEE4B.bwh2">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PssIEEE4B"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Notch filter 2 highfrequency band three dB bandwidth iBiisubwisubi. </rdfs:comment>
        <rdfs:label xml:lang="en">bwh2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PssIEEE4B.bwl1 -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PssIEEE4B.bwl1">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PssIEEE4B"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Notch filter 1 lowfrequency band three dB bandwidth iBiisubwisubi. </rdfs:comment>
        <rdfs:label xml:lang="en">bwl1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PssIEEE4B.bwl2 -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PssIEEE4B.bwl2">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PssIEEE4B"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Notch filter 2 lowfrequency band three dB bandwidth iBiisubwisubi. </rdfs:comment>
        <rdfs:label xml:lang="en">bwl2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PssIEEE4B.omeganh1 -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PssIEEE4B.omeganh1">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PssIEEE4B"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Notch filter 1 highfrequency band filter frequency iomegaiisubnisubi.</rdfs:comment>
        <rdfs:label xml:lang="en">omeganh1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PssIEEE4B.omeganh2 -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PssIEEE4B.omeganh2">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PssIEEE4B"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Notch filter 2 highfrequency band filter frequency iomegaiisubnisubi.</rdfs:comment>
        <rdfs:label xml:lang="en">omeganh2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PssIEEE4B.omeganl1 -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PssIEEE4B.omeganl1">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PssIEEE4B"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Notch filter 1 lowfrequency band filter frequency iomegaiisubnisubi.</rdfs:comment>
        <rdfs:label xml:lang="en">omeganl1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PssIEEE4B.omeganl2 -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PssIEEE4B.omeganl2">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PssIEEE4B"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Notch filter 2 lowfrequency band filter frequency iomegaiisubnisubi.</rdfs:comment>
        <rdfs:label xml:lang="en">omeganl2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PssPTIST3.isw -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PssPTIST3.isw">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PssPTIST3"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Digitalanalogue output switch iIswi.true  produce analogue outputfalse  convert to digital output using tap selection table. </rdfs:comment>
        <rdfs:label xml:lang="en">isw</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PssPTIST3.nav -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PssPTIST3.nav">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PssPTIST3"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Number of control outputs to average iNAVi 1 lt  iNAVi lt 16.  Typical value  4.</rdfs:comment>
        <rdfs:label xml:lang="en">nav</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PssPTIST3.ncl -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PssPTIST3.ncl">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PssPTIST3"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Number of counts at limit to active limit function iNCLi gt 0. </rdfs:comment>
        <rdfs:label xml:lang="en">ncl</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PssPTIST3.ncr -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PssPTIST3.ncr">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PssPTIST3"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Number of counts until reset after limit function is triggered iNCRi. </rdfs:comment>
        <rdfs:label xml:lang="en">ncr</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PssRQB.kdpm -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PssRQB.kdpm">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PssRQB"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Lead lag gain iKDPMi. Typical value  0185.</rdfs:comment>
        <rdfs:label xml:lang="en">kdpm</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PssRQB.ki2 -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PssRQB.ki2">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PssRQB"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Speed input gain iKi2i. Typical value  343.</rdfs:comment>
        <rdfs:label xml:lang="en">ki2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PssRQB.ki3 -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PssRQB.ki3">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PssRQB"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Electrical power input gain iKi3i. Typical value  1145.</rdfs:comment>
        <rdfs:label xml:lang="en">ki3</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PssRQB.ki4 -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PssRQB.ki4">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PssRQB"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Mechanical power input gain iKi4i. Typical value  1186.</rdfs:comment>
        <rdfs:label xml:lang="en">ki4</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PublicX509Certificate.issuerName -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PublicX509Certificate.issuerName">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/saref#hasName"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PublicX509Certificate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Represents the CA that issued the certificate.  Defined to be per X.509.</rdfs:comment>
        <rdfs:label xml:lang="en">issuerName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PublicX509Certificate.serialNumber -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PublicX509Certificate.serialNumber">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PublicX509Certificate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Is the serial number of the certificate per X.509 definition.</rdfs:comment>
        <rdfs:label xml:lang="en">serialNumber</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Quality61850.badReference -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Quality61850.badReference">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Quality61850"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Measurement value may be incorrect due to a reference being out of calibration.</rdfs:comment>
        <rdfs:label xml:lang="en">badReference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Quality61850.estimatorReplaced -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Quality61850.estimatorReplaced">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Quality61850"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Value has been replaced by State Estimator. estimatorReplaced is not an IEC61850 quality bit but has been put in this class for convenience.</rdfs:comment>
        <rdfs:label xml:lang="en">estimatorReplaced</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Quality61850.failure -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Quality61850.failure">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Quality61850"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>This identifier indicates that a supervision function has detected an internal or external failure e.g. communication failure.</rdfs:comment>
        <rdfs:label xml:lang="en">failure</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Quality61850.oldData -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Quality61850.oldData">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Quality61850"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Measurement value is old and possibly invalid as it has not been successfully updated during a specified time interval.</rdfs:comment>
        <rdfs:label xml:lang="en">oldData</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Quality61850.operatorBlocked -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Quality61850.operatorBlocked">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Quality61850"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Measurement value is blocked and hence unavailable for transmission. </rdfs:comment>
        <rdfs:label xml:lang="en">operatorBlocked</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Quality61850.oscillatory -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Quality61850.oscillatory">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Quality61850"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>To prevent some overload of the communication it is sensible to detect and suppress oscillating fast changing binary inputs. If a signal changes in a defined time twice in the same direction from 0 to 1 or from 1 to 0 then oscillation is detected and the detail quality identifier oscillatory is set. If it is detected a configured numbers of transient changes could be passed by. In this time the validity status questionable is set. If after this defined numbers of changes the signal is still in the oscillating state the value shall be set either to the opposite state of the previous stable value or to a defined default value. In this case the validity status questionable is reset and invalid is set as long as the signal is oscillating. If it is configured such that no transient changes should be passed by then the validity status invalid is set immediately in addition to the detail quality identifier oscillatory used for status information only.</rdfs:comment>
        <rdfs:label xml:lang="en">oscillatory</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Quality61850.outOfRange -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Quality61850.outOfRange">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Quality61850"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Measurement value is beyond a predefined range of value.</rdfs:comment>
        <rdfs:label xml:lang="en">outOfRange</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Quality61850.overFlow -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Quality61850.overFlow">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Quality61850"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Measurement value is beyond the capability of being  represented properly. For example a counter value overflows from maximum count back to a value of zero. </rdfs:comment>
        <rdfs:label xml:lang="en">overFlow</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Quality61850.suspect -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Quality61850.suspect">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Quality61850"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>A correlation function has detected that the value is not consistent with other values. Typically set by a network State Estimator.</rdfs:comment>
        <rdfs:label xml:lang="en">suspect</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Quality61850.test -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Quality61850.test">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Quality61850"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Measurement value is transmitted for test purposes.</rdfs:comment>
        <rdfs:label xml:lang="en">test</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Quantity.quantity -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Quantity.quantity">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RMROperatorInput.manuallySchedRMRMw -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RMROperatorInput.manuallySchedRMRMw">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RMROperatorInput"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The lower of the original predispatch or the AC run schedule Also known as the RMR Reguirement becomes the predispatch value. </rdfs:comment>
        <rdfs:label xml:lang="en">manuallySchedRMRMw</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RUCAwardInstruction.RUCAward -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RUCAwardInstruction.RUCAward">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RUCAwardInstruction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The RUC Award of a resource is the portion of the RUC Capacity that is not under RA or RMR contracts. The RUC Award of a resource is the portion of the RUC Capacity that is eligible for RUC Availability payment.</rdfs:comment>
        <rdfs:label xml:lang="en">RUCAward</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RUCAwardInstruction.RUCCapacity -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RUCAwardInstruction.RUCCapacity">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RUCAwardInstruction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The RUC Capacity of a resource is the difference between i the RUC Schedule and ii the higher of the DA Schedule and the Minimum Load.</rdfs:comment>
        <rdfs:label xml:lang="en">RUCCapacity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RUCAwardInstruction.RUCSchedule -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RUCAwardInstruction.RUCSchedule">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RUCAwardInstruction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The RUC Schedule of a resource is its output level that balances the load forecast used in RUC. The RUC Schedule in RUC is similar to the DA Schedule in DAM.</rdfs:comment>
        <rdfs:label xml:lang="en">RUCSchedule</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Ratio.denominator -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Ratio.denominator">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Ratio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The part of a fraction that is below the line and that functions as the divisor of the numerator.</rdfs:comment>
        <rdfs:label xml:lang="en">denominator</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Ratio.numerator -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Ratio.numerator">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Ratio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The part of a fraction that is above the line and signifies the number to be divided by the denominator.</rdfs:comment>
        <rdfs:label xml:lang="en">numerator</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RationalNumber.denominator -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RationalNumber.denominator">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RationalNumber"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Denominator. Value 1 indicates the number is a simple integer.</rdfs:comment>
        <rdfs:label xml:lang="en">denominator</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RationalNumber.numerator -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RationalNumber.numerator">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RationalNumber"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Numerator.</rdfs:comment>
        <rdfs:label xml:lang="en">numerator</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Reading.valueMissing -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Reading.valueMissing">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Reading"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>The indication of whether or not the quantity of this reading is missing.</rdfs:comment>
        <rdfs:label xml:lang="en">valueMissing</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ReadingInterharmonic.denominator -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ReadingInterharmonic.denominator">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ReadingInterharmonic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Interharmonic denominator. Value 0 means not applicable. Value 2 is used in combination with numerator1 to represent interharmonic 12. Finally value 1 indicates the harmonic of the order specified with numerator.</rdfs:comment>
        <rdfs:label xml:lang="en">denominator</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ReadingInterharmonic.numerator -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ReadingInterharmonic.numerator">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ReadingInterharmonic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Interharmonic numerator. Value 0 means not applicable. Value 1 is used in combination with denominator2 to represent interharmonic 12 and with denominator1 it represents fundamental frequency. Finally values greater than 1 indicate the harmonic of that order e.g. numerator5 is the fifth harmonic.</rdfs:comment>
        <rdfs:label xml:lang="en">numerator</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ReadingQuality.comment -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ReadingQuality.comment">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ReadingQuality"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Elaboration on the quality code.</rdfs:comment>
        <rdfs:label xml:lang="en">comment</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ReadingQuality.source -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ReadingQuality.source">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ReadingQuality"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>System acting as the source of the quality code.</rdfs:comment>
        <rdfs:label xml:lang="en">source</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ReadingQuality.timeStamp -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ReadingQuality.timeStamp">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ReadingQuality"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Date and time at which the quality code was assigned or ascertained.</rdfs:comment>
        <rdfs:label xml:lang="en">timeStamp</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ReadingQualityType.category -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ReadingQualityType.category">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ReadingQualityType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Highlevel nature of the reading value quality.</rdfs:comment>
        <rdfs:label xml:lang="en">category</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ReadingQualityType.subCategory -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ReadingQualityType.subCategory">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ReadingQualityType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>More specific nature of the reading value quality as a further subcategorisation of category.</rdfs:comment>
        <rdfs:label xml:lang="en">subCategory</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ReadingQualityType.systemId -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ReadingQualityType.systemId">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ReadingQualityType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Identification of the system which has declared the issue with the data or provided commentary on the data.</rdfs:comment>
        <rdfs:label xml:lang="en">systemId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ReadingType.consumptionTier -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ReadingType.consumptionTier">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ReadingType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>In case of common flatrate pricing for power in which all purchases are at a given rate consumptionTier0. Otherwise the value indicates the consumption tier which can be used in conjunction with TOU or CPP pricing.Consumption tier pricing refers to the method of billing in which a certain block of energy is purchasedsold at one price after which the next block of energy is purchased at another price and so on all throughout a defined period. At the start of the defined period consumption is initially zero and any usage is measured against the first consumption tier consumptionTier1. If this block of energy is consumed before the end of the period energy consumption moves to be reconed against the second consumption tier consumptionTier2 and so on. At the end of the defined period the consumption accumulator is reset and usage within the consumptionTier1 restarts.</rdfs:comment>
        <rdfs:label xml:lang="en">consumptionTier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ReadingType.cpp -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ReadingType.cpp">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ReadingType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Critical peak period CPP bucket the reading value is attributed to. Value 0 means not applicable. Even though CPP is usually considered a specialised form of time of use tou this attribute is defined explicitly for flexibility.</rdfs:comment>
        <rdfs:label xml:lang="en">cpp</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ReadingType.tou -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ReadingType.tou">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ReadingType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Time of use TOU bucket the reading value is attributed to. Value 0 means not applicable.</rdfs:comment>
        <rdfs:label xml:lang="en">tou</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Reason.code -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Reason.code">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Reason"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The motivation of an act in coded form.</rdfs:comment>
        <rdfs:label xml:lang="en">code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Reason.text -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Reason.text">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Reason"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The textual explanation corresponding to the reason code.</rdfs:comment>
        <rdfs:label xml:lang="en">text</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Receipt.isBankable -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Receipt.isBankable">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Receipt"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>True if this receipted payment is manually bankable otherwise it is an electronic funds transfer.</rdfs:comment>
        <rdfs:label xml:lang="en">isBankable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RecloseSequence.recloseStep -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RecloseSequence.recloseStep">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RecloseSequence"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Indicates the ordinal position of the reclose step relative to other steps in the sequence.</rdfs:comment>
        <rdfs:label xml:lang="en">recloseStep</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RecloserInfo.groundTripCapable -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RecloserInfo.groundTripCapable">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RecloserInfo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>True if device has ground trip capability.</rdfs:comment>
        <rdfs:label xml:lang="en">groundTripCapable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RecloserInfo.groundTripNormalEnabled -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RecloserInfo.groundTripNormalEnabled">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RecloserInfo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>True if normal status of ground trip is enabled.</rdfs:comment>
        <rdfs:label xml:lang="en">groundTripNormalEnabled</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RecloserInfo.recloseLockoutCount -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RecloserInfo.recloseLockoutCount">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RecloserInfo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Total number of phase reclose operations.</rdfs:comment>
        <rdfs:label xml:lang="en">recloseLockoutCount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Reconditioning.dateTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Reconditioning.dateTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Reconditioning"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Date and time this reconditioning or a major overhaul has been performed.</rdfs:comment>
        <rdfs:label xml:lang="en">dateTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Register.isVirtual -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Register.isVirtual">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Register"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>If true the data it produces is  calculated or measured by a device other than a physical end devicemeter. Otherwise any data streams it produces are measured by the hardware of the end devicemeter itself. </rdfs:comment>
        <rdfs:label xml:lang="en">isVirtual</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Register.leftDigitCount -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Register.leftDigitCount">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Register"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Number of digits dials on a mechanical meter to the left of the decimal place default is normally 5.</rdfs:comment>
        <rdfs:label xml:lang="en">leftDigitCount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Register.rightDigitCount -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Register.rightDigitCount">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Register"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Number of digits dials on a mechanical meter to the right of the decimal place.</rdfs:comment>
        <rdfs:label xml:lang="en">rightDigitCount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Register.touTierName -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Register.touTierName">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/saref#hasName"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Register"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name used for the time of use tier also known as bin or bucket.  For example peak offpeak TOU Category A etc. </rdfs:comment>
        <rdfs:label xml:lang="en">touTierName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredControllableLoad.maxDeploymentTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredControllableLoad.maxDeploymentTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegisteredControllableLoad"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Maximum Deployment time seconds</rdfs:comment>
        <rdfs:label xml:lang="en">maxDeploymentTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredControllableLoad.maxLoadRedTimesPerDay -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredControllableLoad.maxLoadRedTimesPerDay">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegisteredControllableLoad"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Maximum Number of Daily Load Curtailments</rdfs:comment>
        <rdfs:label xml:lang="en">maxLoadRedTimesPerDay</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredControllableLoad.maxReductionTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredControllableLoad.maxReductionTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegisteredControllableLoad"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Maxiimum Load Reduction Time min per Participating Load Resource</rdfs:comment>
        <rdfs:label xml:lang="en">maxReductionTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredControllableLoad.maxWeeklyDeployment -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredControllableLoad.maxWeeklyDeployment">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegisteredControllableLoad"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Maximum weekly deployments</rdfs:comment>
        <rdfs:label xml:lang="en">maxWeeklyDeployment</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredControllableLoad.minLoadReductionInterval -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredControllableLoad.minLoadReductionInterval">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegisteredControllableLoad"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Shortest period load reduction shall be maintained before load can be restored to normal levels.This attribute may be used also in the LoadBid class. The reason that the attribute is also modeled in this class is that it is resource attribute and needs to be persistently stored.</rdfs:comment>
        <rdfs:label xml:lang="en">minLoadReductionInterval</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredControllableLoad.minReductionTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredControllableLoad.minReductionTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegisteredControllableLoad"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Minimum Load Reduction Time min per Participating Load Resource</rdfs:comment>
        <rdfs:label xml:lang="en">minReductionTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredControllableLoad.minTimeBetLoadRed -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredControllableLoad.minTimeBetLoadRed">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegisteredControllableLoad"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Shortest time that load shall be left at normal levels before a new load reduction.This attribute may be used also in the LoadBid class. The reason that the attribute is also modeled in this class is that it is resource attribute and needs to be persistently stored.</rdfs:comment>
        <rdfs:label xml:lang="en">minTimeBetLoadRed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredControllableLoad.reqNoticeTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredControllableLoad.reqNoticeTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegisteredControllableLoad"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Time period that is required from an order to reduce a load to the time that it takes to get to the minimum load reduction.This attribute may be used also in the LoadBid class. The reason that the attribute is also modeled in this class is that it is resource attribute and needs to be persistently stored.</rdfs:comment>
        <rdfs:label xml:lang="en">reqNoticeTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredDistributedResource.distributedResourceType -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredDistributedResource.distributedResourceType">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegisteredDistributedResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The type of resource. Examples include fuel cell flywheel photovoltaic microturbine CHP combined heat power V2G vehicle to grid DES distributed energy storage and others.</rdfs:comment>
        <rdfs:label xml:lang="en">distributedResourceType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredGenerator.coldStartTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredGenerator.coldStartTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegisteredGenerator"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Cold start time.</rdfs:comment>
        <rdfs:label xml:lang="en">coldStartTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredGenerator.combinedCycleOperatingMode -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredGenerator.combinedCycleOperatingMode">
