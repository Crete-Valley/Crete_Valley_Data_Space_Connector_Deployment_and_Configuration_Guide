        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#UnderexcitationLimiterDynamics"/>
        <rdfs:comment>Type UEL1 model which has a circular limit boundary when plotted in terms of machine reactive power vs. real power output.Reference IEEE UEL1 421.52005 10.1. </rdfs:comment>
        <rdfs:label xml:lang="en">UnderexcLimIEEE1</rdfs:label>
    </owl:Class>
    


