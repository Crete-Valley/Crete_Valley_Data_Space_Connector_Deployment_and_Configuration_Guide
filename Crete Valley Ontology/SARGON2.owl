        <rdfs:comment>font color0f0f0fAllisChalmers minimum excitation limiter.font</rdfs:comment>
        <rdfs:label xml:lang="en">UnderexcLimX1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#UnderexcLimX2 -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#UnderexcLimX2">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#UnderexcitationLimiterDynamics"/>
        <rdfs:comment>font color0f0f0fWestinghouse minimum excitation limiter.font</rdfs:comment>
        <rdfs:label xml:lang="en">UnderexcLimX2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#UnderexcitationLimiterDynamics -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#UnderexcitationLimiterDynamics">
