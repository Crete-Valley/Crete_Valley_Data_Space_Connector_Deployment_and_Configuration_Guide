        <rdfs:comment>Pricing tier as chosen by the commodity provider.</rdfs:comment>
        <rdfs:label xml:lang="en">priceTier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PanPricingDetail.priceTierCount -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PanPricingDetail.priceTierCount">
