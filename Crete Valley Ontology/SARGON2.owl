    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#MarketProductTypeAsReq.RU">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#MarketProductTypeAsReq"/>
