    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#StaticLoadModelKind -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#StaticLoadModelKind">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Type of static load model.</rdfs:comment>
        <rdfs:label xml:lang="en">StaticLoadModelKind</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#StaticVarCompensator -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#StaticVarCompensator">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#RegulatingCondEq"/>
        <rdfs:comment>A facility for providing variable and controllable shunt reactive power. The SVC typically consists of a stepdown transformer filter thyristorcontrolled reactor and thyristorswitched capacitor arms.The SVC may operate in fixed MVar output mode or in voltage control mode. When in voltage control mode the output of the SVC will be proportional to the deviation of voltage at the controlled bus from the voltage setpoint.  The SVC characteristic slope defines the proportion.  If the voltage at the controlled bus is equal to the voltage setpoint the SVC MVar output is zero.</rdfs:comment>
        <rdfs:label xml:lang="en">StaticVarCompensator</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#StaticVarCompensatorDynamics -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#StaticVarCompensatorDynamics">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#DynamicsFunctionBlock"/>
        <rdfs:comment>Static var compensator whose behaviour is described by reference to a standard model font color0f0f0for by definition of a userdefined model.font</rdfs:comment>
        <rdfs:label xml:lang="en">StaticVarCompensatorDynamics</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#StatisticalCalculation -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#StatisticalCalculation">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>Description of statistical calculation performed.</rdfs:comment>
        <rdfs:label xml:lang="en">StatisticalCalculation</rdfs:label>
    </owl:Class>
    


