    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredGenerator.rampCurveType">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegisteredGenerator"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#RampCurveType"/>
        <rdfs:comment>Ramp curve type. Identifies the type of curve which may be a fixed static or dynamic.</rdfs:comment>
        <rdfs:label xml:lang="en">rampCurveType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredGenerator.regulationDownRampRate -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredGenerator.regulationDownRampRate">
