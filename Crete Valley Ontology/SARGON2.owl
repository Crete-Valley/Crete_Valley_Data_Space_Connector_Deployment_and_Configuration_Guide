        <rdfs:comment>Mechanical load function block whose behaviour is described by reference to a standard model font color0f0f0for by definition of a userdefined model.font</rdfs:comment>
        <rdfs:label xml:lang="en">MechanicalLoadDynamics</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#MechanicalLoadUserDefined -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#MechanicalLoadUserDefined">
