        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ActivePowerChangeRate"/>
        <rdfs:comment>Response rate in MW per minute for spinning reserve.</rdfs:comment>
        <rdfs:label xml:lang="en">spinRampRate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredGenerator.startUpCostBasis -->

