    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ChargeProfile">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Profile"/>
        <rdfs:comment>A type of profile for financial charges.</rdfs:comment>
        <rdfs:label xml:lang="en">ChargeProfile</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ChargeProfileData -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ChargeProfileData">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Toplevel"/>
        <rdfs:comment>Model of various charges associated with an energy profile to support billing and settlement.</rdfs:comment>
        <rdfs:label xml:lang="en">ChargeProfileData</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ChargeType -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ChargeType">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Document"/>
