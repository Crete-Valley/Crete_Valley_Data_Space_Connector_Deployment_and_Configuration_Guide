        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Ratio of generationPrice to the normal price chosen by the commodity provider.</rdfs:comment>
        <rdfs:label xml:lang="en">generationPriceRatio</rdfs:label>
    </owl:DatatypeProperty>
    


