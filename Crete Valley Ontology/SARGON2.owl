        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Maximum base self schedule quantity.</rdfs:comment>
        <rdfs:label xml:lang="en">maxBaseSelfSchedQty</rdfs:label>
    </owl:DatatypeProperty>
    


