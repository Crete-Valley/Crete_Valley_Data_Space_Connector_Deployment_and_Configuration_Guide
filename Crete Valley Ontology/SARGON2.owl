        <rdfs:label xml:lang="en">automaticPay</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ServiceGuarantee.serviceRequirement -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ServiceGuarantee.serviceRequirement">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ServiceGuarantee"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Explanation of the requirement and conditions for satisfying it.</rdfs:comment>
        <rdfs:label xml:lang="en">serviceRequirement</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ServiceLocation.needsInspection -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#ServiceLocation.needsInspection">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ServiceLocation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
