        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#TapChanger"/>
        <rdfs:comment>The tap changers that participates in this regulating tap control scheme.</rdfs:comment>
        <rdfs:label>ClientEnd</rdfs:label>
        <rdfs:label xml:lang="en">TapChanger</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TapChangerControl.limitVoltage -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TapChangerControl.limitVoltage">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TapChangerControl"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Voltage"/>
        <rdfs:comment>Maximum allowed regulated voltage on the PT secondary regardless of line drop compensation. Sometimes referred to as firsthouse protection.</rdfs:comment>
        <rdfs:label xml:lang="en">limitVoltage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TapChangerControl.lineDropR -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TapChangerControl.lineDropR">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TapChangerControl"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Resistance"/>
        <rdfs:comment>Line drop compensator resistance setting for normal forward power flow.</rdfs:comment>
        <rdfs:label xml:lang="en">lineDropR</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TapChangerControl.lineDropX -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TapChangerControl.lineDropX">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TapChangerControl"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Reactance"/>
        <rdfs:comment>Line drop compensator reactance setting for normal forward power flow.</rdfs:comment>
        <rdfs:label xml:lang="en">lineDropX</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TapChangerControl.reverseLineDropR -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TapChangerControl.reverseLineDropR">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TapChangerControl"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Resistance"/>
        <rdfs:comment>Line drop compensator resistance setting for reverse power flow.</rdfs:comment>
        <rdfs:label xml:lang="en">reverseLineDropR</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TapChangerControl.reverseLineDropX -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TapChangerControl.reverseLineDropX">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TapChangerControl"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Reactance"/>
        <rdfs:comment>Line drop compensator reactance setting for reverse power flow.</rdfs:comment>
        <rdfs:label xml:lang="en">reverseLineDropX</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TapChangerDynamicData.MktTapChanger -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TapChangerDynamicData.MktTapChanger">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TapChangerDynamicData"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#MktTapChanger"/>
        <rdfs:label xml:lang="en">MktTapChanger</rdfs:label>
        <rdfs:label>SupplierEnd</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TapChangerInfo.bil -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TapChangerInfo.bil">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TapChangerInfo"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Voltage"/>
        <rdfs:comment>Basic Insulation Level BIL expressed as the impulse crest voltage of a nominal wave typically 1.2 X 50 microsecond. This is a measure of the ability of the insulation to withstand very high voltage surges.</rdfs:comment>
        <rdfs:label xml:lang="en">bil</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TapChangerInfo.ctRating -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TapChangerInfo.ctRating">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TapChangerInfo"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#CurrentFlow"/>
        <rdfs:comment>Builtin current transformer primary rating.</rdfs:comment>
        <rdfs:label xml:lang="en">ctRating</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TapChangerInfo.frequency -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TapChangerInfo.frequency">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TapChangerInfo"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Frequency"/>
        <rdfs:comment>Frequency at which the ratings apply.</rdfs:comment>
        <rdfs:label xml:lang="en">frequency</rdfs:label>
    </owl:ObjectProperty>
    


