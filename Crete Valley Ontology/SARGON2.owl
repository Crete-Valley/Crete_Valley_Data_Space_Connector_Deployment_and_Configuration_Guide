        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A code describing the type or absence of surge tank that is associated with the hydro power plant.</rdfs:comment>
        <rdfs:label xml:lang="en">surgeTankCode</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#HydroTurbine.gateRateLimit -->

