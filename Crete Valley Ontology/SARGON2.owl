        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Total breaker fault operations to date.</rdfs:comment>
        <rdfs:label xml:lang="en">lifetimeFaultOperations</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SwitchOperationSummary.lifetimeMotorStarts -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#SwitchOperationSummary.lifetimeMotorStarts">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#SwitchOperationSummary"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Total motor starts to date.</rdfs:comment>
        <rdfs:label xml:lang="en">lifetimeMotorStarts</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SwitchOperationSummary.lifetimeTotalOperations -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#SwitchOperationSummary.lifetimeTotalOperations">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#SwitchOperationSummary"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Total breaker operations to date including fault and nonfault.</rdfs:comment>
        <rdfs:label xml:lang="en">lifetimeTotalOperations</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SwitchOperationSummary.mostRecentFaultOperationDate -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#SwitchOperationSummary.mostRecentFaultOperationDate">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#SwitchOperationSummary"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date of most recent breaker fault operation.</rdfs:comment>
        <rdfs:label xml:lang="en">mostRecentFaultOperationDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SwitchOperationSummary.mostRecentMotorStartDate -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#SwitchOperationSummary.mostRecentMotorStartDate">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#SwitchOperationSummary"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date of most recent motor start.</rdfs:comment>
        <rdfs:label xml:lang="en">mostRecentMotorStartDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SwitchOperationSummary.mostRecentOperationDate -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#SwitchOperationSummary.mostRecentOperationDate">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#SwitchOperationSummary"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date of most recent breaker operation fault or nonfault.</rdfs:comment>
        <rdfs:label xml:lang="en">mostRecentOperationDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SwitchPhase.closed -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#SwitchPhase.closed">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#SwitchPhase"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>The attribute tells if the switch is considered closed when used as input to topology processing.</rdfs:comment>
        <rdfs:label xml:lang="en">closed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SwitchingAction.executedDateTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#SwitchingAction.executedDateTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#SwitchingAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Actual date and time of this switching step.</rdfs:comment>
