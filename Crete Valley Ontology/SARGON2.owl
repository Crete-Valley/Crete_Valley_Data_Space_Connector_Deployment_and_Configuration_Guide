        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#CurrentFlow"/>
        <rdfs:comment>DC current target value. It is converters control variable used in power flow. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">targetIdc</rdfs:label>
    </owl:ObjectProperty>
    


