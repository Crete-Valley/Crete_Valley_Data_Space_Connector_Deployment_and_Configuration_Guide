        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#StaticLoadModelKind"/>
        <rdfs:comment>This model integrates the frequencydependent load primarily motors.  ZIP1 equations for active and reactive power are used and the following attributes are requiredkp1 kp2 kp3 kpfkq1 kq2 kq3 kqf.</rdfs:comment>
        <rdfs:label xml:lang="en">zIP1</rdfs:label>
    </owl:NamedIndividual>
    


