        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Receipt"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Transaction"/>
        <rdfs:comment>All transactions recorded for this receipted payment.</rdfs:comment>
        <rdfs:label>SupplierEnd</rdfs:label>
        <rdfs:label xml:lang="en">Transactions</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Receipt.line -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#Receipt.line">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Receipt"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#LineDetail"/>
        <rdfs:comment>Receipted amount with rounding date and note.</rdfs:comment>
        <rdfs:label xml:lang="en">line</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Receipts -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#Receipts">
        <owl:inverseOf rdf:resource="http://www.iec.ch/TC57/CIM#VendorShift_merged"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#CashierShift"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#VendorShift"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Receipt"/>
        <rdfs:comment>All Receipts recorded for this Shift.</rdfs:comment>
        <rdfs:comment>All receipts recorded during this vendor shift.</rdfs:comment>
        <rdfs:label xml:lang="en">Receipts</rdfs:label>
        <rdfs:label>SupplierEnd</rdfs:label>
    </owl:ObjectProperty>
    


