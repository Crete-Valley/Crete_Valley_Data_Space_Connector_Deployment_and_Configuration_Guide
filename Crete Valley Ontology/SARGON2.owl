    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TransformerObservation.oilLevel -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#TransformerObservation.oilLevel">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TransformerObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The level of oil in the transformer.</rdfs:comment>
        <rdfs:label xml:lang="en">oilLevel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TransformerObservation.oilNeutralizationNumber -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#TransformerObservation.oilNeutralizationNumber">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TransformerObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
