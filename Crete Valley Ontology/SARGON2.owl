        <rdfs:label xml:lang="en">NEGOTIATED</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.iec.ch/TC57/CIM#AggregateKind.average -->

    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#AggregateKind.average">
