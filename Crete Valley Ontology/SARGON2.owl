        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Voltage"/>
        <rdfs:comment>Maximum continuous power frequency voltage allowed on the surge arrester.</rdfs:comment>
        <rdfs:label xml:lang="en">continuousOperatingVoltage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SurgeArresterInfo.lightningImpulseDischargeVoltage -->

