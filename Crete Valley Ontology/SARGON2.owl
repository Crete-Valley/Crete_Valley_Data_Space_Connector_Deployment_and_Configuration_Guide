    <!-- http://www.iec.ch/TC57/CIM#AggregateKind.highThreshold -->

    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#AggregateKind.highThreshold">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#AggregateKind"/>
