        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#HostControlArea"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ProductBid"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#SubControlArea"/>
