        <rdfs:comment>The stage for which this costType applies estimated design estimated actual or actual actual. </rdfs:comment>
        <rdfs:label xml:lang="en">stage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#CurrentEmergencyScheduledInterchange.emergencyScheduleMW -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#CurrentEmergencyScheduledInterchange.emergencyScheduleMW">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#CurrentEmergencyScheduledInterchange"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Net tie MW. These are three entries the current emergency schedule interchange and the two future schedules if they exist.</rdfs:comment>
        <rdfs:label xml:lang="en">emergencyScheduleMW</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#CurrentEmergencyScheduledInterchange.emergencyScheduleRampTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#CurrentEmergencyScheduledInterchange.emergencyScheduleRampTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#CurrentEmergencyScheduledInterchange"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Ramp time the ramping time for a schedule. This is calculated as the remaining time to ramp if a schedule is ramping. Measured in seconds but can be negattive.</rdfs:comment>
        <rdfs:label xml:lang="en">emergencyScheduleRampTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#CurrentEmergencyScheduledInterchange.emergencyScheduleStartTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#CurrentEmergencyScheduledInterchange.emergencyScheduleStartTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#CurrentEmergencyScheduledInterchange"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Net tie time  the start time for a schedule. This is calculated as the current time if a schedule is ramping.</rdfs:comment>
