    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Circuit">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Line"/>
        <rdfs:label xml:lang="en">Circuit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#Clamp -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Clamp">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#ConductingEquipment"/>
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#SwitchingAction"/>
        <rdfs:comment>A Clamp is a galvanic connection at a line segment where other equipment is connected. A Clamp does not cut the line segment. A Clamp is ConductingEquipment and has one Terminal with an associated ConnectivityNode. Any other ConductingEquipment can be connected to the Clamp ConnectivityNode.</rdfs:comment>
        <rdfs:label xml:lang="en">Clamp</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ClampAction -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ClampAction">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#SwitchingAction"/>
        <rdfs:comment>Action on Clamp as a switching step</rdfs:comment>
        <rdfs:label xml:lang="en">ClampAction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#Classification -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Classification">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#CIMDatatype"/>
        <rdfs:comment>Classification of level.  Specify as 1..n with 1 being the most detailed highest priority etc as described on the attribute using this data type.</rdfs:comment>
        <rdfs:label xml:lang="en">Classification</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ClassificationCondition -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ClassificationCondition">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>A classification condition used to define preconditions that must be met by a phenomena classification.</rdfs:comment>
        <rdfs:label xml:lang="en">ClassificationCondition</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#CleanTradeProductType -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CleanTradeProductType">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:label xml:lang="en">CleanTradeProductType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ClearanceAction -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ClearanceAction">
