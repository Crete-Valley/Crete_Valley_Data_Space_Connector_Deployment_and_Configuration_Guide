        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#CurrentFlow"/>
        <rdfs:comment>Rated converter DC current also called IdN. The attribute shall be a positive value. It is converters configuration data used in power flow.</rdfs:comment>
        <rdfs:label xml:lang="en">ratedIdc</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#CsConverter.targetAlpha -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#CsConverter.targetAlpha">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#CsConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#AngleDegrees"/>
        <rdfs:comment>Target firing angle. It is converters control variable used in power flow. It is only applicable for rectifier if continuous tap changer control is used. Allowed values are within the range minAlphalttargetAlphaltmaxAlpha. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">targetAlpha</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#CsConverter.targetGamma -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#CsConverter.targetGamma">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#CsConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#AngleDegrees"/>
        <rdfs:comment>Target extinction angle. It is converters control variable used in power flow. It is only applicable for inverter if continuous tap changer control is used. Allowed values are within the range minGammalttargetGammaltmaxGamma. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">targetGamma</rdfs:label>
    </owl:ObjectProperty>
    


