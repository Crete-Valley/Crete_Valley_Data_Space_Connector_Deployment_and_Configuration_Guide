        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#ActivityRecord"/>
        <rdfs:comment>Event recording the change in operational status of a power system resource may be for an event that has already occurred or for a planned activity.</rdfs:comment>
        <rdfs:label xml:lang="en">PSREvent</rdfs:label>
    </owl:Class>
    


