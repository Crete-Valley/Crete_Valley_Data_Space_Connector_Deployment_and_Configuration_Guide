        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#YesNo"/>
        <rdfs:comment>Quick start flag YesNo. Identifies the registered generator as a quick start unit. A quick start unit is a unit that has the ability to be available for load within a 30 minute period.</rdfs:comment>
        <rdfs:label xml:lang="en">quickStartFlag</rdfs:label>
    </owl:ObjectProperty>
    


