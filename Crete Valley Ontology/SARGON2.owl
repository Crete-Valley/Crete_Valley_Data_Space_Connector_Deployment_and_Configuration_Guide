        <owl:inverseOf rdf:resource="http://www.iec.ch/TC57/CIM#Trade_merged"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#AuxiliaryObject"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#EnergyPriceIndex"/>
