        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Type and configuration of hydro plant penstocks.</rdfs:comment>
        <rdfs:label xml:lang="en">penstockType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#HydroPowerPlant.surgeTankCode -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#HydroPowerPlant.surgeTankCode">
