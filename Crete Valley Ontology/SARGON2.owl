        <rdfs:label xml:lang="en">ratedMechanicalPower</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#AsynchronousMachine.xp -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#AsynchronousMachine.xp">
