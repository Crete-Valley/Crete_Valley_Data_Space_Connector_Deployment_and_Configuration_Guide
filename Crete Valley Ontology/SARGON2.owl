    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Integer">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Primitive"/>
        <rdfs:comment>An integer number. The range is unspecified and not limited.</rdfs:comment>
        <rdfs:label xml:lang="en">Integer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#IntegerQuantity -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#IntegerQuantity">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Compound"/>
        <rdfs:comment>Quantity with integer value and associated unit information.</rdfs:comment>
