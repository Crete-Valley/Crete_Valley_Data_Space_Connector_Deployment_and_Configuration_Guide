        <rdfs:comment>The terminal connecting to the bus to which the fault is applied.</rdfs:comment>
        <rdfs:label>SupplierEnd</rdfs:label>
        <rdfs:label xml:lang="en">Terminal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#EquipmentLimitSeriesComponent.Equipment -->

