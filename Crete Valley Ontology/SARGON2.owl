    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#OneCallRequest.markedIndicator">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#OneCallRequest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>True if work location has been marked for example for a dig area.</rdfs:comment>
        <rdfs:label xml:lang="en">markedIndicator</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#OneCallRequest.markingInstruction -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#OneCallRequest.markingInstruction">
