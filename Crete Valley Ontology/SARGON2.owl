        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Reactance"/>
        <rdfs:comment>Transient reactance unsaturated greater than or equal to xpp.</rdfs:comment>
        <rdfs:label xml:lang="en">xp</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#AsynchronousMachine.xpp -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#AsynchronousMachine.xpp">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#AsynchronousMachine"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Reactance"/>
        <rdfs:comment>Subtransient reactance unsaturated.</rdfs:comment>
        <rdfs:label xml:lang="en">xpp</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#AsynchronousMachine.xs -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#AsynchronousMachine.xs">
