    </owl:NamedIndividual>
    


    <!-- http://www.iec.ch/TC57/CIM#AggregateKind.maximum -->

    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#AggregateKind.maximum">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#AggregateKind"/>
