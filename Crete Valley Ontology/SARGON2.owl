    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#PackageDependenciesCIMVersion -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#PackageDependenciesCIMVersion">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Toplevel"/>
        <rdfs:comment>The version of dependencies description among top level subpackages of the combined CIM model.  This is not the same as the combined packages version.</rdfs:comment>
        <rdfs:label xml:lang="en">PackageDependenciesCIMVersion</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#PanDemandResponse -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#PanDemandResponse">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#EndDeviceAction"/>
