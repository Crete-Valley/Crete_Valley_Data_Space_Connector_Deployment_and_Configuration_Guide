        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Maximum number of price tiers available.</rdfs:comment>
        <rdfs:label xml:lang="en">priceTierCount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PanPricingDetail.priceTierLabel -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PanPricingDetail.priceTierLabel">
