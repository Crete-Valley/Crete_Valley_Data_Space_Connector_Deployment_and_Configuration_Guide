    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#UnitSymbol.d">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#UnitSymbol"/>
        <rdfs:comment>Time in days day  24 h  86400 s.</rdfs:comment>
        <rdfs:label xml:lang="en">d</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.iec.ch/TC57/CIM#UnitSymbol.dB -->

    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#UnitSymbol.dB">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#UnitSymbol"/>
