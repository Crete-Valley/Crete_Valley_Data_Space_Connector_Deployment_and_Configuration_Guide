    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SwitchingAction.issuedDateTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#SwitchingAction.issuedDateTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#SwitchingAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Date and time when the crew was given the instruction to execute the action not applicable if the action is performed by operator remote control.</rdfs:comment>
        <rdfs:label xml:lang="en">issuedDateTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SwitchingAction.plannedDateTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#SwitchingAction.plannedDateTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#SwitchingAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Planned date and time of this switching step.</rdfs:comment>
        <rdfs:label xml:lang="en">plannedDateTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SwitchingPlan.purpose -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#SwitchingPlan.purpose">
