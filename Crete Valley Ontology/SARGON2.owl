    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#CsConverter.ratedIdc -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#CsConverter.ratedIdc">
