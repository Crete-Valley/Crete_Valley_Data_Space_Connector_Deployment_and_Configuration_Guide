        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Charge"/>
        <rdfs:comment>All charges levied on this account.</rdfs:comment>
        <rdfs:label xml:lang="en">Charges</rdfs:label>
        <rdfs:label>SupplierEnd</rdfs:label>
    </owl:ObjectProperty>
    


