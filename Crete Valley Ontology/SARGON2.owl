        <rdfs:label xml:lang="en">billEnd</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PassThroughBill.billRunType -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PassThroughBill.billRunType">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PassThroughBill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The settlement run type for example prelim final and rerun.</rdfs:comment>
        <rdfs:label xml:lang="en">billRunType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PassThroughBill.billStart -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PassThroughBill.billStart">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#PassThroughBill"/>
