        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Voltage"/>
        <rdfs:comment>Residual voltage during a current impulse with front time of 1 microsecond and magnitude equal to the nominal discharge current level.</rdfs:comment>
        <rdfs:label xml:lang="en">steepFrontDischargeVoltage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SurgeArresterInfo.switchingImpulseDischargeVoltage -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#SurgeArresterInfo.switchingImpulseDischargeVoltage">
