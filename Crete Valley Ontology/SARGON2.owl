        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#AuxiliaryAccount"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Transaction"/>
        <rdfs:comment>All payments against this account.</rdfs:comment>
        <rdfs:label xml:lang="en">PaymentTransactions</rdfs:label>
        <rdfs:label>SupplierEnd</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#AuxiliaryAccount.balance -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#AuxiliaryAccount.balance">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#AuxiliaryAccount"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Money"/>
        <rdfs:comment>The total amount currently remaining on this account that is required to be paid in order to settle the account to zero. This excludes any due amounts not yet paid.</rdfs:comment>
        <rdfs:label xml:lang="en">balance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#AuxiliaryAccount.due -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#AuxiliaryAccount.due">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#AuxiliaryAccount"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Due"/>
        <rdfs:comment>Current amounts now due for payment on this account.</rdfs:comment>
        <rdfs:label xml:lang="en">due</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#AuxiliaryAccount.lastCredit -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#AuxiliaryAccount.lastCredit">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#AuxiliaryAccount"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#AccountMovement"/>
        <rdfs:comment>Details of the last credit transaction performed on this account.</rdfs:comment>
        <rdfs:label xml:lang="en">lastCredit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#AuxiliaryAccount.lastDebit -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#AuxiliaryAccount.lastDebit">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#AuxiliaryAccount"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#AccountMovement"/>
        <rdfs:comment>Details of the last debit transaction performed on this account.</rdfs:comment>
        <rdfs:label xml:lang="en">lastDebit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#AuxiliaryAccount.principleAmount -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#AuxiliaryAccount.principleAmount">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#AuxiliaryAccount"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Money"/>
        <rdfs:comment>The initial principle amount with which this account was instantiated.</rdfs:comment>
        <rdfs:label xml:lang="en">principleAmount</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#AuxiliaryAgreement.AuxiliaryAccounts -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#AuxiliaryAgreement.AuxiliaryAccounts">
