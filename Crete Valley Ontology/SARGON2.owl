        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ConnectDisconnectFunction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>If set true the switch may disconnect the service at the end of a specified time delay after the disconnect signal has been given. If set false the switch may disconnect the service immediately after the disconnect signal has been given. This is typically the case for over current circuitbreakers which are classified as either instantaneous or slow acting.</rdfs:comment>
        <rdfs:label xml:lang="en">isDelayedDiscon</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#ConnectDisconnectFunction.isLocalAutoDisconOp -->

