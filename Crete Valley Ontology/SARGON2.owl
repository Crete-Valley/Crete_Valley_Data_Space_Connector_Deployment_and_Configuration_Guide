        <rdfs:label xml:lang="en">lastModified</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredResource.maxBaseSelfSchedQty -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#RegisteredResource.maxBaseSelfSchedQty">
