        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#TimeInterval"/>
        <rdfs:comment>Clock time interval for register to begingcease accumulating time of usage e.g. start at 800 am stop at 500 pm.</rdfs:comment>
        <rdfs:label xml:lang="en">touTier</rdfs:label>
    </owl:ObjectProperty>
    


