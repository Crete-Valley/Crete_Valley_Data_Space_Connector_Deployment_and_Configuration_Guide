        <rdfs:label xml:lang="en">ACT</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.iec.ch/TC57/CIM#MQSInstructionSource.INS -->

    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#MQSInstructionSource.INS">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#MQSInstructionSource"/>
        <rdfs:label xml:lang="en">INS</rdfs:label>
