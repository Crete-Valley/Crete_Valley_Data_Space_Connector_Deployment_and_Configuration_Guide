    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TimeSeries_merged">
        <owl:inverseOf rdf:resource="http://www.iec.ch/TC57/CIM#unit"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#AttributeInstanceComponent"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Auction"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#ConstraintDuration"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#DateAndOrTime"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Domain"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#EnvironmentalMonitoringStation"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#FlowDirection"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#MarketDocument"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#MarketEvaluationPoint"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#MarketObjectStatus"/>
