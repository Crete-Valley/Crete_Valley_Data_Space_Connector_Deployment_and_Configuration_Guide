    </owl:NamedIndividual>
    


    <!-- http://www.iec.ch/TC57/CIM#UnitSymbol.cosPhi -->

    <owl:NamedIndividual rdf:about="http://www.iec.ch/TC57/CIM#UnitSymbol.cosPhi">
        <rdf:type rdf:resource="http://www.iec.ch/TC57/CIM#UnitSymbol"/>
        <rdfs:comment>Power factor dimensionless.Note 1 This definition of power factor only holds for balanced systems. See the alternative definition under code 153.Note 2 Beware of differing sign conventions in use between the IEC and EEI. It is assumed that the data consumer understands the type of meter in use and the sign convention in use by the utility.</rdfs:comment>
        <rdfs:label xml:lang="en">cosPhi</rdfs:label>
    </owl:NamedIndividual>
    


