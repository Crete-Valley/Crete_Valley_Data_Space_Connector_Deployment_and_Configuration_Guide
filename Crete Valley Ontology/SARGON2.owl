        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#UnitRegulationKind"/>
        <rdfs:comment>Specifies if the unit is regulating or not regulating or expected to be regulating but is not.</rdfs:comment>
        <rdfs:label xml:lang="en">regulationFlag</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#RegisteredGenerator.regulationUpRampRate -->

