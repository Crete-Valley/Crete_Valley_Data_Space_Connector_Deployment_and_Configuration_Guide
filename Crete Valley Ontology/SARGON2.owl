        <rdfs:label xml:lang="en">frequencyBiasFactor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Hurricane.category -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Hurricane.category">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Hurricane"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The hurricanes category during the time interval using SaffirSimpson Hurricane Wind Scale a 1 to 5 rating based on a hurricanes sustained wind speed.</rdfs:comment>
        <rdfs:label xml:lang="en">category</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#HydroPowerPlant.penstockType -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#HydroPowerPlant.penstockType">
