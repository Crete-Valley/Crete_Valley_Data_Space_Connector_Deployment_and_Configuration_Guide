        <rdfs:label xml:lang="en">methodType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#Series.registrationDate -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#Series.registrationDate">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Series"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>For a market object the date of registration of a contract e.g. the date of change of supplier for a customer.</rdfs:comment>
        <rdfs:label xml:lang="en">registrationDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SeriesCompensator.varistorPresent -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#SeriesCompensator.varistorPresent">
