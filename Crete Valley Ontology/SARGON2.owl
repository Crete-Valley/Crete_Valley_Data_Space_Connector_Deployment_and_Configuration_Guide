        <rdfs:label xml:lang="en">MktPSRType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#MktPowerTransformer -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#MktPowerTransformer">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#PowerTransformer"/>
        <rdfs:comment>Subclass of IEC61970WiresPowerTransformer.</rdfs:comment>
        <rdfs:label xml:lang="en">MktPowerTransformer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#MktSeriesCompensator -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#MktSeriesCompensator">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#SeriesCompensator"/>
        <rdfs:comment>Subclass of IEC 61970WiresSeriesCompensator.</rdfs:comment>
        <rdfs:label xml:lang="en">MktSeriesCompensator</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#MktShuntCompensator -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#MktShuntCompensator">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#ShuntCompensator"/>
        <rdfs:comment>Subclass of IEC 61970WiresShuntCompensator.</rdfs:comment>
        <rdfs:label xml:lang="en">MktShuntCompensator</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#MktSubClassType -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#MktSubClassType">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:label xml:lang="en">MktSubClassType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#MktSwitch -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#MktSwitch">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Switch"/>
        <rdfs:comment>Subclass of IEC 61970WiresSwitch.</rdfs:comment>
        <rdfs:label xml:lang="en">MktSwitch</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#MktTapChanger -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#MktTapChanger">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#TapChanger"/>
        <rdfs:comment>Subclass of IEC 61970WiresTapChanger.</rdfs:comment>
        <rdfs:label xml:lang="en">MktTapChanger</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#MktTerminal -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#MktTerminal">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Terminal"/>
        <rdfs:comment>Subclass of IEC61970CoreTerminal.</rdfs:comment>
        <rdfs:label xml:lang="en">MktTerminal</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#MktThermalGeneratingUnit -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#MktThermalGeneratingUnit">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#ThermalGeneratingUnit"/>
        <rdfs:comment>Subclass of ThermalGeneratingUnit from Production Package in IEC 61970.</rdfs:comment>
        <rdfs:label xml:lang="en">MktThermalGeneratingUnit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#MktUserAttribute -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#MktUserAttribute">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#UserAttribute"/>
        <rdfs:comment>Subclass of IEC61968Domain2UserAttribute.</rdfs:comment>
        <rdfs:label xml:lang="en">MktUserAttribute</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ModelAuthority -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ModelAuthority">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>A Modeling Authority is an entity responsible for supplying and maintaining the data defining a specific set of objects in a network model.</rdfs:comment>
        <rdfs:label xml:lang="en">ModelAuthority</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ModelAuthoritySet -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ModelAuthoritySet">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>A Modeling Authority Set is a group of objects in a network model where the data is supplied and maintained by the same Modeling Authority.This class is typically not included in instance data exchange as this information is tracked by other mechanisms in the exchange.</rdfs:comment>
        <rdfs:label xml:lang="en">ModelAuthoritySet</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ModelFrameType -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ModelFrameType">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>Examples would be Boundary or Region type of frame.</rdfs:comment>
        <rdfs:label xml:lang="en">ModelFrameType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ModelOperation -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ModelOperation">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>An operation performed on models. </rdfs:comment>
        <rdfs:label xml:lang="en">ModelOperation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ModelOperationArg -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ModelOperationArg">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>Describes the role a dataset plays in a model operation.   The role is applicable only in the context of a single operation.</rdfs:comment>
        <rdfs:label xml:lang="en">ModelOperationArg</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ModelOperationArgDescription -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ModelOperationArgDescription">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>The type of custom operation dataset role for an operation description.</rdfs:comment>
        <rdfs:label xml:lang="en">ModelOperationArgDescription</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ModelOperationDescription -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ModelOperationDescription">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>The type of model operation.   This class is referenced by model operations and defines the kind of operation.</rdfs:comment>
        <rdfs:label xml:lang="en">ModelOperationDescription</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ModelOperationSequence -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ModelOperationSequence">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>A concrete sequence of operations.    For example this may be used to describe a specific audit trail a script or other specific set of actions on specific datasets.</rdfs:comment>
        <rdfs:label xml:lang="en">ModelOperationSequence</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ModelPartSpecification -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ModelPartSpecification">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>The type of model.  For example  state estimator planning planning dynamics short circuit or realtime dynamics etc.     The model must conform to a profile. </rdfs:comment>
        <rdfs:label xml:lang="en">ModelPartSpecification</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ModelPartVersion -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ModelPartVersion">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#ModelToBeDeleted"/>
        <rdfs:comment>This is a version of a part of a model.  New instances of this class with new identity are instantiated upon changes to the content of this class or changes to the associated data set.  Instances of this class are considered immutable.  The case audit trail can reference this immutable data to exactly reproduce a case.</rdfs:comment>
        <rdfs:label xml:lang="en">ModelPartVersion</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ModelToBeDeleted -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#ModelToBeDeleted">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>A Model is a collection of Datasets.</rdfs:comment>
        <rdfs:label xml:lang="en">ModelToBeDeleted</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#Money -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Money">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#CIMDatatype"/>
        <rdfs:comment>Amount of money.</rdfs:comment>
        <rdfs:label xml:lang="en">Money</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#MonthDay -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#MonthDay">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Primitive"/>
        <rdfs:comment>MonthDay format as mmdd which conforms with XSD data type gMonthDay.</rdfs:comment>
        <rdfs:label xml:lang="en">MonthDay</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#MonthDayInterval -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#MonthDayInterval">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Compound"/>
        <rdfs:comment>Interval between two times specified as month and day.</rdfs:comment>
        <rdfs:label xml:lang="en">MonthDayInterval</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#MutualCoupling -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#MutualCoupling">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>This class represents the zero sequence line mutual coupling.</rdfs:comment>
        <rdfs:label xml:lang="en">MutualCoupling</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#Name -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Name">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Toplevel"/>
        <rdfs:comment>The Name class provides the means to define any number of human readable  names for an object. A name is bnotb to be used for defining interobject relationships. For interobject relationships instead use the object identification mRID.</rdfs:comment>
        <rdfs:label xml:lang="en">Name</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NameType -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NameType">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Toplevel"/>
        <rdfs:comment>Type of name. Possible values for attribute name are implementation dependent but standard profiles may specify types. An enterprise may have multiple IT systems each having its own local name for the same object e.g. a planning system may have different names from an EMS. An object may also have different names within the same IT system e.g. localName as defined in CIM version 14. The definition from CIM14 isThe localName is a human readable name of the object. It is a free text name local to a node in a naming hierarchy similar to a file directory structure. A power system related naming hierarchy may be Substation VoltageLevel Equipment etc. Children of the same parent in such a hierarchy have names that typically are unique among them.</rdfs:comment>
        <rdfs:label xml:lang="en">NameType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NameTypeAuthority -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NameTypeAuthority">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Toplevel"/>
        <rdfs:comment>Authority responsible for creation and management of names of a given type typically an organization or an enterprise system.</rdfs:comment>
        <rdfs:label xml:lang="en">NameTypeAuthority</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NetworkBoundary -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NetworkBoundary">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#FrameworkPart"/>
        <rdfs:comment>A framework part that is a boundary between 2 frames.</rdfs:comment>
        <rdfs:label xml:lang="en">NetworkBoundary</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NetworkFrame -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NetworkFrame">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#FrameworkPart"/>
        <rdfs:comment>A region isolated by boundaries.</rdfs:comment>
        <rdfs:label xml:lang="en">NetworkFrame</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NetworkModelCaseDefinition -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NetworkModelCaseDefinition">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Toplevel"/>
        <rdfs:comment>Instructions to build a network model case including when appropriate the results. </rdfs:comment>
        <rdfs:label xml:lang="en">NetworkModelCaseDefinition</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NetworkModelProject -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NetworkModelProject">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#NetworkModelProjectComponent"/>
        <rdfs:comment>A grouping of network model change descriptions.  Primarily used to organize the phases of an overall project. </rdfs:comment>
        <rdfs:label xml:lang="en">NetworkModelProject</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NetworkModelProject2 -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NetworkModelProject2">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#NetworkModelProjectComponent2"/>
        <rdfs:label xml:lang="en">NetworkModelProject2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NetworkModelProjectChange -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NetworkModelProjectChange">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#NetworkModelProjectComponent"/>
        <rdfs:comment>Network model project change described by versions of an associated change set.  Has persistent identity over multiple versions of the associated change set. </rdfs:comment>
        <rdfs:label xml:lang="en">NetworkModelProjectChange</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NetworkModelProjectChangeVersion -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NetworkModelProjectChangeVersion">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>Describes the status and the planned implementation of the associated change set into the asbuilt model.    New instances of this class with new identity are instantiated upon changes to the content of this class or changes to the associated change set.  Instances of this class are considered immutable.  The case audit trail can reference this immutable data to exactly reproduce a case.</rdfs:comment>
        <rdfs:label xml:lang="en">NetworkModelProjectChangeVersion</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NetworkModelProjectCollection -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NetworkModelProjectCollection">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Toplevel"/>
        <rdfs:label xml:lang="en">NetworkModelProjectCollection</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NetworkModelProjectComponent -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NetworkModelProjectComponent">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>Abstract class for both a network model project and network model change.</rdfs:comment>
        <rdfs:label xml:lang="en">NetworkModelProjectComponent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NetworkModelProjectComponent2 -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NetworkModelProjectComponent2">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:label xml:lang="en">NetworkModelProjectComponent2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NetworkModelProjectDocument -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NetworkModelProjectDocument">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Toplevel"/>
        <rdfs:label xml:lang="en">NetworkModelProjectDocument</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NetworkModelProjectRelationship -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NetworkModelProjectRelationship">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>A relationship that assists humans and software building cases by assembling project changes in the correct sequence.  This class may be specialized to create specific types of relationships.</rdfs:comment>
        <rdfs:label xml:lang="en">NetworkModelProjectRelationship</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NetworkModelProjectStage -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NetworkModelProjectStage">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#NetworkModelProjectComponent2"/>
        <rdfs:label xml:lang="en">NetworkModelProjectStage</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NetworkModelProjectState -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NetworkModelProjectState">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#IdentifiedObject"/>
        <rdfs:comment>A network model project version state.  States are agreed upon by the exchange community.  Examples are approved proposed withdrawn committed etc.</rdfs:comment>
        <rdfs:label xml:lang="en">NetworkModelProjectState</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NoLoadTest -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NoLoadTest">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#TransformerTest"/>
        <rdfs:comment>Noload test results determine core admittance parameters. They include exciting current and core loss measurements from applying voltage to one winding. The excitation may be positive sequence or zero sequence. The test may be repeated at different voltages to measure saturation.</rdfs:comment>
        <rdfs:label xml:lang="en">NoLoadTest</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NodeConstraintTerm -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NodeConstraintTerm">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#ConstraintTerm"/>
        <rdfs:comment>To be used only to constrain a quantity that cannot be associated with a terminal. For example a registered generating unit that is not electrically connected to the network.</rdfs:comment>
        <rdfs:label xml:lang="en">NodeConstraintTerm</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NonConformLoad -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NonConformLoad">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#EnergyConsumer"/>
        <rdfs:comment>NonConformLoad represents loads that do not follow a daily load change pattern and whose changes are not correlated with the daily load change pattern.</rdfs:comment>
        <rdfs:label xml:lang="en">NonConformLoad</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NonConformLoadGroup -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NonConformLoadGroup">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#LoadGroup"/>
        <rdfs:comment>Loads that do not follow a daily and seasonal load variation pattern.</rdfs:comment>
        <rdfs:label xml:lang="en">NonConformLoadGroup</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NonConformLoadSchedule -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NonConformLoadSchedule">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#SeasonDayTypeSchedule"/>
        <rdfs:comment>An active power Y1axis and reactive power Y2axis schedule curves versus time Xaxis for nonconforming loads e.g. large industrial load or power station service where modelled.</rdfs:comment>
        <rdfs:label xml:lang="en">NonConformLoadSchedule</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NonStandardItem -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NonStandardItem">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#WorkDocument"/>
        <rdfs:comment>This document provides information for nonstandard items like customer contributions e.g. customer digs trench vouchers e.g. credit and contractor bids. </rdfs:comment>
        <rdfs:label xml:lang="en">NonStandardItem</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NonlinearShuntCompensator -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NonlinearShuntCompensator">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#ShuntCompensator"/>
        <rdfs:comment>A non linear shunt compensator has bank or section admittance values that differ. The attributes g b g0 and b0 of the associated NonlinearShuntCompensatorPoint describe the total conductance and admittance of a NonlinearShuntCompensatorPoint at a section number specified by NonlinearShuntCompensatorPoint.sectionNumber.</rdfs:comment>
        <rdfs:label xml:lang="en">NonlinearShuntCompensator</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NonlinearShuntCompensatorPhase -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NonlinearShuntCompensatorPhase">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#ShuntCompensatorPhase"/>
        <rdfs:comment>A per phase non linear shunt compensator has bank or section admittance values that differ. The attributes g and b of the associated NonlinearShuntCompensatorPhasePoint describe the total conductance and admittance of a NonlinearShuntCompensatorPhasePoint at a section number specified by NonlinearShuntCompensatorPhasePoint.sectionNumber.</rdfs:comment>
        <rdfs:label xml:lang="en">NonlinearShuntCompensatorPhase</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NonlinearShuntCompensatorPhasePoint -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#NonlinearShuntCompensatorPhasePoint">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Toplevel"/>
        <rdfs:comment>A per phase non linear shunt compensator bank or section admittance value. The number of NonlinearShuntCompenstorPhasePoint instances associated with a NonlinearShuntCompensatorPhase shall be equal to ShuntCompensatorPhase.maximumSections. ShuntCompensator.sections shall only be set to one of the NonlinearShuntCompenstorPhasePoint.sectionNumber. There is no interpolation between NonlinearShuntCompenstorPhasePoints.</rdfs:comment>
        <rdfs:label xml:lang="en">NonlinearShuntCompensatorPhasePoint</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#NonlinearShuntCompensatorPoint -->

