        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date tariff was activated.</rdfs:comment>
        <rdfs:label xml:lang="en">startDate</rdfs:label>
    </owl:DatatypeProperty>
    


