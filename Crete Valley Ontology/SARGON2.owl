        <rdfs:label xml:lang="en">CSCDynamics</rdfs:label>
        <rdfs:label>ClientEnd</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#CsConverter.alpha -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#CsConverter.alpha">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#CsConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#AngleDegrees"/>
        <rdfs:comment>Firing angle that determines the dc voltage at the converter dc terminal. Typical value between 10 degrees and 18 degrees for a rectifier. It is converters state variable result from power flow. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">alpha</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#CsConverter.gamma -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#CsConverter.gamma">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#CsConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#AngleDegrees"/>
        <rdfs:comment>Extinction angle. It is used to limit the dc voltage at the inverter if needed. Typical value between 17 degrees and 20 degrees for an inverter. It is converters state variable result from power flow. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">gamma</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#CsConverter.maxAlpha -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#CsConverter.maxAlpha">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#CsConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#AngleDegrees"/>
        <rdfs:comment>Maximum firing angle. It is converters configuration data used in power flow. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">maxAlpha</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#CsConverter.maxGamma -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#CsConverter.maxGamma">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#CsConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#AngleDegrees"/>
        <rdfs:comment>Maximum extinction angle. It is converters configuration data used in power flow. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">maxGamma</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#CsConverter.maxIdc -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#CsConverter.maxIdc">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#CsConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#CurrentFlow"/>
        <rdfs:comment>The maximum direct current Id on the DC side at which the converter should operate. It is converters configuration data use in power flow. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">maxIdc</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#CsConverter.minAlpha -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#CsConverter.minAlpha">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#CsConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#AngleDegrees"/>
        <rdfs:comment>Minimum firing angle. It is converters configuration data used in power flow. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">minAlpha</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#CsConverter.minGamma -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#CsConverter.minGamma">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#CsConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#AngleDegrees"/>
        <rdfs:comment>Minimum extinction angle. It is converters configuration data used in power flow. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">minGamma</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#CsConverter.minIdc -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#CsConverter.minIdc">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#CsConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#CurrentFlow"/>
        <rdfs:comment>The minimum direct current Id on the DC side at which the converter should operate. It is converters configuration data used in power flow. The attribute shall be a positive value.</rdfs:comment>
        <rdfs:label xml:lang="en">minIdc</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#CsConverter.operatingMode -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#CsConverter.operatingMode">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#CsConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#CsOperatingModeKind"/>
        <rdfs:comment>Indicates whether the DC pole is operating as an inverter or as a rectifier. It is converters control variable used in power flow.</rdfs:comment>
        <rdfs:label xml:lang="en">operatingMode</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#CsConverter.pPccControl -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#CsConverter.pPccControl">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#CsConverter"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#CsPpccControlKind"/>
        <rdfs:comment>Kind of active power control.</rdfs:comment>
