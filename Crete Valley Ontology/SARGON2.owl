    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#PanPricingDetail.registerTier -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#PanPricingDetail.registerTier">
