        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Voltage"/>
        <rdfs:comment>The temporary overvoltage TOV level at power frequency that the surge arrester withstands for 10 seconds.</rdfs:comment>
        <rdfs:label xml:lang="en">ratedVoltage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SurgeArresterInfo.steepFrontDischargeVoltage -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#SurgeArresterInfo.steepFrontDischargeVoltage">
