    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#CoverageCodeKind">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Enumeration"/>
        <rdfs:comment>Kinds of weather condition coverage.</rdfs:comment>
        <rdfs:label xml:lang="en">CoverageCodeKind</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#Craft -->

    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Craft">
