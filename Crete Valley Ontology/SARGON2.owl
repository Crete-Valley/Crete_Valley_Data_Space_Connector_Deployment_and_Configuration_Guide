        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#CurrentFlow"/>
        <rdfs:comment>The lightning discharge current used to classify the arrester. Choices are limited to 1.5 2.5 5 10 and 20 kA by IEC 60099.</rdfs:comment>
        <rdfs:label xml:lang="en">nominalDischargeCurrent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SurgeArresterInfo.pressureReliefClass -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#SurgeArresterInfo.pressureReliefClass">
