    <owl:Class rdf:about="http://www.iec.ch/TC57/CIM#Cheque">
        <rdfs:subClassOf rdf:resource="http://www.iec.ch/TC57/CIM#Toplevel"/>
        <rdfs:comment>The actual tender when it is a type of cheque.</rdfs:comment>
        <rdfs:label xml:lang="en">Cheque</rdfs:label>
    </owl:Class>
    


    <!-- http://www.iec.ch/TC57/CIM#ChequeKind -->

