        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Seconds"/>
        <rdfs:comment>Time step related to activation of controls ideltatci gt 0.  Typical value  0025 003 for 50 Hz.</rdfs:comment>
        <rdfs:comment>Time step related to activation of controls ideltatci gt 0.  Typical value  0025.</rdfs:comment>
        <rdfs:label xml:lang="en">dtc</rdfs:label>
    </owl:ObjectProperty>
    


