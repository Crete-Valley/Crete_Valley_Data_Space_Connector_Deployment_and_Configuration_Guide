        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Reason"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TimeSeries"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#Period"/>
        <rdfs:label>ClientEnd</rdfs:label>
        <rdfs:label xml:lang="en">Period</rdfs:label>
        <rdfs:label>SupplierEnd</rdfs:label>
    </owl:ObjectProperty>
    


