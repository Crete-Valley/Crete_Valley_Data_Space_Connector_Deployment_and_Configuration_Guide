        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#OldCrew"/>
        <rdfs:label>ClientEnd</rdfs:label>
        <rdfs:label xml:lang="en">Crews</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#CrossCompoundTurbineGovernorDynamics.HighPressureSynchronousMachineDynamics -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#CrossCompoundTurbineGovernorDynamics.HighPressureSynchronousMachineDynamics">
