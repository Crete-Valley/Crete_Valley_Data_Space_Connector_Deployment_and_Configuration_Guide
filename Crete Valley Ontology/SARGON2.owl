    <!-- http://www.iec.ch/TC57/CIM#TimeTariffInterval.ConsumptionTariffIntervals -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TimeTariffInterval.ConsumptionTariffIntervals">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TimeTariffInterval"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#ConsumptionTariffInterval"/>
