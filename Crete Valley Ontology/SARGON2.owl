    </owl:DatatypeProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#SafetyDocument.releasedDateTime -->

    <owl:DatatypeProperty rdf:about="http://www.iec.ch/TC57/CIM#SafetyDocument.releasedDateTime">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#SafetyDocument"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Date and time this safety document has been released.</rdfs:comment>
        <rdfs:label xml:lang="en">releasedDateTime</rdfs:label>
    </owl:DatatypeProperty>
    


