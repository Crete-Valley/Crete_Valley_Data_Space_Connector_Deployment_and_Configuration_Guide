        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Quantity"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Reason"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#RegisteredResource"/>
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#Unit"/>
