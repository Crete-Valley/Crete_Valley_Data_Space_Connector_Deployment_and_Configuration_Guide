        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TopologicalIsland"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#TopologicalNode"/>
        <rdfs:comment>A topological node belongs to a topological island.</rdfs:comment>
        <rdfs:label>ClientEnd</rdfs:label>
        <rdfs:label xml:lang="en">TopologicalNodes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.iec.ch/TC57/CIM#TopologicalNode.AngleRefTopologicalIsland -->

    <owl:ObjectProperty rdf:about="http://www.iec.ch/TC57/CIM#TopologicalNode.AngleRefTopologicalIsland">
        <rdfs:domain rdf:resource="http://www.iec.ch/TC57/CIM#TopologicalNode"/>
        <rdfs:range rdf:resource="http://www.iec.ch/TC57/CIM#TopologicalIsland"/>
        <rdfs:comment>The island for which the node is an angle reference.   Normally there is one angle reference node for each island.</rdfs:comment>
        <rdfs:label xml:lang="en">AngleRefTopologicalIsland</rdfs:label>
        <rdfs:label>ClientEnd</rdfs:label>
    </owl:ObjectProperty>
    


