                          rdfs:label "accumulation"@en ,
                                     "{64DB8EA4-3709-455f-87D3-D2B76C275464}"@guid .


###  http://www.iec.ch/TC57/CIM#ReadingType.aggregate
:ReadingType.aggregate rdf:type owl:ObjectProperty ;
                       rdfs:domain :ReadingType ;
                       rdfs:range :AggregateKind ;
                       rdfs:comment "Salient attribute of the reading data aggregated from individual endpoints. This is mainly used to define a mathematical operation carried out over macroPeriod but may also be used to describe an attribute of the data when the macroPeriod is not defined." ;
                       rdfs:label "aggregate"@en ,
                                  "{4BCF265A-A069-46f1-AD91-840831A1CC69}"@guid .


###  http://www.iec.ch/TC57/CIM#ReadingType.argument
:ReadingType.argument rdf:type owl:ObjectProperty ;
                      rdfs:domain :ReadingType ;
                      rdfs:range :RationalNumber ;
                      rdfs:comment "Argument used to introduce numbers into the unit of measure description where they are needed e.g. 4 where the measure needs an argument such as CEMIn4. Most arguments used in practice however will be integers i.e. denominator1.Value 0 in numerator and denominator means not applicable." ;
                      rdfs:label "argument"@en ,
                                 "{F9EEB80B-15E0-443a-9A33-175857305C35}"@guid .


