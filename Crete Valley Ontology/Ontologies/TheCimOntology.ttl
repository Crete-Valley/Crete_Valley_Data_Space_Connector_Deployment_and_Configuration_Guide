:TransformerConstructionKind rdf:type owl:Class ;
                             rdfs:subClassOf :Enumeration ;
                             rdfs:comment "Kind of transformer construction." ;
                             rdfs:label "TransformerConstructionKind"@en ,
                                        "{5FDFF2F1-83A7-4a56-9ACA-6B15F6866D49}"@guid .


