###  http://www.iec.ch/TC57/CIM#ACDCConverterDCTerminal.polarity
:ACDCConverterDCTerminal.polarity rdf:type owl:ObjectProperty ;
                                  rdfs:domain :ACDCConverterDCTerminal ;
                                  rdfs:range :DCPolarityKind ;
                                  rdfs:comment "Represents the normal network polarity condition. Depending on the converter configuration the value shall be set as follows For a monopole with two converter terminals use DCPolarityKind positive and negative. For a bipole or symmetric monopole with three converter terminals use DCPolarityKind positive middle and negative." ;
                                  rdfs:label "polarity"@en ,
                                             "{48F3E203-BD33-4146-B839-2EC1080B0020}"@guid .


###  http://www.iec.ch/TC57/CIM#ACDCTerminal.BusNameMarker
:ACDCTerminal.BusNameMarker rdf:type owl:ObjectProperty ;
                            owl:inverseOf :BusNameMarker.Terminal ;
                            rdfs:domain :ACDCTerminal ;
                            rdfs:range :BusNameMarker ;
