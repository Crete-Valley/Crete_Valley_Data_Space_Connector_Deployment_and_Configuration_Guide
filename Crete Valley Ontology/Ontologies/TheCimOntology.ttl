:EndDeviceCapability rdf:type owl:Class ;
                     rdfs:subClassOf :Compound ;
                     rdfs:comment "Inherent capabilities of an end device i.e. the functions it supports." ;
                     rdfs:label "EndDeviceCapability"@en ,
                                "{27FAE402-A373-4580-83D4-4EF96A4F374D}"@guid .


