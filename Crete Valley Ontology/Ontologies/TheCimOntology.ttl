:EnergyTypeKind rdf:type owl:Class ;
                rdfs:subClassOf :Enumeration ;
                rdfs:label "EnergyTypeKind"@en ,
                           "{1D7EE73C-8476-40c6-B2B9-10BA57199D7A}"@guid .


