                         rdfs:comment "Measurement value is beyond a predefined range of value." ;
                         rdfs:label "outOfRange"@en ,
                                    "{36E6C225-3F42-446f-873B-7CBAB71DE307}"@guid .


###  http://www.iec.ch/TC57/CIM#Quality61850.overFlow
:Quality61850.overFlow rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Quality61850 ;
                       rdfs:range xsd:boolean ;
                       rdfs:comment "Measurement value is beyond the capability of being  represented properly. For example a counter value overflows from maximum count back to a value of zero. " ;
