              rdfs:label "DateInterval"@en ,
                         "{28B6A229-F6A8-4d93-BD50-F337824B5C8F}"@guid .


###  http://www.iec.ch/TC57/CIM#DateTime
:DateTime rdf:type owl:Class ;
          rdfs:subClassOf :Primitive ;
          rdfs:comment "Date and time as yyyymmddThhmmss.sss which conforms with ISO 8601. UTC time zone is specified as yyyymmddThhmmss.sssZ. A local timezone relative UTC is specified as yyyymmddThhmmss.ssshhmm. The second component shown here as ss.sss could have any number of digits in its fractional part to allow any kind of precision beyond seconds." ;
          rdfs:label "DateTime"@en ,
                     "{EEAE6E83-944C-489c-8E25-CFB85F80C3EB}"@guid .


