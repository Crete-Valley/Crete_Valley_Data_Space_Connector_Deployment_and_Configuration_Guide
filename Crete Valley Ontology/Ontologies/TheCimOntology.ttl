                      rdfs:subClassOf :AggregateNode ;
                      rdfs:comment "A specialized class of type AggregatedNode type. Defines Load Aggregation Points." ;
                      rdfs:label "LoadAggregationPoint"@en ,
                                 "{023C46A0-57C3-4ebe-97D0-FFFD80D7B619}"@guid .


