###  http://www.iec.ch/TC57/CIM#PhaseTapChangerAsymmetrical.windingConnectionAngle
:PhaseTapChangerAsymmetrical.windingConnectionAngle rdf:type owl:ObjectProperty ;
                                                    rdfs:domain :PhaseTapChangerAsymmetrical ;
                                                    rdfs:range :AngleDegrees ;
                                                    rdfs:comment "The phase angle between the inphase winding and the outof phase winding used for creating phase shift. The outofphase winding produces what is known as the difference voltage.  Setting this angle to 90 degrees is not the same as a symmetrical transformer. The attribute can only be multiples of 30 degrees.  The allowed range is 150 degrees to 150 degrees excluding 0." ;
                                                    rdfs:label "windingConnectionAngle"@en ,
                                                               "{73F12408-9962-4614-8F76-9276D859E042}"@guid .


###  http://www.iec.ch/TC57/CIM#PhaseTapChangerLinear.stepPhaseShiftIncrement
:PhaseTapChangerLinear.stepPhaseShiftIncrement rdf:type owl:ObjectProperty ;
                                               rdfs:domain :PhaseTapChangerLinear ;
                                               rdfs:range :AngleDegrees ;
                                               rdfs:comment "Phase shift per step position. A positive value indicates a positive angle variation from the Terminal at the  PowerTransformerEnd  where the TapChanger is located into the transformer.The actual phase shift increment might be more accurately computed from the symmetrical or asymmetrical models or a tap step table lookup if those are available." ;
                                               rdfs:label "stepPhaseShiftIncrement"@en ,
                                                          "{0A0AF042-84CF-4e48-996A-60122C60C8C7}"@guid .


###  http://www.iec.ch/TC57/CIM#PhaseTapChangerLinear.xMax
:PhaseTapChangerLinear.xMax rdf:type owl:ObjectProperty ;
                            rdfs:domain :PhaseTapChangerLinear ;
                            rdfs:range :Reactance ;
                            rdfs:comment "The reactance depends on the tap position according to a u shaped curve. The maximum reactance xMax appears at the low and high tap positions. Depending on the u curve the attribute can be either higher or lower than PowerTransformerEnd.x." ;
                            rdfs:label "xMax"@en ,
                                       "{03CCD0FC-F097-4b6c-B818-30E1C538B4CC}"@guid .


###  http://www.iec.ch/TC57/CIM#PhaseTapChangerLinear.xMin
:PhaseTapChangerLinear.xMin rdf:type owl:ObjectProperty ;
                            rdfs:domain :PhaseTapChangerLinear ;
                            rdfs:range :Reactance ;
                            rdfs:comment "The reactance depends on the tap position according to a u shaped curve. The minimum reactance xMin appears at the mid tap position.  PowerTransformerEnd.x shall be consistent with PhaseTapChangerLinear.xMin and PhaseTapChangerNonLinear.xMin. In case of inconsistency PowerTransformerEnd.x shall be used." ;
                            rdfs:label "xMin"@en ,
                                       "{E65A4D9F-3409-4701-BCFA-927E64603CC6}"@guid .


###  http://www.iec.ch/TC57/CIM#PhaseTapChangerNonLinear.voltageStepIncrement
:PhaseTapChangerNonLinear.voltageStepIncrement rdf:type owl:ObjectProperty ;
                                               rdfs:domain :PhaseTapChangerNonLinear ;
                                               rdfs:range :PerCent ;
                                               rdfs:comment "The voltage step increment on the out of phase winding the PowerTransformerEnd where the TapChanger is located specified in percent of rated voltage of the PowerTransformerEnd. A positive value means a positive voltage variation from the Terminal at the PowerTransformerEnd where the TapChanger is located into the transformer.When the increment is negative the voltage decreases when the tap step increases." ;
                                               rdfs:label "voltageStepIncrement"@en ,
                                                          "{5CB8CF11-E238-4e2b-A64C-4D6F353E8BD7}"@guid .


###  http://www.iec.ch/TC57/CIM#PhaseTapChangerNonLinear.xMax
:PhaseTapChangerNonLinear.xMax rdf:type owl:ObjectProperty ;
                               rdfs:domain :PhaseTapChangerNonLinear ;
                               rdfs:range :Reactance ;
                               rdfs:comment "The reactance depends on the tap position according to a u shaped curve. The maximum reactance xMax appears at the low and high tap positions. Depending on the u curve the attribute can be either higher or lower than PowerTransformerEnd.x." ;
                               rdfs:label "xMax"@en ,
                                          "{85F2E96A-037E-49cb-A502-52D5D496ECBF}"@guid .


###  http://www.iec.ch/TC57/CIM#PhaseTapChangerNonLinear.xMin
:PhaseTapChangerNonLinear.xMin rdf:type owl:ObjectProperty ;
                               rdfs:domain :PhaseTapChangerNonLinear ;
                               rdfs:range :Reactance ;
                               rdfs:comment "The reactance depend on the tap position according to a u shaped curve. The minimum reactance xMin appear at the mid tap position.   PowerTransformerEnd.x shall be consistent with PhaseTapChangerLinear.xMin and PhaseTapChangerNonLinear.xMin. In case of inconsistency PowerTransformerEnd.x shall be used." ;
                               rdfs:label "xMin"@en ,
                                          "{0E3B5325-2A89-476d-9A79-CD4ACD14C5FE}"@guid .


