                            rdfs:domain :PetersenCoil ;
                            rdfs:range :CurrentFlow ;
                            rdfs:comment "The offset current that the Petersen coil controller is operating from the resonant point.  This is normally a fixed amount for which the controller is configured and could be positive or negative.  Typically 0 to 60 A depending on voltage and resonance conditions." ;
                            rdfs:label "offsetCurrent"@en ,
