                                        rdfs:domain :PowerTransformer ;
                                        rdfs:range :Voltage ;
                                        rdfs:comment "The minimum operating voltage uQmin in IEC 609090 at the high voltage side Q side of the unit transformer of the power station unit. A value well established from longterm operating experience of the system. It is used for calculation of the impedance correction factor KG defined in IEC 609090." ;
                                        rdfs:label "highSideMinOperatingU"@en ,
                                                   "{B621D953-1CCB-4d6e-AE7D-6231CCE96831}"@guid .


