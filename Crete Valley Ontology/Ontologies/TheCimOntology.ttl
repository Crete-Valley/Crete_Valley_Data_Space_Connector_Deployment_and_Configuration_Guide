:EnergyTypeReference rdf:type owl:Class ;
                     rdfs:subClassOf :IdentifiedObject ;
                     rdfs:label "EnergyTypeReference"@en ,
                                "{235A7C92-A579-44fb-BDF1-7741E42009B3}"@guid .


