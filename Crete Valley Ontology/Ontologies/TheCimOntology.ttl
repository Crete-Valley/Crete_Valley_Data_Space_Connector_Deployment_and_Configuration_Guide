                                 :MacroPeriodKind ;
                        rdfs:comment "Weekly period starting at midnight on the first day of the week and ending the instant before midnight the last day of the week. If within the current week it specifies the period from the start of the week until now." ;
                        rdfs:label "weekly"@en ,
                                   "{DCA2FC51-06DF-4c01-8B48-D0856FB531B5}"@guid .


