###  http://www.iec.ch/TC57/CIM#CsConverter.alpha
:CsConverter.alpha rdf:type owl:ObjectProperty ;
                   rdfs:domain :CsConverter ;
                   rdfs:range :AngleDegrees ;
                   rdfs:comment "Firing angle that determines the dc voltage at the converter dc terminal. Typical value between 10 degrees and 18 degrees for a rectifier. It is converters state variable result from power flow. The attribute shall be a positive value." ;
                   rdfs:label "alpha"@en ,
                              "{9D272F46-EABD-436f-9B05-3AB954FEB505}"@guid .


###  http://www.iec.ch/TC57/CIM#CsConverter.gamma
:CsConverter.gamma rdf:type owl:ObjectProperty ;
                   rdfs:domain :CsConverter ;
                   rdfs:range :AngleDegrees ;
                   rdfs:comment "Extinction angle. It is used to limit the dc voltage at the inverter if needed. Typical value between 17 degrees and 20 degrees for an inverter. It is converters state variable result from power flow. The attribute shall be a positive value." ;
                   rdfs:label "gamma"@en ,
                              "{B9AD7780-6511-4795-8FF2-0797C537AF64}"@guid .


