                        rdfs:domain :TapChangerTablePoint ;
                        rdfs:range :PerCent ;
                        rdfs:comment "The magnetizing branch conductance deviation as a percentage of nominal value. The actual conductance is calculated as followscalculated magnetizing conductance  gnominal  1  gfrom this class100.   The gnominal is defined as the static magnetizing conductance on the associated power transformer end or ends.  This model assumes the star impedance pi model form." ;
                        rdfs:label "g"@en ,
                                   "{F33BB85C-0624-4ff6-BA15-DBDA563BB4FB}"@guid .


