:ERTConfidenceKind rdf:type owl:Class ;
                   rdfs:subClassOf :Enumeration ;
                   rdfs:comment "The estimated time of restoration can have a confidence factor applied such as high or low confidence that the ERT will be accomplished.  This confidence factor may be updated as needed during the outage period  just as the actual ERT can be updated." ;
                   rdfs:label "ERTConfidenceKind"@en ,
                              "{F71CD8B5-221E-4900-B9AF-51866AC236F1}"@guid .


###  http://www.iec.ch/TC57/CIM#EarthFaultCompensator
:EarthFaultCompensator rdf:type owl:Class ;
                       rdfs:subClassOf :ConductingEquipment ;
                       rdfs:comment "A conducting equipment used to represent a connection to ground which is typically used to compensate earth faults.   An earth fault compensator device modelled with a single terminal implies a second terminal solidly connected to ground.  If two terminals are modelled the ground is not assumed and normal connection rules apply." ;
                       rdfs:label "EarthFaultCompensator"@en ,
                                  "{99B51F43-C935-4382-AB8A-6352DAB082D4}"@guid .


