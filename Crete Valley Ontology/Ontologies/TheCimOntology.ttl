                                :MacroPeriodKind ;
                       rdfs:comment "Daily period starting at midnight. If for the current day this specifies the time from midnight to now." ;
                       rdfs:label "daily"@en ,
                                  "{6C5410FE-15C4-45e4-8A0E-82A4096B2755}"@guid .


