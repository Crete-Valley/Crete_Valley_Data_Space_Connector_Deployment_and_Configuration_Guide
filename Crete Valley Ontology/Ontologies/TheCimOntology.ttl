:EnergyTypeCode rdf:type owl:Class ;
                rdfs:subClassOf :Enumeration ;
                rdfs:comment "Valid Enumerations1 DASE Day Ahead Scheduled Energy 2 DSSE Day Ahead Incremental Self Schedule Energy 3 DABE Day Ahead Incremental Energy Bid Awarded Energy 4 OE Optimal Energy 5 HASE Hour ahead predispatched schedule energy 6 SRE Standard Ramping Energy 7 RED Ramping Energy Deviation 8 EDE Exceptional Dispatch energy 9 RMRE RMR Energy 10 MSSLFE MSSLF Energy 11 RE Residual Energy 12 MLE Minimum Load Energy 13 SE SLIC Energy 14 RTSSE Real time self scheduled energy 15 DMLE Day ahead minimum load energy 16 PE Pumping Energy 17 TEE Total Expected Energy 18 DAPE  DayAhead Pumping Energy" ;
                rdfs:label "EnergyTypeCode"@en ,
                           "{98177A18-B8A3-4699-81EE-65B36F1E4F97}"@guid .


