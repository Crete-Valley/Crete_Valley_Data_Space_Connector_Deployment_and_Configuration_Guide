###  http://www.iec.ch/TC57/CIM#NonlinearShuntCompensator
:NonlinearShuntCompensator rdf:type owl:Class ;
                           rdfs:subClassOf :ShuntCompensator ;
                           rdfs:comment "A non linear shunt compensator has bank or section admittance values that differ. The attributes g b g0 and b0 of the associated NonlinearShuntCompensatorPoint describe the total conductance and admittance of a NonlinearShuntCompensatorPoint at a section number specified by NonlinearShuntCompensatorPoint.sectionNumber." ;
                           rdfs:label "NonlinearShuntCompensator"@en ,
                                      "{111DB4FF-7967-4eb5-AABE-CDA0EA065CF8}"@guid .


###  http://www.iec.ch/TC57/CIM#NonlinearShuntCompensatorPhase
:NonlinearShuntCompensatorPhase rdf:type owl:Class ;
                                rdfs:subClassOf :ShuntCompensatorPhase ;
                                rdfs:comment "A per phase non linear shunt compensator has bank or section admittance values that differ. The attributes g and b of the associated NonlinearShuntCompensatorPhasePoint describe the total conductance and admittance of a NonlinearShuntCompensatorPhasePoint at a section number specified by NonlinearShuntCompensatorPhasePoint.sectionNumber." ;
                                rdfs:label "NonlinearShuntCompensatorPhase"@en ,
                                           "{178D630D-8883-41d1-BFE0-81BFD2B70087}"@guid .


###  http://www.iec.ch/TC57/CIM#NonlinearShuntCompensatorPhasePoint
:NonlinearShuntCompensatorPhasePoint rdf:type owl:Class ;
                                     rdfs:subClassOf :Toplevel ;
                                     rdfs:comment "A per phase non linear shunt compensator bank or section admittance value. The number of NonlinearShuntCompenstorPhasePoint instances associated with a NonlinearShuntCompensatorPhase shall be equal to ShuntCompensatorPhase.maximumSections. ShuntCompensator.sections shall only be set to one of the NonlinearShuntCompenstorPhasePoint.sectionNumber. There is no interpolation between NonlinearShuntCompenstorPhasePoints." ;
                                     rdfs:label "NonlinearShuntCompensatorPhasePoint"@en ,
                                                "{44BDEBB6-4580-4df6-9245-179240EB5058}"@guid .


###  http://www.iec.ch/TC57/CIM#NonlinearShuntCompensatorPoint
:NonlinearShuntCompensatorPoint rdf:type owl:Class ;
                                rdfs:subClassOf :Toplevel ;
                                rdfs:comment "A non linear shunt compensator bank or section admittance value. The number of NonlinearShuntCompenstorPoint instances associated with a NonlinearShuntCompensator shall be equal to ShuntCompensator.maximumSections. ShuntCompensator.sections shall only be set to one of the NonlinearShuntCompenstorPoint.sectionNumber. There is no interpolation between NonlinearShuntCompenstorPoints." ;
                                rdfs:label "NonlinearShuntCompensatorPoint"@en ,
                                           "{96F8BB1B-2776-413c-A4AF-63924395C921}"@guid .


