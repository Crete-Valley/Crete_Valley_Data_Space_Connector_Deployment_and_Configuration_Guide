                     rdfs:domain :TimeSchedule ;
                     rdfs:range :Seconds ;
                     rdfs:comment "The offset from midnight i.e. 0 h 0 min 0 s for the periodic time points to begin. For example for an interval meter that is set up for five minute intervals recurrencePeriod3005 min setting offset1202 min would result in scheduled events to read the meter executing at 2 min 7 min 12 min 17 min 22 min 27 min 32 min 37 min 42 min 47 min 52 min and 57 min past each hour." ;
                     rdfs:label "offset"@en ,
                                "{FE7D56EF-99D8-46f2-8229-2D9285D48E61}"@guid .


