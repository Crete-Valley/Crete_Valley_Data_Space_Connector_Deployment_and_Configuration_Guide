:TransformerCoreAdmittance rdf:type owl:Class ;
                           rdfs:subClassOf :IdentifiedObject ;
                           rdfs:comment "The transformer core admittance.  Used to specify the core admittance of a transformer in a manner that can be shared among power transformers." ;
                           rdfs:label "TransformerCoreAdmittance"@en ,
                                      "{25B2D790-161A-45c8-8551-E77A34DE684C}"@guid .


