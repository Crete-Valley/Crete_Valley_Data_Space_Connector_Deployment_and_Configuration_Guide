                                   :MacroPeriodKind ;
                          rdfs:comment "A season of time spanning multiple months. E.g. Summer Spring Fall and Winter based cycle. If within the current season it specifies the period from the start of the current season until now." ;
                          rdfs:label "seasonal"@en ,
