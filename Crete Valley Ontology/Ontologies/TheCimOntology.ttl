                                 rdfs:label "EquipmentUnavailabilitySchedule"@en ,
                                            "{B7828F5D-2ACC-425f-8E67-D4C050E46EEE}"@guid .


###  http://www.iec.ch/TC57/CIM#EquivalentBranch
:EquivalentBranch rdf:type owl:Class ;
                  rdfs:subClassOf :EquivalentEquipment ;
                  rdfs:comment "The class represents equivalent branches. In cases where a transformer phase shift is modelled and the EquivalentBranch is spanning the same nodes the impedance quantities for the EquivalentBranch shall consider the needed phase shift." ;
                  rdfs:label "EquivalentBranch"@en ,
                             "{FC8BE368-2F3E-4ff8-BDC1-4229823DC5AE}"@guid .


###  http://www.iec.ch/TC57/CIM#EquivalentEquipment
:EquivalentEquipment rdf:type owl:Class ;
                     rdfs:subClassOf :ConductingEquipment ;
                     rdfs:comment "The class represents equivalent objects that are the result of a network reduction. The class is the base for equivalent objects of different types." ;
                     rdfs:label "EquivalentEquipment"@en ,
                                "{966D682F-CD37-4038-9739-3EEC0E6CB044}"@guid .


###  http://www.iec.ch/TC57/CIM#EquivalentInjection
:EquivalentInjection rdf:type owl:Class ;
                     rdfs:subClassOf :EquivalentEquipment ;
                     rdfs:comment "This class represents equivalent injections generation or load.  Voltage regulation is allowed only at the point of connection." ;
                     rdfs:label "EquivalentInjection"@en ,
                                "{9749AD93-8F33-48c8-9291-02B9D671C172}"@guid .


###  http://www.iec.ch/TC57/CIM#EquivalentNetwork
:EquivalentNetwork rdf:type owl:Class ;
                   rdfs:subClassOf :ConnectivityNodeContainer ;
                   rdfs:comment "A class that groups electrical equivalents including internal nodes of a network that has been reduced. The ConnectivityNodes contained in the equivalent are intended to reflect internal nodes of the equivalent. The boundary Connectivity nodes where the equivalent connects outside itself are not contained by the equivalent." ;
                   rdfs:label "EquivalentNetwork"@en ,
                              "{1FCEE6DF-2D36-4ee8-8CB9-0EFC3F000799}"@guid .


###  http://www.iec.ch/TC57/CIM#EquivalentShunt
:EquivalentShunt rdf:type owl:Class ;
                 rdfs:subClassOf :EquivalentEquipment ;
                 rdfs:comment "The class represents equivalent shunts." ;
                 rdfs:label "EquivalentShunt"@en ,
                            "{78A11A2E-59D2-4823-9137-ACBA6B6BC4FC}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpAccountKind
:ErpAccountKind rdf:type owl:Class ;
                rdfs:subClassOf :Enumeration ;
                rdfs:comment "Kind of ERP account." ;
                rdfs:label "ErpAccountKind"@en ,
                           "{AE794AC8-10DB-40b8-BDBF-F5B708D9AD33}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpBOM
:ErpBOM rdf:type owl:Class ;
        rdfs:subClassOf :ErpDocument ;
        rdfs:comment "Information that generally describes the Bill of Material Structure and its contents for a utility.This is used by ERP systems to transfer Bill of Material information between two business applications." ;
        rdfs:label "ErpBOM"@en ,
                   "{338BF3FA-0E69-4e0a-9CE2-A99A98ADA226}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpBankAccount
:ErpBankAccount rdf:type owl:Class ;
                rdfs:subClassOf :BankAccount ;
                rdfs:comment "Relationship under a particular name usually evidenced by a deposit against which withdrawals can be made. Types of bank accounts include demand time custodial joint trustee corporate special and regular accounts.A statement of transactions during a fiscal period and the resulting balance is maintained on each account.For Payment metering the account is associated with Bank and Supplier reflecting details of the bank account used for depositing revenue collected by TokenVendor. The name of the account holder should be specified in name attribute." ;
                rdfs:label "ErpBankAccount"@en ,
                           "{EFB4BC24-92B4-4912-B051-F7727578FA81}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpBomItemData
:ErpBomItemData rdf:type owl:Class ;
                rdfs:subClassOf :ErpIdentifiedObject ;
                rdfs:comment "An individual item on a bill of materials." ;
                rdfs:label "ErpBomItemData"@en ,
                           "{198400B5-F041-4acd-B0AB-7C06E1EAE80F}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpChartOfAccounts
:ErpChartOfAccounts rdf:type owl:Class ;
                    rdfs:subClassOf :ErpDocument ;
                    rdfs:comment "Accounting structure of a business. Each account represents a financial aspect of a business such as its Accounts Payable or the value of its inventory or its office supply expenses." ;
                    rdfs:label "ErpChartOfAccounts"@en ,
                               "{0A12D145-2CE5-48dd-A067-F52E6F11113B}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpCompetency
:ErpCompetency rdf:type owl:Class ;
               rdfs:subClassOf :ErpIdentifiedObject ;
               rdfs:comment "Information that describes aptitudes of a utility employee. Unlike Skills that an ErpPerson must be certified to perform before undertaking certain type of assignments to be able to perfrom a Craft ErpCompetency has more to do with typical Human Resource HR matters such as schooling training etc." ;
               rdfs:label "ErpCompetency"@en ,
                          "{EC751E99-286F-44d5-9C43-E7EA516D766C}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpDocument
:ErpDocument rdf:type owl:Class ;
             rdfs:subClassOf :Document ;
             rdfs:comment "Shadow class for Document to isolate subclassing from this package. If any subclass gets normative and needs inheritance it will inherit directly from Document." ;
             rdfs:label "ErpDocument"@en ,
                        "{59753D30-B0C3-4126-9B64-86EE92C42B1A}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpEngChangeOrder
:ErpEngChangeOrder rdf:type owl:Class ;
                   rdfs:subClassOf :ErpDocument ;
                   rdfs:comment "General Utility Engineering Change Order information." ;
                   rdfs:label "ErpEngChangeOrder"@en ,
                              "{07185DA8-4276-4c53-887C-196E31EED445}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpIdentifiedObject
:ErpIdentifiedObject rdf:type owl:Class ;
                     rdfs:subClassOf :IdentifiedObject ;
                     rdfs:comment "Shadow class for IdentifiedObject to isolate subclassing from this package. If any subclass gets normative and needs inheritance it will inherit directly from IdentifiedObject." ;
                     rdfs:label "ErpIdentifiedObject"@en ,
                                "{06062F97-F1AD-48b6-B838-21513A6460B6}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpInventory
:ErpInventory rdf:type owl:Class ;
              rdfs:subClassOf :ErpIdentifiedObject ;
              rdfs:comment "Utility inventoryrelated information about an item or part and not for description of the item and its attributes. It is used by ERP applications to enable the synchronization of Inventory data that exists on separate Item Master databases. This data is not the master data that describes the attributes of the item such as dimensions weight or unit of measure  it describes the item as it exists at a specific location." ;
              rdfs:label "ErpInventory"@en ,
                         "{CAE157A1-AB4E-4403-8A06-5386CA3118F0}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpInventoryCount
:ErpInventoryCount rdf:type owl:Class ;
                   rdfs:subClassOf :ErpIdentifiedObject ;
                   rdfs:comment "This is related to Inventory physical counts organized by AssetModel. Note that a count of a type of asset can be accomplished by the association inherited by AssetModel from Document to Asset.It enables ERP applications to transfer an inventory count between ERP and the actual physical inventory location. This count may be a cycle count or a physical count." ;
                   rdfs:label "ErpInventoryCount"@en ,
                              "{FED13292-1658-4732-82E1-6DD3D974F8EB}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpInvoice
:ErpInvoice rdf:type owl:Class ;
            rdfs:subClassOf :ErpDocument ;
            rdfs:comment "A roll up of invoice line items. The whole invoice has a due date and amount to be paid with information such as customer banks etc. being obtained through associations. The invoice roll up is based on individual line items that each contain amounts and descriptions for specific services or products." ;
            rdfs:label "ErpInvoice"@en ,
                       "{2A25121F-D3C9-413e-9DE0-67BD3846DD54}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpInvoiceKind
:ErpInvoiceKind rdf:type owl:Class ;
                rdfs:subClassOf :Enumeration ;
                rdfs:comment "Kind of ERP invoice." ;
                rdfs:label "ErpInvoiceKind"@en ,
                           "{613C1258-4E8D-4c2c-A23A-AC9C0D812876}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpInvoiceLineItem
:ErpInvoiceLineItem rdf:type owl:Class ;
                    rdfs:subClassOf :ErpDocument ;
                    rdfs:comment "An individual line item on an invoice." ;
                    rdfs:label "ErpInvoiceLineItem"@en ,
                               "{53C3B43C-F9BD-45a5-98A8-C8820D20F3FF}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpInvoiceLineItemKind
:ErpInvoiceLineItemKind rdf:type owl:Class ;
                        rdfs:subClassOf :Enumeration ;
                        rdfs:comment "Kind of invoice line item." ;
                        rdfs:label "ErpInvoiceLineItemKind"@en ,
                                   "{F22B0623-851B-43f7-A35C-F4771F4813F9}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpIssueInventory
:ErpIssueInventory rdf:type owl:Class ;
                   rdfs:subClassOf :ErpIdentifiedObject ;
                   rdfs:comment "Can be used to request an application to process an issue or request information about an issue." ;
                   rdfs:label "ErpIssueInventory"@en ,
                              "{D127CF41-0C3B-439f-A453-5071ED143BD2}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpItemMaster
:ErpItemMaster rdf:type owl:Class ;
               rdfs:subClassOf :ErpIdentifiedObject ;
               rdfs:comment "Any unique purchased part for manufactured product tracked by ERP systems for a utility.Item as used by the OAG refers to the basic information about an item including its attributes cost and locations. It does not include item quantities. Compare to the Inventory which includes all quantities and other locationspecific information." ;
               rdfs:label "ErpItemMaster"@en ,
                          "{26D010CF-1FA8-43da-9EC5-A05965183BD0}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpJournal
:ErpJournal rdf:type owl:Class ;
            rdfs:subClassOf :ErpDocument ;
            rdfs:comment "Book for recording accounting transactions as they occur. Transactions and adjustments are first recorded in a journal which is like a diary of instructions advising which account to be charged and by how much.A journal represents a change in the balances of a businesss financial accounts. Many tasks or transactions throughout an enterprise will result in the creation of a journal. Some examples are creating a customer invoice paying a vendor transferring inventory or paying employees." ;
            rdfs:label "ErpJournal"@en ,
                       "{89974BFB-E268-45d8-A05F-020CAA9C3781}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpJournalEntry
:ErpJournalEntry rdf:type owl:Class ;
                 rdfs:subClassOf :ErpIdentifiedObject ;
                 rdfs:comment "Details of an individual entry in a journal which is to be posted to a ledger on the posting date." ;
                 rdfs:label "ErpJournalEntry"@en ,
                            "{92318DC0-968A-40de-B828-7C3C5B67BCEC}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpLedBudLineItem
:ErpLedBudLineItem rdf:type owl:Class ;
                   rdfs:subClassOf :ErpIdentifiedObject ;
                   rdfs:comment "Individual entry of a given Ledger Budget typically containing information such as amount accounting date accounting period and is associated with the applicable general ledger account." ;
                   rdfs:label "ErpLedBudLineItem"@en ,
                              "{497D8708-FB86-4141-8C80-548011F5C0C3}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpLedger
:ErpLedger rdf:type owl:Class ;
           rdfs:subClassOf :ErpDocument ;
           rdfs:comment "In accounting transactions a ledger is a book containing accounts to which debits and credits are posted from journals where transactions are initially recorded. Journal entries are periodically posted to the ledger. Ledger Actual represents actual amounts by account within ledger within company or business area. Actual amounts may be generated in a source application and then loaded to a specific ledger within the enterprise general ledger or budget application." ;
           rdfs:label "ErpLedger"@en ,
                      "{E9DF60B7-4E1B-4d37-A980-EFBB2FBEFDA8}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpLedgerBudget
:ErpLedgerBudget rdf:type owl:Class ;
                 rdfs:subClassOf :ErpDocument ;
                 rdfs:comment "Information for utility Ledger Budgets. They support the transfer budget amounts between all possible source applications throughout an enterprise and a general ledger or budget application." ;
                 rdfs:label "ErpLedgerBudget"@en ,
                            "{648B9268-D9CD-468c-9BFE-B2329ED60032}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpLedgerEntry
:ErpLedgerEntry rdf:type owl:Class ;
                rdfs:subClassOf :ErpIdentifiedObject ;
                rdfs:comment "Details of an individual entry in a ledger which was posted from a journal on the posted date." ;
                rdfs:label "ErpLedgerEntry"@en ,
                           "{8CFB51A0-6C9E-48a0-A8CC-AA2E97B62DAE}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpPOLineItem
:ErpPOLineItem rdf:type owl:Class ;
               rdfs:subClassOf :ErpDocument ;
               rdfs:comment "Of an ErpPurchaseOrder this is an individually ordered item or product along with the quantity price and other descriptive information." ;
               rdfs:label "ErpPOLineItem"@en ,
                          "{5F91E07F-F701-4b38-8CB8-1CA87251C0D5}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpPayable
:ErpPayable rdf:type owl:Class ;
            rdfs:subClassOf :ErpDocument ;
            rdfs:comment "A transaction that represents an invoice from a supplier. A payable or voucher is an open item approved and ready for payment in the Accounts Payable ledger." ;
            rdfs:label "ErpPayable"@en ,
                       "{7E9CB1F8-B68D-4dec-B5AA-50E8C891FA04}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpPayableLineItem
:ErpPayableLineItem rdf:type owl:Class ;
                    rdfs:subClassOf :ErpIdentifiedObject ;
                    rdfs:comment "Of an ErpPayable a line item references an ErpInvoiceLineitem or other source such as credit memos." ;
                    rdfs:label "ErpPayableLineItem"@en ,
                               "{0BCC0D0E-6785-4bcc-A35C-D4820897FF73}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpPayment
:ErpPayment rdf:type owl:Class ;
            rdfs:subClassOf :ErpDocument ;
            rdfs:comment "Payment infromation and status for any individual line item of an ErpInvoice e.g. when payment is from a customer. ErpPayable is also updated when payment is to a supplier and ErpReceivable is updated when payment is from a customer. Multiple payments can be made against a single line item and an individual payment can apply to more that one line item." ;
            rdfs:label "ErpPayment"@en ,
                       "{2A7E7F00-35B2-44ba-ABFA-659EF1E521DE}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpPersonnel
:ErpPersonnel rdf:type owl:Class ;
              rdfs:subClassOf :ErpIdentifiedObject ;
              rdfs:comment "Information that applies to the basic data about a utility person used by ERP applications to transfer Personnel data for a worker." ;
              rdfs:label "ErpPersonnel"@en ,
                         "{40C9A7CC-0257-4961-8051-2EF29DABECD9}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpProjectAccounting
:ErpProjectAccounting rdf:type owl:Class ;
                      rdfs:subClassOf :ErpDocument ;
                      rdfs:comment "Utility Project Accounting information used by ERP applications to enable all relevant subsystems that submit single sided transactions to transfer information with a Project Accounting Application. This would include but not necessarily be limited to Accounts Payable Accounts Receivable Budget Order Management Purchasing Time and Labor Travel and Expense." ;
                      rdfs:label "ErpProjectAccounting"@en ,
                                 "{93D527C0-CE28-4069-A6FB-D862754B4420}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpPurchaseOrder
:ErpPurchaseOrder rdf:type owl:Class ;
                  rdfs:subClassOf :ErpDocument ;
                  rdfs:comment "A document that communicates an order to purchase goods from a buyer to a supplier. The PurchaseOrder carries information to and from the buyer and supplier. It is a legally binding document once both Parties agree to the contents and the specified terms and conditions of the order." ;
                  rdfs:label "ErpPurchaseOrder"@en ,
                             "{B59BE666-E41E-4f68-A564-2A6E32C8DA78}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpQuote
:ErpQuote rdf:type owl:Class ;
          rdfs:subClassOf :ErpDocument ;
          rdfs:comment "Document describing the prices of goods or services provided by a supplier. It includes the terms of the purchase delivery proposals identification of goods or services ordered as well as their quantities." ;
          rdfs:label "ErpQuote"@en ,
                     "{0908A794-42AB-4d96-915B-CD52EA913AFD}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpQuoteLineItem
:ErpQuoteLineItem rdf:type owl:Class ;
                  rdfs:subClassOf :ErpIdentifiedObject ;
                  rdfs:comment "Of an ErpQuote the item or product quoted along with quantity price and other descriptive information." ;
                  rdfs:label "ErpQuoteLineItem"@en ,
                             "{41C0DEAC-191E-4b9c-85DA-917554C0FDF7}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpRecDelvLineItem
:ErpRecDelvLineItem rdf:type owl:Class ;
                    rdfs:subClassOf :ErpIdentifiedObject ;
                    rdfs:comment "Of an ErpReceiveDelivery this is an individually received good or service by the Organisation receiving goods or services. It may be used to indicate receipt of goods in conjunction with a purchase order line item." ;
                    rdfs:label "ErpRecDelvLineItem"@en ,
                               "{B4E2F4F0-78A8-4dd7-BC64-7A5E37411161}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpRecLineItem
