:TransformerTest rdf:type owl:Class ;
                 rdfs:subClassOf :IdentifiedObject ;
                 rdfs:comment "Test result for transformer ends such as shortcircuit opencircuit excitation or noload test." ;
                 rdfs:label "TransformerTest"@en ,
                            "{6882227B-F7AD-48fd-A7C6-9C6A08A41979}"@guid .


###  http://www.iec.ch/TC57/CIM#TransmissionCapacity
:TransmissionCapacity rdf:type owl:Class ;
                      rdfs:subClassOf :Toplevel ;
                      rdfs:comment "This class models the transmission either a transmission interface or a PORPOD pair capacity including Total Transfer Capacity TTC Operating Transfer Capacity OTC and Capacity Benefit Margin CBM." ;
                      rdfs:label "TransmissionCapacity"@en ,
                                 "{2F86A45A-5879-4e81-A18E-AC2BE1406190}"@guid .


###  http://www.iec.ch/TC57/CIM#TransmissionCorridor
:TransmissionCorridor rdf:type owl:Class ;
                      rdfs:subClassOf :PowerSystemResource ;
                      rdfs:comment "A corridor containing one or more rights of way" ;
                      rdfs:label "TransmissionCorridor"@en ,
                                 "{E5523AA5-47CB-4537-ACC5-E09A4AA0B9D9}"@guid .


###  http://www.iec.ch/TC57/CIM#TransmissionInterfaceRightEntitlement
:TransmissionInterfaceRightEntitlement rdf:type owl:Class ;
                                       rdfs:subClassOf :Toplevel ;
