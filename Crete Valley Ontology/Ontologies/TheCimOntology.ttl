:NameTypeAuthority rdf:type owl:Class ;
                   rdfs:subClassOf :Toplevel ;
                   rdfs:comment "Authority responsible for creation and management of names of a given type typically an organization or an enterprise system." ;
                   rdfs:label "NameTypeAuthority"@en ,
                              "{F4E2C3FE-B480-46c9-8840-DF8D3F3BD6CC}"@guid .


