                              "{ECCF586E-4F69-4f21-B234-DDE8C6974F0F}"@guid .


###  http://www.iec.ch/TC57/CIM#ThermalGeneratingUnit
:ThermalGeneratingUnit rdf:type owl:Class ;
                       rdfs:subClassOf :GeneratingUnit ;
                       rdfs:comment "A generating unit whose prime mover could be a steam turbine combustion turbine or diesel engine." ;
                       rdfs:label "ThermalGeneratingUnit"@en ,
                                  "{74F16962-C880-450f-8B4F-0CFBD6BEF79A}"@guid .


###  http://www.iec.ch/TC57/CIM#TieFlow
:TieFlow rdf:type owl:Class ;
         rdfs:subClassOf :IdentifiedObject ;
         rdfs:comment "Defines the structure in terms of location and direction of the net interchange constraint for a control area. This constraint may be used by either AGC or power flow." ;
         rdfs:label "TieFlow"@en ,
                    "{AA47BC16-A18A-4beb-9CB3-5F942819B925}"@guid .


###  http://www.iec.ch/TC57/CIM#TieLine
:TieLine rdf:type owl:Class ;
         rdfs:subClassOf :IdentifiedObject ;
         rdfs:label "TieLine"@en ,
                    "{5E38218F-5C3C-4eea-B97B-CA3E8932B344}"@guid .


###  http://www.iec.ch/TC57/CIM#TiePoint
:TiePoint rdf:type owl:Class ;
          rdfs:subClassOf :IdentifiedObject ;
          rdfs:comment "Site of an interface between interchange areas. The tie point can be a network branch e.g. transmission line or transformer or a switching device. For transmission lines the interchange area boundary is usually at a designated point such as the middle of the line. Line end metering is then corrected for line losses." ;
          rdfs:label "TiePoint"@en ,
                     "{5646690B-90BB-4493-B579-67E48CDF0860}"@guid .


###  http://www.iec.ch/TC57/CIM#Time
:Time rdf:type owl:Class ;
      rdfs:subClassOf :Primitive ;
      rdfs:comment "Time as hhmmss.sss which conforms with ISO 8601. UTC time zone is specified as hhmmss.sssZ. A local timezone relative UTC is specified as hhmmss.ssshhmm. The second component shown here as ss.sss could have any number of digits in its fractional part to allow any kind of precision beyond seconds." ;
      rdfs:label "Time"@en ,
                 "{09171B95-287D-44b3-8E93-1376FDF0E55A}"@guid .


###  http://www.iec.ch/TC57/CIM#TimeInterval
:TimeInterval rdf:type owl:Class ;
              rdfs:subClassOf :Compound ;
              rdfs:comment "Interval between two times." ;
              rdfs:label "TimeInterval"@en ,
                         "{1A62B1E2-8C2D-4459-A10B-118C16A22A03}"@guid .


###  http://www.iec.ch/TC57/CIM#TimeIntervalKind
:TimeIntervalKind rdf:type owl:Class ;
                  rdfs:subClassOf :Enumeration ;
                  rdfs:label "TimeIntervalKind"@en ,
                             "{BAD15303-A2BD-4e5f-86B7-30D9CD344146}"@guid .


###  http://www.iec.ch/TC57/CIM#TimeOfUse
:TimeOfUse rdf:type owl:Class ;
           rdfs:subClassOf :Enumeration ;
           rdfs:comment "Time of Use used by a CRR definition for specifying the time the CRR spans. ON  CRR spans the on peak hours of the day OFF  CRR spans the off peak hours of the day 24HR  CRR spans the entire day." ;
           rdfs:label "TimeOfUse"@en ,
                      "{95168B2D-6BDF-4442-99C0-C7C729EA8BC0}"@guid .


###  http://www.iec.ch/TC57/CIM#TimePeriodUnit
:TimePeriodUnit rdf:type owl:Class ;
                rdfs:subClassOf :Enumeration ;
                rdfs:comment "Units in which reporting frequency is specified." ;
                rdfs:label "TimePeriodUnit"@en ,
                           "{9768A0B6-3320-438b-902F-2ADAB9B19356}"@guid .


###  http://www.iec.ch/TC57/CIM#TimePoint
:TimePoint rdf:type owl:Class ;
           rdfs:subClassOf :IdentifiedObject ;
           rdfs:comment "A point in time within a sequence of points in time relative to a time schedule." ;
           rdfs:label "TimePoint"@en ,
                      "{336EA49A-BDDF-47d3-A9BC-B1B5BD070ED4}"@guid .


###  http://www.iec.ch/TC57/CIM#TimeSchedule
:TimeSchedule rdf:type owl:Class ;
              rdfs:subClassOf :Document ;
              rdfs:comment "Description of anything that changes through time. Time schedule is used to perform a singlevalued function of time. Use inherited type attribute to give additional information on this schedule such as periodic hourly daily weekly monthly etc. day of the month by date calendar specific times and dates." ;
              rdfs:label "TimeSchedule"@en ,
                         "{49D4B4E2-FF11-4a48-8418-7E660E6B34C8}"@guid .


###  http://www.iec.ch/TC57/CIM#TimeSeries
:TimeSeries rdf:type owl:Class ;
            rdfs:subClassOf :IdentifiedObject ;
            rdfs:comment "A set of regular timeordered measurements or values of quantitative nature of an individual or collective phenomenon taken at successive in most cases equidistant periods  points of time." ;
            rdfs:label "TimeSeries"@en ,
                       "{4E4FCB53-20DF-4ce4-947E-E3D41406911E}"@guid .


###  http://www.iec.ch/TC57/CIM#TimeTariffInterval
:TimeTariffInterval rdf:type owl:Class ;
                    rdfs:subClassOf :Toplevel ;
                    rdfs:comment "One of a sequence of time intervals defined in terms of real time. It is typically used in association with TariffProfile to define the intervals in a time of use tariff structure where startDateTime simultaneously determines the starting point of this interval and the ending point of the previous interval." ;
                    rdfs:label "TimeTariffInterval"@en ,
                               "{A61EEF7B-B1DE-4db9-9825-F1BA4F9C0478}"@guid .


