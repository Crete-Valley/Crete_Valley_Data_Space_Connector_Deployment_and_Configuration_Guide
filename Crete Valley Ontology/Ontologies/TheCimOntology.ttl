                                            rdfs:domain :PowerTransformer ;
                                            rdfs:range :AngleDegrees ;
                                            rdfs:comment "The angle of power factor before short circuit phib in IEC 609090. It is used for calculation of the impedance correction factor KT defined in IEC 609090. This is the worst case power factor. Used to define operating conditions." ;
                                            rdfs:label "beforeShortCircuitAnglePf"@en ,
                                                       "{041C6D4A-4D33-416b-869F-3546D7B28527}"@guid .


###  http://www.iec.ch/TC57/CIM#PowerTransformer.highSideMinOperatingU
