@prefix : <http://www.iec.ch/TC57/CIM#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.iec.ch/TC57/CIM#> .

<http://www.iec.ch/TC57/CIM#> rdf:type owl:Ontology .

#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#duration
xsd:duration rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gMonthDay
xsd:gMonthDay rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#time
xsd:time rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.iec.ch/TC57/CIM#ACDCConverter.DCTerminals
:ACDCConverter.DCTerminals rdf:type owl:ObjectProperty ;
                           owl:inverseOf :ACDCConverterDCTerminal.DCConductingEquipment ;
                           rdfs:domain :ACDCConverter ;
                           rdfs:range :ACDCConverterDCTerminal ;
                           rdfs:comment "A DC converter have DC converter terminals. A converter has two DC converter terminals." ;
                           rdfs:label "DCTerminals"@en ,
                                      "{419FDA84-5AD0-409d-BAAA-27B90163DA73}.ClientEnd"@guid .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.PccTerminal
:ACDCConverter.PccTerminal rdf:type owl:ObjectProperty ;
                           owl:inverseOf :Terminal.ConverterDCSides ;
                           rdfs:domain :ACDCConverter ;
                           rdfs:range :Terminal ;
                           rdfs:comment "Point of common coupling terminal for this converter DC side. It is typically the terminal on the power transformer or switch closest to the AC network." ;
                           rdfs:label "PccTerminal"@en ,
                                      "{6880D3F9-475B-4887-8B4A-332FABFC8F47}.SupplierEnd"@guid .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.baseS
:ACDCConverter.baseS rdf:type owl:ObjectProperty ;
                     rdfs:domain :ACDCConverter ;
                     rdfs:range :ApparentPower ;
                     rdfs:comment "Base apparent power of the converter pole. The attribute shall be a positive value." ;
                     rdfs:label "baseS"@en ,
                                "{20F0D1ED-6CE8-471e-8E4B-DCC6C4B46AA5}"@guid .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.idc
:ACDCConverter.idc rdf:type owl:ObjectProperty ;
                   rdfs:domain :ACDCConverter ;
                   rdfs:range :CurrentFlow ;
                   rdfs:comment "Converter DC current also called Id. It is converters state variable result from power flow." ;
                   rdfs:label "idc"@en ,
                              "{180F58C1-0E50-4bb2-B496-E88864AF033A}"@guid .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.idleLoss
:ACDCConverter.idleLoss rdf:type owl:ObjectProperty ;
                        rdfs:domain :ACDCConverter ;
                        rdfs:range :ActivePower ;
                        rdfs:comment "Active power loss in pole at no power transfer. It is converters configuration data used in power flow. The attribute shall be a positive value." ;
                        rdfs:label "idleLoss"@en ,
                                   "{E9ED1BC9-CA40-4d1f-91E4-5425A18765DD}"@guid .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.maxP
:ACDCConverter.maxP rdf:type owl:ObjectProperty ;
                    rdfs:domain :ACDCConverter ;
                    rdfs:range :ActivePower ;
                    rdfs:comment "Maximum active power limit. The value is overwritten by values of VsCapabilityCurve if present." ;
                    rdfs:label "maxP"@en ,
                               "{082E98FF-DDF7-4a42-A993-2A10F8464960}"@guid .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.maxUdc
:ACDCConverter.maxUdc rdf:type owl:ObjectProperty ;
                      rdfs:domain :ACDCConverter ;
                      rdfs:range :Voltage ;
                      rdfs:comment "The maximum voltage on the DC side at which the converter should operate. It is converters configuration data used in power flow. The attribute shall be a positive value." ;
                      rdfs:label "maxUdc"@en ,
                                 "{75897B30-EAA3-486e-AA11-DA02461454EE}"@guid .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.minP
:ACDCConverter.minP rdf:type owl:ObjectProperty ;
                    rdfs:domain :ACDCConverter ;
                    rdfs:range :ActivePower ;
                    rdfs:comment "Minimum active power limit. The value is overwritten by values of VsCapabilityCurve if present." ;
                    rdfs:label "minP"@en ,
                               "{8019FADD-6C6B-4979-A784-0513A1C08CB9}"@guid .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.minUdc
:ACDCConverter.minUdc rdf:type owl:ObjectProperty ;
                      rdfs:domain :ACDCConverter ;
                      rdfs:range :Voltage ;
                      rdfs:comment "The minimum voltage on the DC side at which the converter should operate. It is converters configuration data used in power flow. The attribute shall be a positive value." ;
                      rdfs:label "minUdc"@en ,
                                 "{C442EC69-4FD8-4b00-A7A5-9356A9E1C4BF}"@guid .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.p
:ACDCConverter.p rdf:type owl:ObjectProperty ;
                 rdfs:domain :ACDCConverter ;
                 rdfs:range :ActivePower ;
                 rdfs:comment "Active power at the point of common coupling. Load sign convention is used i.e. positive sign means flow out from a node.Starting value for a steady state solution in the case a simplified power flow model is used." ;
                 rdfs:label "p"@en ,
                            "{A2886699-3439-4510-98E7-990FB4691BF3}"@guid .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.poleLossP
:ACDCConverter.poleLossP rdf:type owl:ObjectProperty ;
                         rdfs:domain :ACDCConverter ;
                         rdfs:range :ActivePower ;
                         rdfs:comment "The active power loss at a DC Pole  idleLoss  switchingLossIdc  resitiveLossIdc2.For lossless operation PdcPac.For rectifier operation with losses PdcPaclossP.For inverter operation with losses PdcPaclossP.It is converters state variable used in power flow. The attribute shall be a positive value." ;
                         rdfs:label "poleLossP"@en ,
                                    "{AD13092B-56F5-4cc6-8225-93F6DFD49D2E}"@guid .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.q
:ACDCConverter.q rdf:type owl:ObjectProperty ;
                 rdfs:domain :ACDCConverter ;
                 rdfs:range :ReactivePower ;
                 rdfs:comment "Reactive power at the point of common coupling. Load sign convention is used i.e. positive sign means flow out from a node.Starting value for a steady state solution in the case a simplified power flow model is used." ;
                 rdfs:label "q"@en ,
                            "{3BADAA72-01DD-4d34-99E4-FF5E7E2DD77C}"@guid .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.ratedUdc
:ACDCConverter.ratedUdc rdf:type owl:ObjectProperty ;
                        rdfs:domain :ACDCConverter ;
                        rdfs:range :Voltage ;
                        rdfs:comment "Rated converter DC voltage also called UdN. The attribute shall be a positive value. It is converters configuration data used in power flow. For instance a bipolar HVDC link with value  200 kV has a 400kV difference between the dc lines." ;
                        rdfs:label "ratedUdc"@en ,
                                   "{85D36F1D-363A-42a6-ACDB-87AE5511D72F}"@guid .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.resistiveLoss
:ACDCConverter.resistiveLoss rdf:type owl:ObjectProperty ;
                             rdfs:domain :ACDCConverter ;
                             rdfs:range :Resistance ;
                             rdfs:comment "It is converters configuration data used in power flow. Refer to poleLossP. The attribute shall be a positive value." ;
                             rdfs:label "resistiveLoss"@en ,
                                        "{170A8A5E-A487-4e0a-A458-C5CEA87D3624}"@guid .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.switchingLoss
:ACDCConverter.switchingLoss rdf:type owl:ObjectProperty ;
                             rdfs:domain :ACDCConverter ;
                             rdfs:range :ActivePowerPerCurrentFlow ;
                             rdfs:comment "Switching losses relative to the base apparent power baseS. Refer to poleLossP. The attribute shall be a positive value." ;
                             rdfs:label "switchingLoss"@en ,
                                        "{09B85C15-1584-4b82-AC15-9A4C7BAD2F8C}"@guid .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.targetPpcc
:ACDCConverter.targetPpcc rdf:type owl:ObjectProperty ;
                          rdfs:domain :ACDCConverter ;
                          rdfs:range :ActivePower ;
                          rdfs:comment "Real power injection target in AC grid at point of common coupling.  Load sign convention is used i.e. positive sign means flow out from a node." ;
                          rdfs:label "targetPpcc"@en ,
                                     "{517A2014-C002-4bcc-A490-1878A4D3DC40}"@guid .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.targetUdc
:ACDCConverter.targetUdc rdf:type owl:ObjectProperty ;
                         rdfs:domain :ACDCConverter ;
                         rdfs:range :Voltage ;
                         rdfs:comment "Target value for DC voltage magnitude. The attribute shall be a positive value." ;
                         rdfs:label "targetUdc"@en ,
                                    "{393D548F-14FB-4ae1-9269-0B18F64E442D}"@guid .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.uc
:ACDCConverter.uc rdf:type owl:ObjectProperty ;
                  rdfs:domain :ACDCConverter ;
                  rdfs:range :Voltage ;
                  rdfs:comment "Linetoline converter voltage the voltage at the AC side of the valve. It is converters state variable result from power flow. The attribute shall be a positive value." ;
                  rdfs:label "uc"@en ,
                             "{BDE610FA-7E72-4605-9A95-67DED66E25C1}"@guid .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.udc
:ACDCConverter.udc rdf:type owl:ObjectProperty ;
                   rdfs:domain :ACDCConverter ;
                   rdfs:range :Voltage ;
                   rdfs:comment "Converter voltage at the DC side also called Ud. It is converters state variable result from power flow. The attribute shall be a positive value." ;
                   rdfs:label "udc"@en ,
                              "{2546662D-C210-4dd7-9137-FF80B3B9D15C}"@guid .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.valveU0
:ACDCConverter.valveU0 rdf:type owl:ObjectProperty ;
                       rdfs:domain :ACDCConverter ;
                       rdfs:range :Voltage ;
                       rdfs:comment "Valve threshold voltage also called Uvalve. Forward voltage drop when the valve is conducting. Used in loss calculations i.e. the switchLoss depend on numberOfValves  valveU0." ;
                       rdfs:label "valveU0"@en ,
                                  "{BCE61CD4-9E6A-4c28-892B-64EADC865EFF}"@guid .


