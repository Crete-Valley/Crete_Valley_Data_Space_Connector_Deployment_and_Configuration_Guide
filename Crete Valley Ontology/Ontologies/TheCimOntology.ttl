                                        :MacroPeriodKind ;
                               rdfs:comment "Captured during the billing period starting at midnight of the first day of the billing period as defined by the billing cycle day. If during the current billing period it specifies a period from the start of the current billing period until now." ;
                               rdfs:label "billingPeriod"@en ,
                                          "{28162C5F-9EFB-409b-8225-74B78FCF5FD8}"@guid .


