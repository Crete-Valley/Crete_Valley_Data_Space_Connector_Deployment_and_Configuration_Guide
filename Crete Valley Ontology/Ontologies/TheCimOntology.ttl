:TransformerControlMode rdf:type owl:Class ;
                        rdfs:subClassOf :Enumeration ;
                        rdfs:comment "Control modes for a transformer." ;
                        rdfs:label "TransformerControlMode"@en ,
                                   "{601E1E7A-46DB-4d07-95C8-4B61EBFC65C0}"@guid .


