                rdfs:label "ErpReqLineItem"@en ,
                           "{704B113A-CD61-4877-97DA-A23E4F7F77C8}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpRequisition
:ErpRequisition rdf:type owl:Class ;
                rdfs:subClassOf :ErpDocument ;
                rdfs:comment "General information that applies to a utility requisition that is a request for the purchase of goods or services. Typically a requisition leads to the creation of a purchase order to a specific supplier." ;
                rdfs:label "ErpRequisition"@en ,
                           "{1D8F6379-AE58-4c91-B287-CA3BEF7851BD}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpSalesOrder
:ErpSalesOrder rdf:type owl:Class ;
               rdfs:subClassOf :ErpDocument ;
               rdfs:comment "General purpose Sales Order is used for utility service orders etc.As used by the OAG the SalesOrder is a step beyond a PurchaseOrder in that the receiving entity of the order also communicates SalesInformoration about the Order along with the Order itself." ;
               rdfs:label "ErpSalesOrder"@en ,
                          "{B4F609BD-F167-4d16-A382-99CEB1054332}"@guid .


###  http://www.iec.ch/TC57/CIM#ErpSiteLevelData
