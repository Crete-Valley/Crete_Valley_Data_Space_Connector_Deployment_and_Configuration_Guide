:EnvironmentalDataAuthority rdf:type owl:Class ;
                            rdfs:subClassOf :OrganisationRole ;
                            rdfs:comment "An entity defining classifications or categories of environmental information like phenomena or alerts." ;
                            rdfs:label "EnvironmentalDataAuthority"@en ,
                                       "{4CAE75CE-D7C1-4346-9DC7-DBDCE2A5B59F}"@guid .


###  http://www.iec.ch/TC57/CIM#EnvironmentalDataProvider
:EnvironmentalDataProvider rdf:type owl:Class ;
                           rdfs:subClassOf :OrganisationRole ;
                           rdfs:comment "Entity providing environmental data.  Could be an observed weather data provider an entity providing forecasts an authority providing alerts etc." ;
                           rdfs:label "EnvironmentalDataProvider"@en ,
                                      "{5C4D4CE8-7157-4493-91A6-EB085F29B2A9}"@guid .


###  http://www.iec.ch/TC57/CIM#EnvironmentalDependentLimit
:EnvironmentalDependentLimit rdf:type owl:Class ;
                             rdfs:subClassOf :LimitDependency ;
                             rdfs:comment "This is a environmental based limit dependency model for calculating operational limits." ;
                             rdfs:label "EnvironmentalDependentLimit"@en ,
                                        "{E2741DD1-E9F5-4abd-B45E-8EA808647E09}"@guid .


###  http://www.iec.ch/TC57/CIM#EnvironmentalDiscrete
:EnvironmentalDiscrete rdf:type owl:Class ;
                       rdfs:subClassOf :Discrete ;
                       rdfs:comment "Discrete integer measurement of relevance in the environmental domain." ;
                       rdfs:label "EnvironmentalDiscrete"@en ,
                                  "{B5D41EB6-5CB8-4f32-81DE-854FC340F244}"@guid .


###  http://www.iec.ch/TC57/CIM#EnvironmentalDiscreteKind
:EnvironmentalDiscreteKind rdf:type owl:Class ;
                           rdfs:subClassOf :Enumeration ;
                           rdfs:comment "Discrete integer measuring an environmental condition." ;
                           rdfs:label "EnvironmentalDiscreteKind"@en ,
                                      "{6C16F9CE-689B-420d-91CE-DB256FBACF80}"@guid .


###  http://www.iec.ch/TC57/CIM#EnvironmentalEvent
:EnvironmentalEvent rdf:type owl:Class ;
                    rdfs:subClassOf :ActivityRecord ;
                    rdfs:comment "An environmental event to which one or more forecasts or observations may be tied and which may relate to or affect one or more assets.This class is intended to be used as a means of grouping forecasts andor observations and could be used for a variety of purposes includingullito define a named event like Hurricane Katrina and allow the historic or forecast values for phenomena and measurements precipitation temperature across time to be  associated with itlilito identify assets that were or are forecast to be affected by a phenomenon or set of measurementsliul" ;
                    rdfs:label "EnvironmentalEvent"@en ,
                               "{FFCF28A6-7F47-4970-A6D0-E39F622CC21A}"@guid .


###  http://www.iec.ch/TC57/CIM#EnvironmentalInformation
:EnvironmentalInformation rdf:type owl:Class ;
                          rdfs:subClassOf :IdentifiedObject ;
                          rdfs:comment "Abstract class with concrete child classes of Observation and Forecast that groups phenomenon andor environmental value sets. " ;
                          rdfs:label "EnvironmentalInformation"@en ,
                                     "{E0E65339-6D6D-49ff-846C-6A2A175C0504}"@guid .


###  http://www.iec.ch/TC57/CIM#EnvironmentalLocationType
:EnvironmentalLocationType rdf:type owl:Class ;
                           rdfs:subClassOf :Toplevel ;
                           rdfs:comment "Type of environmental location. Used when an environmental alert or phenomenon has multiple locations associated with it." ;
                           rdfs:label "EnvironmentalLocationType"@en ,
                                      "{4F05C799-C6C3-46da-8408-7B9C074FC888}"@guid .


###  http://www.iec.ch/TC57/CIM#EnvironmentalMonitoringStation
:EnvironmentalMonitoringStation rdf:type owl:Class ;
                                rdfs:subClassOf :IdentifiedObject ;
                                rdfs:comment "An environmental monitoring station examples of which could be a weather station or a seismic monitoring station.  " ;
                                rdfs:label "EnvironmentalMonitoringStation"@en ,
                                           "{C0EF36F4-1BF0-4f20-A428-819900BFFACA}"@guid .


###  http://www.iec.ch/TC57/CIM#EnvironmentalPhenomenon
:EnvironmentalPhenomenon rdf:type owl:Class ;
                         rdfs:subClassOf :Toplevel ;
                         rdfs:comment "The actual or forecast characteristics of an environmental phenomenon at a specific point in time or during a specific time interval that may have both a center and arealine location. " ;
                         rdfs:label "EnvironmentalPhenomenon"@en ,
                                    "{E5CAB7F1-22D3-4dd1-AAE4-FD2DA5C91BF2}"@guid .


###  http://www.iec.ch/TC57/CIM#EnvironmentalStringMeasurement
:EnvironmentalStringMeasurement rdf:type owl:Class ;
                                rdfs:subClassOf :StringMeasurement ;
                                rdfs:comment "String measurement of relevance in the environmental domain." ;
                                rdfs:label "EnvironmentalStringMeasurement"@en ,
                                           "{45D363CC-9B36-4fc4-9E55-C5550D9BAF23}"@guid .


###  http://www.iec.ch/TC57/CIM#Equipment
:Equipment rdf:type owl:Class ;
           rdfs:subClassOf :PowerSystemResource ;
           rdfs:comment "The parts of a power system that are physical devices electronic or mechanical." ;
           rdfs:label "Equipment"@en ,
                      "{F8DD8DAC-3545-4660-9CA5-794881CC6591}"@guid .


###  http://www.iec.ch/TC57/CIM#EquipmentContainer
:EquipmentContainer rdf:type owl:Class ;
                    rdfs:subClassOf :ConnectivityNodeContainer ;
                    rdfs:comment "A modelling construct to provide a root class for containing equipment. " ;
                    rdfs:label "EquipmentContainer"@en ,
                               "{F465B7B4-B488-46c5-8D05-8036F09A03A0}"@guid .


###  http://www.iec.ch/TC57/CIM#EquipmentFault
:EquipmentFault rdf:type owl:Class ;
                rdfs:subClassOf :Fault ;
                rdfs:comment "A fault applied at the terminal external to the equipment. This class is not used to specify faults internal to the equipment." ;
                rdfs:label "EquipmentFault"@en ,
                           "{565ED47F-1E02-464b-8D9C-517ED5726DF3}"@guid .


###  http://www.iec.ch/TC57/CIM#EquipmentLimitSeriesComponent
:EquipmentLimitSeriesComponent rdf:type owl:Class ;
                               rdfs:subClassOf :IdentifiedObject ;
                               rdfs:comment "This represents one instance of an equipment that contributes to the calculation of an operational limit." ;
                               rdfs:label "EquipmentLimitSeriesComponent"@en ,
                                          "{56EBD7E2-15BD-4733-8247-B0D65C6C7F9C}"@guid .


###  http://www.iec.ch/TC57/CIM#EquipmentStatusType
:EquipmentStatusType rdf:type owl:Class ;
                     rdfs:subClassOf :Enumeration ;
                     rdfs:comment "Status of equipment." ;
                     rdfs:label "EquipmentStatusType"@en ,
                                "{B731F8DA-5DDA-4018-9BA8-7DA634AB5125}"@guid .


###  http://www.iec.ch/TC57/CIM#EquipmentUnavailabilitySchedule
:EquipmentUnavailabilitySchedule rdf:type owl:Class ;
