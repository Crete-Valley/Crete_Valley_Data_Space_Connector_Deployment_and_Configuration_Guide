:TownDetail rdf:type owl:Class ;
            rdfs:subClassOf :Compound ;
            rdfs:comment "Town details in the context of address." ;
            rdfs:label "TownDetail"@en ,
                       "{26275F22-BDC6-4a76-ABE7-AC797CFE35D9}"@guid .


